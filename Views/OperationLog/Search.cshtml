@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "操作紀錄";
}

<div>
    <p class="text-secondary mb-4">查詢系統內各帳號的操作歷程紀錄</p>

    <!-- 查詢條件區塊 (Card) -->
    <div class="card mb-4 shadow-sm" id="searchCard">
        <div class="card-body">
            <form id="searchForm" onsubmit="return false;">
                <!-- 第一排：日期區間、分館、操作類型 -->
                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-4">
                        <label class="form-label">
                            日期區間 <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <input type="date" class="form-control" id="dateStart">
                            <span class="input-group-text bg-light text-secondary">至</span>
                            <input type="date" class="form-control" id="dateEnd">
                        </div>
                    </div>

                    <div class="col-12 col-md-4">
                        <label class="form-label">
                            分館 <span class="text-danger">*</span>
                        </label>
                        <select class="form-select" id="branchSelect">
                            <option value="全部分館">全部分館</option>
                            <option value="台北中山商旅">台北中山商旅</option>
                            <option value="台北信義商旅">台北信義商旅</option>
                            <option value="台中草悟商旅">台中草悟商旅</option>
                            <option value="台南安平商旅">台南安平商旅</option>
                            <option value="高雄港灣商旅">高雄港灣商旅</option>
                            <option value="花蓮站前商旅">花蓮站前商旅</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-4">
                        <label class="form-label">
                            操作類型 <span class="text-danger">*</span>
                        </label>
                        <select class="form-select" id="typeSelect">
                            <option value="全部類型" selected>全部類型</option>
                            @if (ViewBag.ActionTypes != null)
                            {
                                foreach (var name in ViewBag.ActionTypes)
                                {
                                    <option value="@name">@name</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <!-- 第二排：操作者、操作對象、查詢按鈕 -->
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-4">
                        <label class="form-label">操作者 <span class="text-secondary">＊選填</span></label>
                        <input type="text" class="form-control" id="operatorInput" placeholder="姓名 / 帳號">
                    </div>

                    <div class="col-12 col-md-4">
                        <label class="form-label">識別編號 <span class="text-secondary">＊選填</span></label>
                        <input type="text" class="form-control" id="targetInput" placeholder="編號 / 房號">
                    </div>

                    <div class="col-12 col-md-4 d-grid">
                        <button type="button" class="btn btn-primary" id="btnSearch">
                            查詢
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- 查詢結果列表區塊 -->
    <div class="card mb-4 shadow-sm d-none" id="resultCard">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 12%;">時間</th>
                        <th style="width: 12%;">分館</th>
                        <th style="width: 12%;">操作者</th>
                        <th style="width: 15%;">操作類型</th>
                        <th style="width: 12%;">操作對象</th>
                        <th style="width: 12%;">識別編號</th>
                        <th style="width: 25%;">說明</th>
                    </tr>
                </thead>
                <tbody id="resultTableBody"></tbody>
            </table>
        </div>
    </div>

    <!-- 查無資料的友善提示區塊 -->
    <div class="card mb-4 shadow-sm text-center py-5 d-none" id="noDataCard">
        <div class="card-body">
            <div class="text-secondary mb-3" style="font-size: 2.5rem;">🔍</div>
            <h5 class="fw-bold mb-2">很抱歉，在此篩選條件下查無任何資料</h5>
            <p class="text-muted small mb-0">請嘗試調整您的查詢日期或篩選條件後重新查詢。</p>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const dateStart = document.getElementById("dateStart");
            const dateEnd = document.getElementById("dateEnd");
            const btnSearch = document.getElementById("btnSearch");
            const resultCard = document.getElementById("resultCard");
            const noDataCard = document.getElementById("noDataCard");
            const resultTableBody = document.getElementById("resultTableBody");

            const branchSelect = document.getElementById("branchSelect");
            const typeSelect = document.getElementById("typeSelect");
            const operatorInput = document.getElementById("operatorInput");
            const targetInput = document.getElementById("targetInput");

            // 🎯 1. 動態計算今天的 yyyy-MM-dd 格式，徹底破解各家瀏覽器語系衝突 Bug！
            const today = new Date();
            const year = today.getFullYear();
            const month = String(today.getMonth() + 1).padStart(2, '0');
            const day = String(today.getDate()).padStart(2, '0');
            const todayStr = `${year}-${month}-${day}`;

            // 🎯 2. 動態計算一個月前的日期作為開始日期
            const oneMonthAgo = new Date();
            oneMonthAgo.setMonth(oneMonthAgo.getMonth() - 1);
            const startYear = oneMonthAgo.getFullYear();
            const startMonth = String(oneMonthAgo.getMonth() + 1).padStart(2, '0');
            const startDay = String(oneMonthAgo.getDate()).padStart(2, '0');
            const startStr = `${startYear}-${startMonth}-${startDay}`;

            // 🚀 正式安全賦值
            dateStart.value = startStr;
            dateEnd.value = todayStr;

            // 🎯 3. 徹底鎖死防呆：限制可選的最大日期就是今天
            dateStart.setAttribute("max", todayStr);
            dateEnd.setAttribute("max", todayStr);

            // 🎯 4. 日期連動防呆：後面的日期絕對不能小於前面
            function validateDates() {
                if (dateStart.value && dateEnd.value) {
                    if (dateStart.value > dateEnd.value) {
                        // 如果開始大於結束，強制把結束日期拉回跟開始日期一樣
                        dateEnd.value = dateStart.value;
                    }
                    // 動態限制結束日期的最小值不能小於開始日期
                    dateEnd.setAttribute("min", dateStart.value);
                }
            }

            // 一開網頁先執行一次防呆鎖定
            validateDates();

            // 監聽日期更換事件
            dateStart.addEventListener("change", validateDates);
            dateEnd.addEventListener("change", validateDates);

            // 🎯 5. 獨立宣告繪製表格的共用方法
            function renderTable(dataList) {
                resultTableBody.innerHTML = "";
                if (dataList && dataList.length > 0) {
                    dataList.forEach(item => {
                        const tr = document.createElement("tr");

                        // 時間字串格式化
                        let displayTime = item.operatedAt ? item.operatedAt.replace("T", " ").substring(0, 16) : "";

                        // 分館代號精準對照
                        let branchName = "總公司行政處";
                        if (item.targetBranchId == 1) branchName = "台北中山商旅";
                        else if (item.targetBranchId == 2) branchName = "台北信義商旅";
                        else if (item.targetBranchId == 3) branchName = "台中草悟商旅";
                        else if (item.targetBranchId == 4) branchName = "台南安平商旅";
                        else if (item.targetBranchId == 5) branchName = "高雄港灣商旅";
                        else if (item.targetBranchId == 6) branchName = "花蓮站前商旅";

                        tr.innerHTML = `
                                    <td class="text-secondary">${displayTime}</td>
                                    <td>${branchName}</td>
                                    <td>${item.operatorName || item.operatorEmployeeNumber || ""}</td>
                                    <td><span class="badge bg-light text-dark border">${item.operationTypeName || "操作"}</span></td>
                                    <td>${item.targetType || ""}</td>
                                    <td class="font-monospace fw-semibold">${item.targetIdentifier || ""}</td>
                                    <td class="small text-muted">${item.description || ""}</td>
                                `;
                        resultTableBody.appendChild(tr);
                    });
                    resultCard.classList.remove("d-none");
                    noDataCard.classList.add("d-none");
                } else {
                    resultCard.classList.add("d-none");
                    noDataCard.classList.remove("d-none");
                }
            }

            // 🎯 6. Fetch 異步連線後端核心
            function fetchRealData() {
                const queryParams = new URLSearchParams({
                    startDate: dateStart.value,
                    endDate: dateEnd.value,
                    branch: branchSelect.value,
                    type: typeSelect.value,
                    operatorInput: operatorInput.value.trim(),
                    target: targetInput.value.trim()
                });

                fetch(`/OperationLog/GetFilteredLogs?${queryParams.toString()}`)
                    .then(response => response.json())
                    .then(data => {
                        renderTable(data);
                    })
                    .catch(err => {
                        console.error("資料庫過濾發生錯誤:", err);
                    });
            }

            // 🎯 7. 監聽點擊查詢按鈕事件
            btnSearch.addEventListener("click", fetchRealData);
        });
    </script>
}


