@{
    ViewData["Title"] = "操作紀錄";
}

<div>
    <p class="text-secondary mb-4">查詢系統內各帳號的操作歷程紀錄</p>

    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <form id="searchForm" onsubmit="return false;">
                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-4">
                        <label class="form-label">
                            日期區間 <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <input type="date" class="form-control" id="dateStart">
                            <span class="input-group-text bg-light text-secondary">至</span>
                            <input type="date" class="form-control" id="dateEnd">
                        </div>
                    </div>

                    <div class="col-12 col-md-4">
                        <label class="form-label">
                            分館 <span class="text-danger">*</span>
                        </label>
                        <select id="branchSelect" class="form-control">
                            <option value="">全部分館</option>
                            @if (ViewBag.Branches != null)
                            {
                                foreach (var branch in ViewBag.Branches)
                                {
                                    <option value="@branch.BranchId">@branch.BranchName</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-12 col-md-4">
                        <label class="form-label">
                            操作類型 <span class="text-danger">*</span>
                        </label>
                        <select class="form-select" id="typeSelect">
                            <option value="" selected>全部類型</option>
                            @if (ViewBag.ActionTypes != null)
                            {
                                foreach (var name in ViewBag.ActionTypes)
                                {
                                    <option value="@name">@name</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-4">
                        <label class="form-label">操作者 <span class="text-secondary">＊選填</span></label>
                        <input type="text" class="form-control" id="operatorInput" placeholder="姓名 / 帳號">
                    </div>

                    <div class="col-12 col-md-4">
                        <label class="form-label">識別資訊 <span class="text-secondary">＊選填</span></label>
                        <input type="text" class="form-control" id="targetInput" placeholder="名稱 / 編號 / 房號">
                    </div>

                    <div class="col-12 col-md-4 d-grid">
                        <button type="button" class="btn btn-primary" id="btnSearch" onclick="executeSearch()">
                            查詢
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card mb-4 shadow-sm d-none" id="resultCard">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 15%;">時間</th>
                        <th style="width: 12%;">分館</th>
                        <th style="width: 12%;">操作者</th>
                        <th style="width: 15%;">操作類型</th>
                        <th style="width: 12%;">操作對象</th>
                        <th style="width: 12%;">識別資訊</th>
                        <th style="width: 22%;">說明</th>
                    </tr>
                </thead>
                <tbody id="resultTableBody"></tbody>
            </table>
        </div>
    </div>

    <div class="card mb-4 shadow-sm text-center py-5 d-none" id="noDataCard">
        <div class="card-body">
            <div class="text-secondary mb-3" style="font-size: 2.5rem;">🔍</div>
            <h5 class="fw-bold mb-2">很抱歉，在此篩選條件下查無任何資料</h5>
            <p class="text-muted small mb-0">請嘗試調整您的查詢日期或篩選條件後重新查詢。</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const dateStart = document.getElementById("dateStart");
            const dateEnd = document.getElementById("dateEnd");
            const btnSearch = document.getElementById("btnSearch");
            const resultCard = document.getElementById("resultCard");
            const noDataCard = document.getElementById("noDataCard");
            const resultTableBody = document.getElementById("resultTableBody");

            const branchSelect = document.getElementById("branchSelect");
            const typeSelect = document.getElementById("typeSelect");
            const operatorInput = document.getElementById("operatorInput");
            const targetInput = document.getElementById("targetInput");
            const targetTypeLabels = {
                Branch: "分館",
                RoomType: "房型",
                Room: "房間",
                Booking: "訂單",
                Employee: "員工"
            };

            const today = new Date();
            const year = today.getFullYear();
            const month = String(today.getMonth() + 1).padStart(2, '0');
            const day = String(today.getDate()).padStart(2, '0');
            const todayStr = `${year}-${month}-${day}`;

            const oneMonthAgo = new Date();
            oneMonthAgo.setMonth(oneMonthAgo.getMonth() - 1);
            const startYear = oneMonthAgo.getFullYear();
            const startMonth = String(oneMonthAgo.getMonth() + 1).padStart(2, '0');
            const startDay = String(oneMonthAgo.getDate()).padStart(2, '0');
            const startStr = `${startYear}-${startMonth}-${startDay}`;

            dateStart.value = startStr;
            dateEnd.value = todayStr;

            dateStart.setAttribute("max", todayStr);
            dateEnd.setAttribute("max", todayStr);

            function validateDates() {
                if (dateStart.value && dateEnd.value) {
                    if (dateStart.value > dateEnd.value) {
                        dateEnd.value = dateStart.value;
                    }
                    dateEnd.setAttribute("min", dateStart.value);
                }
            }

            validateDates();
            dateStart.addEventListener("change", validateDates);
            dateEnd.addEventListener("change", validateDates);

            // 使用 textContent 顯示資料，避免將資料庫字串解析為 HTML。
            window.renderTable = function(dataList) {
                resultTableBody.innerHTML = "";
                if (dataList && dataList.length > 0) {
                    dataList.forEach(item => {
                        const tr = document.createElement("tr");

                        const tdTime = document.createElement("td");
                        tdTime.textContent = item.operatedAt ? item.operatedAt.replace("T", " ").substring(0, 16) : "";
                        tr.appendChild(tdTime);

                        const tdBranch = document.createElement("td");
                        const spanBranch = document.createElement("span");
                        spanBranch.className = "badge bg-light text-dark border";
                        spanBranch.textContent = item.branchName || "系統核心";
                        tdBranch.appendChild(spanBranch);
                        tr.appendChild(tdBranch);

                        const tdOperator = document.createElement("td");
                        const strongOperator = document.createElement("strong");
                        strongOperator.className = "text-primary";
                        strongOperator.textContent = item.operatorName || "-";
                        tdOperator.appendChild(strongOperator);
                        tr.appendChild(tdOperator);

                        const tdType = document.createElement("td");
                        const spanType = document.createElement("span");
                        spanType.className = "text-secondary";
                        spanType.textContent = item.operationTypeName || "-";
                        tdType.appendChild(spanType);
                        tr.appendChild(tdType);

                        const tdTargetType = document.createElement("td");
                        const spanTgtType = document.createElement("span");
                        spanTgtType.className = "badge bg-secondary-subtle text-secondary-emphasis";
                        spanTgtType.textContent = targetTypeLabels[item.targetType] || item.targetType || "-";
                        tdTargetType.appendChild(spanTgtType);
                        tr.appendChild(tdTargetType);

                        const tdIdentifier = document.createElement("td");
                        const codeId = document.createElement("code");
                        codeId.textContent = item.targetIdentifier || "-";
                        tdIdentifier.appendChild(codeId);
                        tr.appendChild(tdIdentifier);

                        const tdDesc = document.createElement("td");
                        tdDesc.className = "text-muted small";
                        tdDesc.textContent = item.description || "-";
                        tr.appendChild(tdDesc);

                        resultTableBody.appendChild(tr);
                    });

                    resultCard.classList.remove("d-none");
                    noDataCard.classList.add("d-none");
                } else {
                    resultCard.classList.add("d-none");
                    noDataCard.classList.remove("d-none");
                }
            }

            window.executeSearch = async function() {
                btnSearch.disabled = true;
                btnSearch.innerText = "查詢中...";

                const sDate = dateStart.value;
                const eDate = dateEnd.value;
                const bId = branchSelect.value;
                const type = typeSelect.value;
                const op = operatorInput.value.trim();
                const tgt = targetInput.value.trim();

                try {

                    let url = `/OperationLog/GetFilteredLogs?startDate=${sDate}&endDate=${eDate}`;

                    if (bId) {
                        url += `&branchId=${parseInt(bId)}`;
                    }
                    if (type) {
                        url += `&type=${encodeURIComponent(type)}`;
                    }
                    if (op) {
                        url += `&operatorInput=${encodeURIComponent(op)}`;
                    }
                    if (tgt) {
                        url += `&target=${encodeURIComponent(tgt)}`;
                    }

                    const response = await fetch(url);
                    const data = await response.json();

                    if (data && data.success === false) {
                        alert("操作失敗：" + (data.message || "讀取紀錄失敗。"));
                        return;
                    }

                    renderTable(data);
                } catch (error) {
                    console.error(error);
                    alert("網路連線失敗，請檢查網路或伺服器狀態。");
                } finally {
                    btnSearch.disabled = false;
                    btnSearch.innerText = "查詢";
                }
            }

        });
    </script>
}
