    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4">
        <div class="room-status-tabs-wrapper flex-grow-1">
            <ul class="nav nav-tabs room-status-tabs" id="roomStatusTabs" role="tablist">
                <li class="nav-item" role="presentation"><button class="nav-link active" id="all-tab" data-bs-toggle="tab" data-bs-target="#all-pane" type="button" role="tab" aria-controls="all-pane" aria-selected="true">全部</button></li>
                <li class="nav-item" role="presentation"><button class="nav-link" id="available-tab" data-bs-toggle="tab" data-bs-target="#available-pane" type="button" role="tab" aria-controls="available-pane" aria-selected="false">可入住</button></li>
                <li class="nav-item" role="presentation"><button class="nav-link" id="reserved-tab" data-bs-toggle="tab" data-bs-target="#reserved-pane" type="button" role="tab" aria-controls="reserved-pane" aria-selected="false">保留</button></li>
                <li class="nav-item" role="presentation"><button class="nav-link" id="occupied-tab" data-bs-toggle="tab" data-bs-target="#occupied-pane" type="button" role="tab" aria-controls="occupied-pane" aria-selected="false">入住中</button></li>
                <li class="nav-item" role="presentation"><button class="nav-link" id="cleaning-tab" data-bs-toggle="tab" data-bs-target="#cleaning-pane" type="button" role="tab" aria-controls="cleaning-pane" aria-selected="false">待清潔</button></li>
                <li class="nav-item" role="presentation"><button class="nav-link" id="disabled-tab" data-bs-toggle="tab" data-bs-target="#disabled-pane" type="button" role="tab" aria-controls="disabled-pane" aria-selected="false">停用</button></li>
            </ul>
        </div>
        <div class="room-floor-filter">
            <label class="visually-hidden" for="floorFilter">選擇樓層</label>
            <select class="form-select" id="floorFilter" aria-label="選擇樓層"><option selected>全部樓層</option><option>3 樓</option><option>5 樓</option><option>6 樓</option></select>
        </div>
    </div>

