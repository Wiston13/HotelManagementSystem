@using HotelManagementSystem.Models.ViewModels.RoomStatus
@model RoomStatusViewModel

@{
	ViewData["Title"] = "房間供應與清潔狀態";
}
@{
	var availableRooms = Model.Rooms.Where(r => r.IsAvailable);

	var reservedRooms = Model.Rooms.Where(r => r.SupplyStatus == "Reserved");

	var occupiedRooms = Model.Rooms.Where(r => r.IsOccupied);

	var cleaningRooms = Model.Rooms.Where(r => r.CleaningStatus == "NeedsCleaning");

	var disabledRooms = Model.Rooms.Where(r => r.SupplyStatus == "Disabled");

	var roomTabs = new (
		string Id,
		string Label,
		IEnumerable<RoomStatusItemViewModel> Rooms,
		bool IsActive)[]
	{
		("all", "全部", Model.Rooms, true),
		("available", "可入住", availableRooms, false),
		("reserved", "保留", reservedRooms, false),
		("occupied", "入住中", occupiedRooms, false),
		("cleaning", "待清潔", cleaningRooms, false),
		("disabled", "停用", disabledRooms, false)
	};
}


@section Styles {
	<link rel="stylesheet" href="~/css/room-status/Index.css" asp-append-version="true" />
}

@if (TempData["ErrorMessage"] != null)
{
	<div class="alert alert-danger alert-dismissible fade show" role="alert">
		@TempData["ErrorMessage"]

		<button type="button"
				class="btn-close"
				data-bs-dismiss="alert"
				aria-label="關閉">
		</button>
	</div>
}

@if (TempData["SuccessMessage"] != null)
{
	<div class="alert alert-success alert-dismissible fade show" role="alert">
		@TempData["SuccessMessage"]

		<button type="button"
				class="btn-close"
				data-bs-dismiss="alert"
				aria-label="關閉">
		</button>
	</div>
}

@if (Model.CapacityRisk != null)
{
	var confirmationAction = Model.CapacityRisk.TargetStatus == "Disabled"
		? "UpdateDisabledStatus"
		: "UpdateSupplyStatus";

	<div class="modal fade"
		 id="capacityRiskModal"
		 tabindex="-1"
		 aria-labelledby="capacityRiskModalTitle"
		 aria-hidden="true">

		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content">
				<div class="modal-header">
					<h2 class="modal-title fs-5" id="capacityRiskModalTitle">
						未來可售房量風險確認
					</h2>

					<button type="button"
							class="btn-close"
							data-bs-dismiss="modal"
							aria-label="關閉">
					</button>
				</div>

				<div class="modal-body">
					<p>
						將房間 @Model.CapacityRisk.RoomNumber
						@(Model.CapacityRisk.TargetStatus == "Disabled" ? "停用" : "設為保留")
						會降低未來可售房量，並造成下列容量缺口：
					</p>

					<ul class="list-group mb-0">
						@foreach (var shortage in Model.CapacityRisk.Shortages)
						{
							<li class="list-group-item d-flex justify-content-between align-items-center">
								<span>@shortage.Date.ToString("yyyy/MM/dd")</span>
								<span class="badge text-bg-danger rounded-pill">
									短缺 @shortage.ShortageCount 間
								</span>
							</li>
						}
					</ul>

					<form asp-action="@confirmationAction"
						  method="post"
						  id="capacityRiskConfirmationForm">
						<input type="hidden" name="roomId" value="@Model.CapacityRisk.RoomId" />
						<input type="hidden" name="targetStatus" value="@Model.CapacityRisk.TargetStatus" />
						<input type="hidden" name="disabledReason" value="@Model.CapacityRisk.DisabledReason" />
						<input type="hidden" name="confirmed" value="true" />
					</form>
				</div>

				<div class="modal-footer">
					<button type="button"
							class="btn btn-outline-secondary"
							data-bs-dismiss="modal">
						取消
					</button>

					<button type="submit"
							class="btn btn-danger"
							form="capacityRiskConfirmationForm">
						仍要繼續
					</button>
				</div>
			</div>
		</div>
	</div>
}

<div class="room-status-page">
	<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4">
		<div class="room-status-tabs-wrapper flex-grow-1">
			<ul class="nav nav-tabs room-status-tabs"
				id="roomStatusTabs"
				role="tablist">

				@foreach (var tab in roomTabs)
				{
					<li class="nav-item" role="presentation">
						<button class="nav-link @(tab.IsActive ? "active" : "")"
								id="@($"{tab.Id}-tab")"
								data-bs-toggle="tab"
								data-bs-target="@($"#{tab.Id}-pane")"
								type="button"
								role="tab"
								aria-controls="@($"{tab.Id}-pane")"
								aria-selected="@tab.IsActive.ToString().ToLower()">

							@tab.Label
						</button>
					</li>
				}
			</ul>
		</div>
		<div class="room-floor-filter">
			<label class="visually-hidden" for="floorFilter">選擇樓層</label>
			<select class="form-select" id="floorFilter" aria-label="選擇樓層">
				<option value="" selected>全部樓層</option>
				@foreach(var floor in Model.Floors)
				{
					<option value="@floor">@floor 樓</option>
				}
			</select>
		</div>
	</div>

	<div class="tab-content" id="roomStatusTabContent">
		@foreach (var tab in roomTabs)
		{
			<div class="tab-pane fade @(tab.IsActive ? "show active" : "")"
				 id="@(tab.Id)-pane"
				 role="tabpanel"
				 aria-labelledby="@(tab.Id)-tab"
				 tabindex="0">

				<partial name="_RoomCards" model="tab.Rooms" />

			</div>
		}
	</div>
</div>

@foreach (var room in Model.Rooms)
{
	var supplyClass =
		room.SupplyStatus == "Open" ? "room-state--open" :
		room.SupplyStatus == "Reserved" ? "room-state--reserved" :
		"room-state--disabled";

	var supplyText =
		room.SupplyStatus == "Open" ? "開放販售" :
		room.SupplyStatus == "Reserved" ? "保留" :
		"停用";

	var cleaningClass =
		room.CleaningStatus == "Clean"
			? "room-state--clean"
			: "room-state--dirty";

	var cleaningText =
		room.CleaningStatus == "Clean"
			? "已清潔"
			: "待清潔";


	@* =========================
       入住中：唯讀詳細資訊
       ========================= *@
	@if (room.IsOccupied)
	{
		<div class="modal fade"
			 id="room@(room.RoomId)Modal"
			 tabindex="-1"
			 aria-labelledby="room@(room.RoomId)ModalTitle"
			 aria-hidden="true">

			<div class="modal-dialog modal-dialog-centered modal-lg">
				<div class="modal-content">

					<div class="modal-header">
						<h2 class="modal-title fs-5"
							id="room@(room.RoomId)ModalTitle">
							房間詳細資訊
						</h2>

						<button type="button"
								class="btn-close"
								data-bs-dismiss="modal"
								aria-label="關閉">
						</button>
					</div>

					<div class="modal-body">

						<dl class="room-modal-details row g-3 mb-0">

							<div class="col-sm-6">
								<dt>房號</dt>
								<dd>@room.RoomNumber</dd>
							</div>

							<div class="col-sm-6">
								<dt>房型</dt>
								<dd>@room.RoomTypeName</dd>
							</div>

							<div class="col-sm-6">
								<dt>主要住客姓名</dt>
								<dd>@room.PrimaryGuestName</dd>
							</div>

							<div class="col-sm-6">
								<dt>訂房電話</dt>
								<dd>@room.ContactPhone</dd>
							</div>

							<div class="col-sm-6">
								<dt>訂單編號</dt>
								<dd>@room.BookingNumber</dd>
							</div>

							<div class="col-sm-6">
								<dt>入住日</dt>
								<dd>
									@(room.CheckInDate?.ToString("MM/dd") ?? "-")
								</dd>
							</div>

							<div class="col-sm-6">
								<dt>預計退房日</dt>
								<dd>
									@(room.CheckOutDate?.ToString("MM/dd") ?? "-")
								</dd>
							</div>

							<div class="col-sm-6">
								<dt>Check-in 時間</dt>
								<dd>
									@(room.ActualCheckInAt?.ToString() ?? "-")
								</dd>
							</div>

						</dl>

					</div>

					<div class="modal-footer">
						<button type="button"
								class="btn btn-primary"
								data-bs-dismiss="modal">
							關閉
						</button>
					</div>

				</div>
			</div>
		</div>
	}
	else
	{
		@* =========================
           無住客：房況管理
           ========================= *@
		<div class="modal fade"
			 id="room@(room.RoomId)Modal"
			 tabindex="-1"
			 aria-labelledby="room@(room.RoomId)ModalTitle"
			 aria-hidden="true">

			<div class="modal-dialog modal-dialog-centered">
				<div class="modal-content">

					<div class="modal-header">

						<h2 class="modal-title fs-5"
							id="room@(room.RoomId)ModalTitle">
							房間狀態管理
						</h2>

						<button type="button"
								class="btn-close"
								data-bs-dismiss="modal"
								aria-label="關閉">
						</button>

					</div>

					<div class="modal-body">

						<dl class="room-modal-details row g-3 mb-4">

							<div class="col-6">
								<dt>房號</dt>
								<dd>@room.RoomNumber</dd>
							</div>

							<div class="col-6">
								<dt>房型</dt>
								<dd>@room.RoomTypeName</dd>
							</div>

							@if (room.SupplyStatus == "Disabled"
								&& !string.IsNullOrWhiteSpace(room.DisabledReason))
							{
								<div class="col-12">
									<form asp-action="UpdateDisabledReason"
										  method="post"
										  id="disabledReasonForm@(room.RoomId)">

										<input type="hidden"
											   name="roomId"
											   value="@room.RoomId" />

										<div class="d-flex justify-content-between align-items-center mb-2">
											<label for="disabledReason@(room.RoomId)" class="form-label mb-0">
												停用原因
											</label>

											<button type="button"
													class="btn btn-sm btn-outline-secondary edit-disabled-reason-btn"
													data-room-id="@room.RoomId">
												修改
											</button>
										</div>

										<textarea id="disabledReason@(room.RoomId)"
												  name="disabledReason"
												  class="form-control"
												  rows="3"
												  data-saved-value="@room.DisabledReason"
												  readonly>@room.DisabledReason</textarea>

										<div class="invalid-feedback">
											請填寫停用原因。
										</div>
									</form>
								</div>
							}

						</dl>


						@* 供應狀態 *@
						<div class="room-modal-section">

							<h3 class="h6">供應狀態</h3>

							<p class="mb-3">
								<span class="badge room-state @supplyClass">
									@supplyText
								</span>
							</p>

							<div class="d-flex flex-wrap gap-2">

								@if (room.SupplyStatus == "Open")
								{
									<form asp-action="UpdateSupplyStatus" method="post">
										<input type="hidden" name="roomId" value="@room.RoomId" />
										<input type="hidden" name="targetStatus" value="Reserved" />

										<button type="submit" class="btn btn-outline-primary">保留</button>
									</form>

									<button type="button"
											class="btn btn-outline-danger"
											data-bs-toggle="modal"
											data-bs-target="#disableRoom@(room.RoomId)Modal"
											data-bs-dismiss="modal">
										停用
									</button>
								}
								else if (room.SupplyStatus == "Reserved")
								{
									<form asp-action="UpdateSupplyStatus" method="post">
										<input type="hidden" name="roomId" value="@room.RoomId" />
										<input type="hidden" name="targetStatus" value="Open" />

										<button type="submit" class="btn btn-outline-primary">解除保留</button>
									</form>

									<button type="button"
											class="btn btn-outline-danger"
											data-bs-toggle="modal"
											data-bs-target="#disableRoom@(room.RoomId)Modal"
											data-bs-dismiss="modal">
										停用
									</button>
								}
								else if (room.SupplyStatus == "Disabled")
								{
									<form asp-action="UpdateDisabledStatus" method="post">
										<input type="hidden" name="roomId" value="@room.RoomId" />
										<input type="hidden" name="targetStatus" value="Open" />

										<button type="submit"
												class="btn btn-outline-primary">
											恢復開放販售
										</button>
									</form>
								}

							</div>
						</div>


						@* 清潔狀態 *@
						<div class="room-modal-section">

							<h3 class="h6">清潔狀態</h3>

							<p class="mb-3">
								<span class="badge room-state @cleaningClass">
									@cleaningText
								</span>
							</p>

							@if (room.CleaningStatus == "Clean")
							{
								<form asp-action="UpdateCleaningStatus" method="post">
									<input type="hidden" name="roomId" value="@room.RoomId" />
									<input type="hidden" name="targetStatus" value="NeedsCleaning" />

									<button type="submit" class="btn btn-outline-primary">標記為待清潔</button>
								</form>
							}
							else
							{
								<form asp-action="UpdateCleaningStatus" method="post">
									<input type="hidden" name="roomId" value="@room.RoomId" />
									<input type="hidden" name="targetStatus" value="Clean" />

									<button type="submit" class="btn btn-outline-primary">標記為已清潔</button>
								</form>
							}

						</div>

					</div>

					<div class="modal-footer">
						<button type="button"
								class="btn btn-outline-secondary"
								data-bs-dismiss="modal">
							取消
						</button>
					</div>

				</div>
			</div>
		</div>


		@* =========================
           停用確認 Modal
           Disabled 已經停用了，不需要
           ========================= *@
		@if (room.SupplyStatus != "Disabled")
		{
			<div class="modal fade"
				 id="disableRoom@(room.RoomId)Modal"
				 tabindex="-1"
				 aria-labelledby="disableRoom@(room.RoomId)ModalTitle"
				 aria-hidden="true">

				<div class="modal-dialog modal-dialog-centered">
					<div class="modal-content">

						<div class="modal-header">

							<h2 class="modal-title fs-5"
								id="disableRoom@(room.RoomId)ModalTitle">
								確認停用房間
							</h2>

							<button type="button"
									class="btn-close"
									data-bs-dismiss="modal"
									aria-label="關閉">
							</button>

						</div>

						<div class="modal-body">

							<form asp-action="UpdateDisabledStatus"
								  method="post"
								  id="updateDisabledStatusForm@(room.RoomId)">

								<input type="hidden"
									   name="roomId"
									   value="@room.RoomId" />

								<input type="hidden"
									   name="targetStatus"
									   value="Disabled" />

								<p>房號：@room.RoomNumber</p>

								<label for="disableReason@(room.RoomId)"
									   class="form-label">
									停用原因
									<span class="text-danger">*</span>
								</label>

								<textarea id="disableReason@(room.RoomId)"
										  name="disabledReason"
										  class="form-control"
										  rows="3"
										  required
										  aria-required="true"></textarea>
							</form>
						</div>

						<div class="modal-footer">

							<button type="button"
									class="btn btn-outline-secondary"
									data-bs-dismiss="modal">
								取消
							</button>

							<button type="submit"
									class="btn btn-danger"
									form="updateDisabledStatusForm@(room.RoomId)">
								確認停用
							</button>

						</div>

					</div>
				</div>
			</div>
		}
	}
}


@section Scripts {
	<script>
		$("#floorFilter").on("change", function() {
			const selectedFloor = $(this).val();

			// 先篩房間卡片
			$("[data-floor]").each(function() {
				const roomFloor = $(this).data("floor");

				if (selectedFloor === "" || roomFloor == selectedFloor) {
					$(this).show();
				} else {
					$(this).hide();
				}
			});

			// 再決定房型區塊要不要顯示
			$(".room-type-group").each(function() {
				const hasMatchingRoom =
					selectedFloor === "" ||
					$(this).find(`[data-floor="${selectedFloor}"]`).length > 0;

				if (hasMatchingRoom) {
					$(this).show();
				} else {
					$(this).hide();
				}
			});
		});


		$(".edit-disabled-reason-btn").on("click", function() {
			const roomId = $(this).data("room-id");
			const textarea = $(`#disabledReason${roomId}`);
			const form = $(`#disabledReasonForm${roomId}`);
			const button = $(this);

			// 第一次按：進入編輯模式
			if (textarea.prop("readonly")) {
				textarea.prop("readonly", false);
				textarea.focus();

				button.text("儲存");
				button
					.removeClass("btn-outline-secondary")
					.addClass("btn-primary");

				return;
			}

			// 第二次按：準備儲存
			const newReason = textarea.val().trim();

			// 前端驗證
			if (newReason === "") {
				textarea.addClass("is-invalid");
				textarea.focus();
				return;
			}

			textarea.removeClass("is-invalid");

			// AJAX POST
			$.ajax({
				url: form.attr("action"),
				type: "POST",
				data: form.serialize(),

				success: function(response) {
					textarea.val(response.disabledReason);
					textarea.attr("data-saved-value", response.disabledReason);
					textarea.prop("readonly", true);

					button.text("修改");
					button
						.removeClass("btn-primary")
						.addClass("btn-outline-secondary");

					$(`.disabled-reason-meta[data-room-id="${roomId}"]`)
						.text(response.disabledReason);
				},

				error: function() {
					window.location.reload();
				}
			});
		});

		$(".modal").on("hidden.bs.modal", function() {
			const textarea = $(this).find('textarea[name="disabledReason"]');
			const button = $(this).find(".edit-disabled-reason-btn");

			if (textarea.length === 0 || button.length === 0) {
				return;
			}

			const savedValue = textarea.attr("data-saved-value");

			textarea.val(savedValue);
			textarea.prop("readonly", true);
			textarea.removeClass("is-invalid");

			button.text("修改");
			button
				.removeClass("btn-primary")
				.addClass("btn-outline-secondary");
		});
	</script>
}

@if (Model.CapacityRisk != null)
{
	<script>
		document.addEventListener("DOMContentLoaded", function() {
			const modalElement = document.getElementById("capacityRiskModal");

			if (modalElement) {
				const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
				modal.show();
			}
		});
	</script>
}

@if (Model.OpenModalRoomId.HasValue)
{
	<script>
		document.addEventListener("DOMContentLoaded", function() {
			const modalElement =
				document.getElementById("room@(Model.OpenModalRoomId.Value)Modal");

			if (modalElement) {
				const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
				modal.show();
			}
		});
	</script>
}
