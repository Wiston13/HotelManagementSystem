    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "房客須知";
}


<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-12 col-lg-9 col-xl-8">

            
            <!-- 頁面標題 -->
            <div class="text-center mb-5">
                <h1 class="h2 fw-bold mb-3">房客須知</h1>
                <p class="text-secondary mb-0">
                    為保障您的訂房權益，請於訂房前詳閱以下注意事項。
                    完成訂房即表示您已了解並同意相關規定。
                </p>
            </div>


            <!-- 一、訂房須知 -->
            <section class="mb-5">

                <h2 class="h4 fw-bold border-bottom pb-2 mb-3">
                    一、訂房須知
                </h2>

                <ul class="mb-0">
                    <li class="mb-2">
                        本網站提供免會員訂房服務，無須註冊或登入。
                    </li>
                    <li class="mb-2">
                        訂房時請選擇分館、入住日期、退房日期及符合入住人數的房型。
                    </li>
                    <li class="mb-2">
                        每筆訂房限預訂一間客房及一種房型，無法指定房號。
                    </li>
                    <li class="mb-2">
                        房型、房價及房量依訂房時系統顯示為準。
                    </li>
                    <li>
                        請確認訂房人姓名、電話及電子信箱等資料正確。
                    </li>
                </ul>

            </section>


            <!-- 二、付款須知 -->
            <section class="mb-5">

                <h2 class="h4 fw-bold border-bottom pb-2 mb-3">
                    二、付款須知
                </h2>

                <ul class="mb-0">
                    <li class="mb-2">
                        本網站僅提供信用卡付款，應付金額為訂單總額。
                    </li>
                    <li class="mb-2">
                        付款送出後，系統會再次確認分館、房型、價格及房量；
                        若條件變更或房量不足，將無法完成訂房且不會扣款。
                    </li>
                    <li class="mb-2">
                        確認無誤並付款成功後，才會建立訂單並保留住宿期間的房量；
                        付款失敗則不建立訂單。
                    </li>
                    <li class="mb-2">
                        請勿重複點擊付款按鈕。
                    </li>
                    <li>
                        系統不會保存信用卡號及安全碼。
                    </li>
                </ul>

            </section>


            <!-- 三、訂房成功與訂單 -->
            <section class="mb-5">

                <h2 class="h4 fw-bold border-bottom pb-2 mb-3">
                    三、訂房成功與訂單
                </h2>

                <ul class="mb-0">
                    <li class="mb-2">
                        訂房成功後，頁面會顯示訂房成功及訂單編號，
                        並寄送確認信至您提供的電子信箱。
                    </li>
                    <li>
                        請妥善保存訂單編號，查詢訂單及辦理入住時皆需使用。
                    </li>
                </ul>

            </section>


            <!-- 四、入住須知 -->
            <section class="mb-5">

                <h2 class="h4 fw-bold border-bottom pb-2 mb-3">
                    四、入住須知
                </h2>

                <ul class="mb-0">
                    <li class="mb-2">
                        辦理入住時，請提供訂單編號供分館人員查詢，
                        並配合核對訂房人身分。
                    </li>
                    <li class="mb-2">
                        入住時間為 <strong>16:00 起</strong>，
                        退房時間為 <strong>12:00 前</strong>。
                    </li>
                    <li>
                        房間由分館依預訂房型於入住時安排，無法事先指定。
                    </li>
                </ul>

            </section>


            <!-- 五、訂單查詢 -->
            <section class="mb-5">

                <h2 class="h4 fw-bold border-bottom pb-2 mb-3">
                    五、訂單查詢
                </h2>

                <ul class="mb-0">
                    <li class="mb-2">
                        本網站提供免登入的訂單查詢功能。
                    </li>
                    <li class="mb-2">
                        查詢時需輸入訂單編號及訂房電話。
                    </li>
                    <li>
                        訂單狀態將依實際入住、退房、取消或逾期未入住情況顯示。
                    </li>
                </ul>

            </section>


            <!-- 六、取消與訂單變更 -->
            <section class="mb-5">

                <h2 class="h4 fw-bold border-bottom pb-2 mb-3">
                    六、取消與訂單變更
                </h2>

                <ul class="mb-0">
                    <li class="mb-2">
                        已成立訂單不提供修改；如需取消訂房，請於
                        <strong>入住日期前一日 23:59 前</strong>
                        聯絡原訂房分館，由分館人員協助處理。
                    </li>
                </ul>

            </section>


            <!-- 七、其他注意事項 -->
            <section class="mb-5">

                <h2 class="h4 fw-bold border-bottom pb-2 mb-3">
                    七、其他注意事項
                </h2>

                <ul class="mb-0">
                    <li class="mb-2">
                        房型及房量會隨訂房情況變動，查詢時有空房不代表會持續保留至付款完成。
                    </li>
                    <li>
                        如有訂房、入住或取消相關問題，請聯絡原訂房分館。
                    </li>
                </ul>

            </section>


            <!-- 重要提醒 -->
            <div class="alert alert-light border text-center py-4 mb-0">

                <h2 class="h5 fw-bold mb-3">
                    重要提醒
                </h2>
                <p class="fw-bold mb-2">
                    選擇房型 ≠ 訂房成立
                </p>
                <p class="mb-0">
                    完成付款並成功建立訂單後，訂房才算完成。
                </p>

            </div>


        </div>

    </div>

</div>

