<!-- Index.cshtml -->
<div class="container-fluid bg-white sticky-top shadow-sm py-2" style="top: 0; z-index: 1020;">
    <div class="container my-1">
        <!-- 查詢區塊 Card -->
        <div class="card shadow-sm border-0 bg-light mb-0">
            <div class="card-body">
                
                <form>
                    <div class="row g-3 align-items-end">
                        <!-- 分館 (佔 3 份) -->
                        <div class="col-md-3">
                            <label class="form-label text-muted small">分館</label>
                            <!-- 這裡之後會換成 ASP.NET 的 Helper -->
                            <!-- 此處判斷資料異常時顯示預設文字-->
                            <select class="form-select" id="HotelSelect" name="branchId">

                                <option value="" disabled selected hidden>
                                    選擇分館
                                </option>

                                @foreach (var branch in Model.Branches.Where(b => b.AcceptsNewBookings))
                                {
                                    <option value="@branch.BranchId">
                                        @branch.BranchName
                                    </option>
                                }
                            </select>
                        </div>

                        <!-- 選擇日期 (佔 4 份) -->
                        <div class="col-md-4">
                            <label class="form-label text-muted small">入住日期－退房日期</label>
                            <input type="text" id="dateTime" class="form-control" value="" placeholder="選擇入住與退房日期"
                                   style="">
                        </div>

                        <!-- 人數 (佔 2 份) -->
                        <div class="col-md-2">
                            <label class="form-label text-muted small">房型人數</label>
                            <select class="form-select" id="RoomSelect">
                                <option value="" disabled selected hidden>選擇房型人數</option>
                                <option value="" disabled >請先選擇分館</option>                            
                            </select>
                        </div>

                        <!-- 查詢按鈕 (佔 2 份) -->
                        <div class="col-md-3">
                            <button type="button" id="submitBtn" class="btn btn-primary w-100">查詢可售房型</button>
                        </div>

                    </div>
                </form>

                
            </div>
        </div>
    </div>
</div>

<script>
    // 日期顯示區
    let maxRangeDate = new Date();
    maxRangeDate.setDate(maxRangeDate.getDate() + 60);
    flatpickr("#dateTime", {
        mode: "range",
        minDate: "today",
        maxDate: maxRangeDate,
        dateFormat: "Y-m-d",
        altInput: true,
        altFormat: "Y.m.d",
        showMonths: 2,
        locale: {
            weekdays: {
                shorthand: ["日", "一", "二", "三", "四", "五", "六"],
                longhand: ["星期日", "星期一", "星期二", "星期三", "星期四", "星期五", "星期六"]
            }, months: {
                shorthand: ["1月", "2月", "3月", "4月", "5月", "6月", "7月", "8月", "9月", "10月", "11月", "12月"],
                longhand: ["1月", "2月", "3月", "4月", "5月", "6月", "7月", "8月", "9月", "10月", "11月", "12月"]
            },
            rangeSeparator: " - ",
        },
        onClose: function(selectedDates, dateStr, instance) {
            // 如果選了兩個日期，且起訖是同一天
            if (selectedDates.length === 2 && selectedDates[0].getTime() === selectedDates[1].getTime()) {
                let nextDay = new Date(selectedDates[0]);
                nextDay.setDate(nextDay.getDate() + 1); // 自動加一天
                instance.setDate([selectedDates[0], nextDay], true);
            }
        }
    });

    // 點擊事件判斷
    let HotelSelect = document.getElementById("HotelSelect");
    let dateTime = document.getElementById("dateTime");
    let RoomSelect = document.getElementById("RoomSelect");
    
    var roomTypes = [
        @foreach (var roomType in Model.RoomTypes)
        {
            <text>
            {
                branchId: @roomType.BranchId,
                maxOccupancy: @roomType.MaxOccupancy,
                isActive: @roomType.IsActive.ToString().ToLower()
            },
            </text>
        }
    ];
    

    var validRoom;
    document.getElementById("submitBtn").addEventListener("click", function() 
    {
        let isValid = true;
        let startDate;
        let endDate;

        // 分館欄位判斷
        if (HotelSelect.value === "") {
            HotelSelect.classList.add("is-invalid");
            isValid = false;
        }
        else {
            HotelSelect.classList.remove("is-invalid");
        }

        // 日期欄位判斷
        let altInput = dateTime._flatpickr ? dateTime._flatpickr.altInput : null;

        if (dateTime.value === "") {
            altInput.classList.add("is-invalid");
            isValid = false;
        }
        else {
            startDate = dateTime.value.slice(0, 10);
            endDate = dateTime.value.slice(13, 23);

            if (!checkDate(startDate) || !checkDate(endDate)) {
                altInput.classList.add("is-invalid");
                isValid = false;
            }
            else {
                altInput.classList.remove("is-invalid");
            }
        }

        // 房型人數欄位判斷   
        if (RoomSelect.value === "") {
            RoomSelect.classList.add("is-invalid");
            isValid = false;
        }
        else {
            RoomSelect.classList.remove("is-invalid");
        }
        

        if (!isValid) {
            return;
        }

        // 將查詢參數 以url傳去 /Booking/RoomSelection      
        let branchId = Number(HotelSelect.value);
        let targetUrl =
            `/Booking/RoomSelection` +
            `?branchId=${branchId}` +
            `&checkIn=${startDate}` +
            `&checkOut=${endDate}` +
            `&guestCount=${RoomSelect.value}`;

        window.location.href = targetUrl;

    });



    HotelSelect.addEventListener("change", function() 
    {
        let selectedBranchId = Number(this.value);
        
        if (!selectedBranchId) return;  // 如果沒有選擇有效的分館，就不繼續執行

        // 找出該分館的啟用房型
        let branchRoomTypes = roomTypes.filter(function(roomType) {
            return roomType.branchId === selectedBranchId
                && roomType.isActive;
        });

        // 清空原本的人數選項
        RoomSelect.innerHTML =
            '<option value="" disabled selected hidden>選擇房型人數</option>';

        // 取得不重複的人數
        let occupancies = [
            ...new Set(
                branchRoomTypes.map(function(roomType) {
                    return roomType.maxOccupancy;
                })
            )
        ];

        // 建立下拉選項
        occupancies.forEach(function(num) {

            // 建立一個 HTML <option> 元素
            let option = document.createElement("option");
            option.value = num;

            // UI 顯示文字
            let roomText = {
                1: "單人房",
                2: "雙人房",
                3: "三人房",
                4: "四人房",
                6: "六人房"
            };
            option.textContent = roomText[num] ?? `${num}人房`;

            RoomSelect.appendChild(option);
        });

    });


    //驗證日期格式
    function checkDate(value) {
        const d = new Date(value);

        return !isNaN(d.getTime()) && value === d.toISOString().split('T')[0];
    }
    
    // 按下紅色欄位 會消除紅色警告

    HotelSelect.addEventListener("click", function() {
        this.classList.remove("is-invalid");
    });
    let altInput = dateTime._flatpickr ? dateTime._flatpickr.altInput : null;
    altInput.addEventListener("click", function() {
        this.classList.remove("is-invalid");
    });
    RoomSelect.addEventListener("click", function() {
        this.classList.remove("is-invalid");
    });
</script>


<!--      html       -->

<div class="container my-5">
    <!-- 1. 區域選擇按鈕區塊 -->
    <!-- 地區選擇按鈕區塊 (加入左右箭頭與包覆層) -->
    <div class="region-wrapper mb-5">
        <!-- 左箭頭 (預設隱藏) -->
        <button class="scroll-arrow left-arrow hidden" id="scrollLeftBtn">
            <i class="bi bi-arrow-left"></i>
        </button>

        <!-- 按鈕滾動區塊 -->
        <div class="region-scroll" id="regionContainer">
            <!-- 假設每個按鈕設定固定寬度或 flex-shrink-0 確保一次看得見約 4 個 -->
            
            <!-- 全部分館 -->
            <button class="btn btn-outline-primary px-4 py-2 flex-shrink-0 region-btn active"
                    style="min-width: 140px;"
                    data-region="all">
                    所有分館
            </button>
            
            @{
                var regions = Model.Branches
                    .Where(b => !string.IsNullOrEmpty(b.Region))
                    .Select(b => b.Region)
                    .Distinct()
                    .ToList();
            }
            @for (int i = 0; i < regions.Count; i++)
            {
                <button class="btn btn-outline-primary px-4 py-2 flex-shrink-0 region-btn"
                        style="min-width: 140px;"
                        data-region="@regions[i]">
                    @regions[i]
                </button>
            }


        </div>

        <!-- 右箭頭 -->
        <button class="scroll-arrow right-arrow" id="scrollRightBtn">
            <i class="bi bi-arrow-right"></i>
        </button>
    </div>

    <!-- 2. 詳細介紹展開區塊 (預設隱藏 display: none) -->
    <!-- Bootstrap Grid 12等分，6:4 找不到整數，我們用 7:5 (約 58% : 41%) 視覺上最接近你要的比例 -->
    <div id="detailView" class="mb-5 branch-detail-section" style="display: none;">
        <div class="row g-4">
            <!-- 左側 7 份：大圖與關閉按鈕 -->
            <div class="col-md-7 position-relative">
                <button id="closeDetailBtn" class="close-detail-btn">
                    <i class="bi bi-x-lg"></i>
                </button>
                <img id="detailImg" src="" class="img-fluid rounded-3 detail-img-cover shadow-sm">
            </div>

            <!-- 右側 5 份：詳細資訊 -->
            <div class="col-md-5 d-flex flex-column justify-content-center">
                <h3 id="detailTitle" class="fw-bold mb-3 text-primary">分館名稱</h3>
                <p class="text-secondary lh-lg mb-4">
                    <span id="detailIntro">分館介紹載入中...</span>
                </p>
                <ul class="list-unstyled text-secondary">
                    <li class="mb-3 d-flex align-items-center">
                        <i class="bi bi-geo-alt-fill text-primary fs-5 me-3"></i>
                        <span id="detailAddress">地址載入中...</span>
                    </li>
                    <li class="mb-3 d-flex align-items-center">
                        <i class="bi bi-telephone-fill text-primary fs-5 me-3"></i>
                        <span id="detailPhone">電話載入中...</span>
                    </li>
                </ul>
            </div>
        </div>
        <!-- 分隔線 -->
        <hr class="mt-5 text-muted">
    </div>

    <!-- 3. 分館列表 (響應式：大螢幕3排、平板2排、手機1排) -->
    @*因資料存取為了方便閱讀 用匿名資料存'a[] 但執行程式再載入後立刻執行 因此將全部資料都讀取再隱藏*@
    
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

        @foreach (var branch in Model.Branches)
        {
            <div class="col branch-card" data-region="@branch.Region">
                <div class="card border-0 branch-card-wrapper" data-Intro="@branch.Description">


                    <div class="position-relative">
                        <img src="@branch.ImageUrl"
                             class="card-img-top rounded-0 branch-img-trigger"
                             alt="@branch.BranchName">
                    </div>
                    

                    <div class="card-body px-3">
                        <h5 class="card-title text-primary fw-bold branch-title">
                            @branch.BranchName
                        </h5>
                        <p class="card-text text-muted small mb-1 branch-address">
                            @branch.Address
                        </p>
                        <p class="card-text text-muted small branch-phone">
                            @branch.Phone
                        </p>
                    </div>


                    @if (!branch.AcceptsNewBookings)
                    {
                        <div class="branch-closed-overlay">
                            <span>目前停止接受新訂房</span>
                        </div>
                    }


                </div>
            </div>
        }

    </div>


</div>

<!--     Javascript     -->
<script>

    const regionContainer = document.getElementById('regionContainer');
    const scrollLeftBtn = document.getElementById('scrollLeftBtn');
    const scrollRightBtn = document.getElementById('scrollRightBtn');

    regionContainer.addEventListener('click', function(e) {
        // 檢查被點擊的是不是我們按鈕
        let clickBtn = e.target.closest('.region-btn');
        if (!clickBtn) return;

        // 1. 移除所有按鈕的 active 樣式
        regionContainer.querySelectorAll('.region-btn').forEach(function(btn) {
            btn.classList.remove('active');
        });

        // 2. 將 active 樣式加到當前被點擊的按鈕上
        clickBtn.classList.add('active');

        // 3. 取得被點擊的地區名稱文字（例如："高雄 Kaohsiung"）
        let selectedRegion = clickBtn.getAttribute('data-region');

        switchCardGroup(selectedRegion);

    });

    
    
    function switchCardGroup(regionName) {        

        // 1. 如果有展開詳細介紹，先關閉
        let detailView = document.getElementById('detailView');
        detailView.style.display = 'none';

        if (currentExpandedCard !== null) {
            currentExpandedCard.style.display = '';    // 讓 Bootstrap 自己恢復原本的 .col 顯示方式。
            currentExpandedCard = null;
        }

        // 2. 找到所有分館卡片，根據地區決定顯示或隱藏
        let allCards = document.querySelectorAll('.branch-card');

        allCards.forEach(function(card) {

            // 「所有分館」
            if (regionName === 'all') {
                card.style.display = '';
            }
            // 指定地區
            else if (card.dataset.region === regionName) {
                card.style.display = '';
            }
            // 其他地區
            else {
                card.style.display = 'none';
            }

        });

    }

    
    // 檢查並更新左右箭頭的顯示狀態
    function updateArrowVisibility() {
        let scrollLeft = regionContainer.scrollLeft;
        let maxScrollLeft = regionContainer.scrollWidth - regionContainer.clientWidth;

        // 如果向左滾動超過 5px，顯示左箭頭；否則隱藏
        if (scrollLeft > 2) {
            scrollLeftBtn.classList.remove('hidden');
        } else {
            scrollLeftBtn.classList.add('hidden');
        }

        // 如果還沒滾到底，顯示右箭頭；否則隱藏
        if (scrollLeft < maxScrollLeft - 2) {
            scrollRightBtn.classList.remove('hidden');
        } else {
            scrollRightBtn.classList.add('hidden');
        }
    }

    // 初始化先檢查一次
    window.addEventListener('load', updateArrowVisibility);

    // 監聽滾動事件，即時更新箭頭
    regionContainer.addEventListener('scroll', updateArrowVisibility);


    //底下要加入判斷是否還有得按
    let movePx = 301;
    let isScrolling = false;
    // 點擊右箭頭：向右滾動一個區塊的距離
    scrollRightBtn.addEventListener('click', function() {
        if (isScrolling) return;
        isScrolling = true;
        regionContainer.scrollBy({ left: movePx, behavior: 'smooth' });
        setTimeout(function() { isScrolling = false }, 350);
    });

    // 點擊左箭頭：向左滾動一個區塊的距離
    scrollLeftBtn.addEventListener('click', function() {
        if (isScrolling) return;
        isScrolling = true;
        regionContainer.scrollBy({ left: -movePx, behavior: 'smooth' });
        setTimeout(function() { isScrolling = false }, 350);
    });


    // ==========================================
    // 原有的分館卡片切換邏輯
    // ==========================================
    let currentExpandedCard = null;

    document.querySelectorAll('.branch-img-trigger').forEach(function(img) {
        img.addEventListener('click', function() {
            // 取得這張圖片所在的整張卡片容器
            let clickedCard = this.closest('.branch-card');
            let cardData = clickedCard.querySelector('.card');// 藏有 data-* 屬性的那層


            if (currentExpandedCard !== null) {
                currentExpandedCard.style.display = 'block';
            }

            clickedCard.style.display = 'none';
            currentExpandedCard = clickedCard;

            // --- 從 data-* 屬性中安全抓取所有資料 ---
            let targetImgSrc = this.src;
            let targetTitle = clickedCard.querySelector('.branch-title').innerText;
            let targetAddress = clickedCard.querySelector('.branch-address').innerText;
            let targetPhone = clickedCard.querySelector('.branch-phone').innerText;
            let targetIntro = cardData.getAttribute('data-Intro');// 抓出專屬介紹文字
            //若有其他資料 繼續新增
            document.getElementById('detailImg').src = targetImgSrc;
            document.getElementById('detailTitle').innerText = targetTitle;
            document.getElementById('detailIntro').innerText = targetIntro;
            document.getElementById('detailAddress').innerText = targetAddress;
            document.getElementById('detailPhone').innerText = targetPhone;

            let detailView = document.getElementById('detailView');
            detailView.style.display = 'block';

            window.scrollTo({
                top: detailView.offsetTop - 80,
                behavior: 'smooth'
            });

            
            // 按下分館圖片後將介紹頁置中
            let detailSection = document.querySelector('.branch-detail-section');
            if (detailSection) {
                detailSection.scrollIntoView({
                    behavior: 'smooth',
                    block: 'center'
                })
            }
        });
    });

    document.getElementById('closeDetailBtn').addEventListener('click', function() {

        document.getElementById('detailView').style.display = 'none';

        if (currentExpandedCard !== null) {
            currentExpandedCard.style.display = 'block';
            currentExpandedCard = null;
        }
    });

</script>
