                     data-Intro="@hotel.Intro">

                    <img src="@hotel.ImageUrl" class="card-img-top rounded-0 branch-img-trigger" alt="館別圖片">
                    <div class="card-body px-0">
                        <h5 class="card-title text-primary fw-bold branch-title"> @hotel.Name </h5>
                        <p class="card-text text-muted small mb-1 branch-address"> @hotel.Address </p>
                        <p class="card-text text-muted small branch-phone"> @hotel.Phone </p>
                    </div>
                </div>
            </div>
        }
