@model HotelManagementSystem.Models.BookingSearchModel.BookingData
@{
	ViewData["Title"] = "訂單查詢";

	string BookingStatus(string s)
	{
		string r = "";
		if (s == "已完成") r = "bg-success-subtle text-success";
		else if (s == "入住中") r = "bg-primary-subtle text-primary";
		else if (s == "已付款") r = "bg-info-subtle text-info";
		else if (s == "已取消") r = "bg-danger-subtle text-danger";
		else r = "bg-secondary-subtle text-secondary";
		return r;
	}
}
@* <h1>查詢訂單頁</h1> *@

<div class="container py-4">

	<h1 class="h3 fw-bold mb-2">查詢我的訂單</h1>

	<p class="text-secondary mb-4">請輸入訂單編號與訂房時填寫的聯絡電話。</p>


	<!-- 搜尋區塊 -->
	<div class="card">

		<div class="card-body">

			<form asp-action="Lookup" asp-controller="Booking" method="get">
				<!-- 第一列：label+輸入框 & 按鈕 -->
				<div class="row g-3 align-items-end">

					<div class="col-12 col-lg-5">
						<label asp-for="BookingNum" class="form-label">訂單編號<span class="text-danger">*</span></label>
						<small class="text-secondary fw-normal ms-1">請輸入完整訂單編號（英文字母區分大小寫）。</small>

						<!-- 改用 asp-for，它會自動生成 id="OrderNo" name="OrderNo" value="..." -->
						<input asp-for="BookingNum" class="form-control" id="orderNo" placeholder="例如：BK20260810018" />
					</div>

					<div class="col-12 col-lg-5">
						<label asp-for="Phone" class="form-label">聯絡電話<span class="text-danger">*</span></label>

						<!-- 改用 asp-for -->
						<input asp-for="Phone" class="form-control" id="phone" placeholder="例如：0912345678" />
					</div>

					<div class="col-12 col-lg-2 d-grid">
						<!-- 這裡維持 type="submit" 讓按鈕可以直接觸發表單送出 -->
						<button type="submit" class="btn btn-primary" id="btnSearch">查詢</button>
					</div>

				</div>

				<!-- 第二列：錯誤訊息顯示區 -->
				<div class="row">
					<div class="col-12 col-lg-5">
						<span id="orderError" class="text-danger small"></span>
					</div>

					<div class="col-12 col-lg-5">
						<span id="phoneError" class="text-danger small"></span>
					</div>

					<div class="col-lg-2"></div>
				</div>
			</form>

		</div>

	</div>
	<!-- end 搜尋區塊 -->
	<!-- "查無資料"顯示區 -->
	@if(ViewBag.NoResult == true)
	{
	<div id="noResult" class="alert alert-warning mt-4">
			查無符合的訂單資料，請確認訂單編號與聯絡電話是否正確！
		</div>		
	}


	<!-- 查詢結果顯示區 -->
	@if(!string.IsNullOrEmpty(Model?.BookingNum) && ViewBag.NoResult != true)
	{
		<div class="card mt-4" id="orderResult">



			<div class="card-header d-flex justify-content-between align-items-center">
				<!-- 訂單編號 -->
				<span class="fw-semibold" id="resultOrderNo">訂單 @Model.BookingNum</span>
				<!-- 訂單狀態 -->
				<span class="badge @BookingStatus(Model.BookingStatus)" id="resultStatus">@Model.BookingStatus</span>
			</div>

			<div class="card-body">

				<div class="row gy-3">
					<div class="col-12">
						<div class="row border-bottom pb-2">
							<div class="col-md-4 text-secondary">分館／房型</div>
							<!-- 顯示 預訂分館．房型 區塊 -->
							<div class="col-md-8 fw-semibold text-md-end" id="resultRoom">@Model.BranchName ・ @Model.Roomtype</div>
						</div>
					</div>
					<div class="col-12">
						<div class="row border-bottom pb-2">
							<div class="col-md-4 text-secondary">入住／退房</div>
							<!-- 顯示 入住日期 ~ 退房日期 區塊 -->
							<div class="col-md-8 fw-semibold text-md-end" id="resultDate">@Model.StartDate. ・ @Model.EndDate</div>
						</div>
					</div>
					<div class="col-12">
						<div class="row border-bottom pb-2">
							<div class="col-md-4 text-secondary">訂房人</div>
							<!-- 顯示 訂房人姓名 區塊 -->
							<div class="col-md-8 fw-semibold text-md-end" id="resultCustomer">@Model.Name</div>
						</div>
					</div>
					<div class="col-12">
						<div class="row border-bottom pb-2">
							<div class="col-md-4 text-secondary">電話</div>
							<!-- 顯示 訂房人姓名 區塊 -->
							<div class="col-md-8 fw-semibold text-md-end" id="resultPhone">@Model.Phone</div>
						</div>
					</div>
					<div class="col-12">
						<div class="row">
							<div class="col-md-4 text-secondary">總金額</div>
							<!-- 顯示 房價總額 區塊 -->
							<div class="col-md-8 fw-bold text-md-end" id="resultTotal">NT$ @Model.Price</div>
						</div>
					</div>

				</div>

			</div>


			<div class="card-footer bg-white">
				<div class="d-flex justify-content-end">
					<a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">返回</a>
				</div>
			</div>

		</div>
	}
	
	<!-- end 查詢結果顯示區 -->


</div>




@section Scripts {

	<script>
	

		const orderNoPattern = /^[A-Za-z0-9]+$/;  // 訂單編號格式驗證（僅允許英數字）
		const phonePattern = /^[0-9\-\s]+$/;  // 聯絡電話格式驗證（允許數字、-、空格）



		// 訂單編號輸入框驗證
		function validateOrderNo() {
			const orderNo = document.getElementById("orderNo");
			const orderError = document.getElementById("orderError");

			// 取得輸入值，移除前後空白
			const value = orderNo.value.trim();

			// 驗證是否為空值
			if (value === "") {
				orderNo.classList.add("is-invalid");
				orderError.textContent = "請輸入訂單編號。";
				orderError.classList.add("show");
				return false;
			}

			// 驗證是否符合訂單編號格式
			if (!orderNoPattern.test(value)) {
				orderNo.classList.add("is-invalid");
				orderError.textContent = "輸入的訂單編號格式不正確。";
				orderError.classList.add("show");
				return false;
			}

			// 輸入框驗證通過
			orderNo.classList.remove("is-invalid");  // 移除錯誤樣式
			orderError.classList.remove("show");  // 隱藏錯誤訊息

			return true;
		}



		// 聯絡電話輸入框驗證
		function validatePhone() {
			const phone = document.getElementById("phone");
			const phoneError = document.getElementById("phoneError");

			// 取得輸入值，移除前後空白
			const value = phone.value.trim();

			// 驗證是否為空值
			if (value === "") {
				phone.classList.add("is-invalid");
				phoneError.textContent = "請輸入聯絡電話。";
				phoneError.classList.add("show");
				return false;
			}

			// 驗證是否符合聯絡電話格式
			if (!phonePattern.test(value)) {
				phone.classList.add("is-invalid");
				phoneError.textContent = "聯絡電話只能包含數字及電話符號。";
				phoneError.classList.add("show");
				return false;
			}

			// 輸入框驗證通過
			phone.classList.remove("is-invalid");  // 移除錯誤樣式
			phoneError.classList.remove("show");  // 隱藏錯誤訊息

			// 回傳驗證成功
			return true;
		}


		// 查詢按鈕點擊事件
		document.getElementById("btnSearch").addEventListener("click", function(e) {

			let isValid = true;

			// 訂單編號輸入框驗證失敗
			if (!validateOrderNo()) {
				isValid = false;
			}

			// 聯絡電話輸入框驗證失敗
			if (!validatePhone()) {
				isValid = false;
			}

			// 如果任一個欄位驗證失敗
			if (!isValid) {
				e.preventDefault(); // 防止表單送出後重新整理頁面
				return;
			}

		});


		// 訂單編號輸入時即時驗證
		document.getElementById("orderNo").addEventListener("input", function() {
			validateOrderNo();
		});

		// 聯絡電話輸入時即時驗證
		document.getElementById("phone").addEventListener("input", function() {
			validatePhone();
		});

	</script>

}