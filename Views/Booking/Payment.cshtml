@*
	飯店管理系統 - 模擬付款頁面原型
	已完全修正所有標籤閉合與跑版問題，內嵌姓名防呆與卡號自動空格功能
*@

@{
    ViewData["Title"] = "付款";
}

@model HotelManagementSystem.Models.ViewModels.Booking.PaymentViewModel


<div class="container py-4">

	<!-- 返回房型選擇頁 (後續記得處理返回後資料傳遞等部分) -->
	<a asp-controller="Booking"
	   asp-action="RoomSelection"
	   asp-route-branchId="@Model.BranchId"
	   asp-route-checkIn="@Model.CheckInDate.ToString("yyyy-MM-dd")"
	   asp-route-checkOut="@Model.CheckOutDate.ToString("yyyy-MM-dd")"
	   asp-route-guestCount="@Model.GuestCount"
	   class="btn btn-link px-0 text-decoration-none mb-2">
		← 重新選擇房型
	</a>



	<!-- 三、頁面標題與副標題 -->
	<h1 class="h3 fw-bold mb-2">填寫訂房人資料與付款資訊</h1>

	<!-- 新增流程提醒 -->
	<p class="text-secondary ms-3 mb-4">
		*付款成功後，訂房才算完成。<br />
		本系統使用模擬付款流程，不會實際扣款。
	</p>


	@if (TempData["PaymentError"] != null)
	{
		<div class="alert alert-danger mb-4" role="alert">
			@TempData["PaymentError"]
		</div>
	}


	<!-- 表單開始：使用 ASP.NET Core 標準 Tag Helper 確保標籤完美解析 -->
	<form id="paymentForm" asp-controller="Booking" asp-action="Success" method="post" class="needs-validation" novalidate>
		
		<!-- 透過表單將資料送到下一頁 (Success) -->
		<input type="hidden" name="BranchId" value="@Model.BranchId" />
		<input type="hidden" name="CheckInDate" value="@Model.CheckInDate.ToString("yyyy-MM-dd")" />
		<input type="hidden" name="CheckOutDate" value="@Model.CheckOutDate.ToString("yyyy-MM-dd")" />
		<input type="hidden" name="RoomTypeId" value="@Model.RoomTypeId" />
		<input type="hidden" name="GuestCount" value="@Model.GuestCount" />
		<!-- 使用者進入付款頁時看到的每晚房價 -->
		<input type="hidden" name="ConfirmedNightlyPrice" value="@Model.NightlyPrice" />

		<!-- 二、版面欄位使用 Bootstrap Grid (桌面版並排，窄畫面自動上下排列) -->
		<div class="row g-4 align-items-start">

			<!-- 左側-->
			<div class="col-12 col-lg-8">

				<!-- 訂房人資料 -->
				<div class="card mb-4">
					<div class="card-header fw-semibold">
						訂房人資料
					</div>
					<div class="card-body">
						<!-- 姓名欄位：限制不可有數字、限50字、即時過濾、獨立紅字 -->
						<div class="mb-3">
							<label class="form-label">
								姓名 <span class="text-danger">*</span>
							</label>
							<input class="form-control" type="text" id="txtName" name="BookerName" value="@TempData["BookerName"]" required placeholder="例如：王小明"
								   pattern="[^\d]*" maxlength="50"
								   oninput="this.value = this.value.replace(/\d/g, '')"
								   data-error-target="#nameError">
							<div id="nameError" class="text-danger small mt-1 d-none">請輸入姓名，且不可包含數字或超過 50 個字。</div>
						</div>
						<!-- 聯絡電話欄位 -->
						<div class="mb-3">
							<label class="form-label">
								聯絡電話 <span class="text-danger">*</span>
							</label>
							<input class="form-control" type="tel" id="txtPhone" name="ContactPhone" value="@TempData["ContactPhone"]" required placeholder="例如：0912345678" data-error-target="#phoneError">
							<div id="phoneError" class="text-danger small mt-1 d-none">請輸入正確的聯絡電話格式。</div>
						</div>
						<!-- 電子信箱欄位 -->
						<div class="mb-3">
							<label class="form-label">
								電子信箱 <span class="text-danger">*</span>
							</label>
							<input class="form-control" type="email" id="txtEmail" name="Email" value="@TempData["Email"]" required placeholder="例如：name@example.com" data-error-target="#emailError">
							<div id="emailError" class="text-danger small mt-1 d-none">請輸入正確的電子信箱格式。</div>
						</div>
					</div>
				</div>

				<!-- 付款資訊 -->
				<div class="card">
					<div>
						<div class="card-header fw-semibold">
							付款資訊
						</div>

						<div class="card-body">							

							<!-- 卡號欄位：前置圖示、自動4碼補空格、獨立紅字 -->
							<div class="mb-3">
								<label class="form-label">
									卡號 <span class="text-danger">*</span>
								</label>
								<div class="input-group">
									<span class="input-group-text bg-white text-muted">
										<svg xmlns="http://w3.org" width="16" height="16" fill="currentColor" class="bi bi-credit-card-2-back" viewBox="0 0 16 16">
											<path d="M11 5.5a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1-.5-.5zm-2 0a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5z" />
											<path d="M2 2a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2zm13 2v1.5H1V4a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1M1 7.5h14V12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1z" />
										</svg>
									</span>
									<input class="form-control" type="text" id="txtCardNumber" name="CardNumber" required placeholder="4242 4242 4242 4242" maxlength="19" data-error-target="#cardError">
								</div>
								<div id="cardError" class="text-danger small mt-1 d-none">此卡號無效。</div>
							</div>

							<!-- 到期日與安全碼並排 -->
							<div class="row">
								<!-- 到期日 -->
								<div class="col-6 mb-3">
									<label class="form-label">
										到期日 <span class="text-danger">*</span>
									</label>
									<input class="form-control text-center"
										   type="text"
										   id="txtExpiry"
										   name="Expiry"
										   required
										   placeholder="MM/YY"
										   maxlength="5"
										   data-error-target="#expiryError">
									<div id="expiryError" class="text-danger small mt-1 d-none">到期日無效。</div>
								</div>
								<!-- CVC 安全碼 -->
								<div class="col-6 mb-3">
									<label class="form-label">
										CVC 安全碼 <span class="text-danger">*</span>
									</label>
									<input class="form-control text-center" type="password" id="txtCvc" name="Cvc" required placeholder="336" maxlength="3" data-error-target="#cvcError">
									<div id="cvcError" class="text-danger small mt-1 d-none">請輸入安全碼。</div>
								</div>
							</div>

							<!-- 應付金額 -->
							<div class="d-flex justify-content-between align-items-center mt-4 pt-4 pb-3 border-top">
								<span class="text-secondary fw-semibold">
									應付金額
								</span>

								<span class="h4 fw-bold mb-0">
									NT$ @Model.TotalPrice.ToString("#,##0.##", System.Globalization.CultureInfo.GetCultureInfo("zh-TW"))
								</span>
							</div>

							<!-- 主要操作按鈕 -->
							<button type="submit" id="btnSubmitPayment" class="btn btn-primary w-100 py-2 fw-semibold">
								確認付款並送出訂房
							</button>
							
							<!-- 隱藏提示 -->
							<p id="paymentProcessingMessage" class="d-none mt-3 mb-0 text-secondary small" role="status" aria-live="polite">
								請稍候，完成前請勿重新整理或關閉此頁面。
							</p>

						</div>
					</div>

					
				</div>
			</div>			


			<!-- 右側 -->
			<div class="col-12 col-lg-4">
				
				<!-- 訂房確認區塊 -->
				<div class="card">

					<div class="card-header fw-semibold">
						訂房資訊
					</div>

					<div class="card-body">
						<!-- 分館 -->
						<div class="row py-2">
							<div class="col-4 col-md-3 text-secondary">
								分館
							</div>
							<div id="branchName" class="col-8 col-md-9 fw-semibold text-end">
								@Model.BranchName
							</div>
						</div>

						<!-- 房型 -->
						<div class="row py-2">
							<div class="col-4 col-md-3 text-secondary">
								房型
							</div>
							<div id="roomTypeName" class="col-8 col-md-9 fw-semibold text-end">
								@Model.RoomTypeName
							</div>
						</div>

						<!-- 每晚房價 -->
						<div class="row py-2">
							<div class="col-4 col-md-3 text-secondary">
								每晚房價
							</div>
							<div id="pricePerNight" class="col-8 col-md-9 fw-semibold text-end">
								NT$ @Model.NightlyPrice.ToString("#,##0.##", System.Globalization.CultureInfo.GetCultureInfo("zh-TW"))
							</div>
						</div>
						
						<!-- 入住日期 -->
						<div class="row py-2">
							<div class="col-4 col-md-3 text-secondary">
								入住日期
							</div>
							<div id="checkInDate" class="col-8 col-md-9 fw-semibold text-end">
								@Model.CheckInDate.ToString("yyyy/MM/dd")
							</div>
						</div>
						
						<!-- 退房日期 -->
						<div class="row py-2">
							<div class="col-4 col-md-3 text-secondary">
								退房日期
							</div>
							<div id="checkOutDate" class="col-8 col-md-9 fw-semibold text-end">
								@Model.CheckOutDate.ToString("yyyy/MM/dd")
							</div>
						</div>
						
						<!-- 入住晚數 -->
						<div class="row py-2">
							<div class="col-4 col-md-3 text-secondary">
								入住晚數
							</div>
							<div id="nights" class="col-8 col-md-9 fw-semibold text-end">
								@Model.Nights 晚
							</div>
						</div>
						<hr class="my-1">
						
						<!-- 總金額 -->
						<div class="row pt-3">
							<div class="col-4 col-md-3 fw-semibold">
								總金額
							</div>
							<div id="totalAmount" class="col-8 col-md-9 h4 fw-bold mb-0 text-end">
								NT$ @Model.TotalPrice.ToString("#,##0.##", System.Globalization.CultureInfo.GetCultureInfo("zh-TW"))
							</div>
						</div>

					</div>

				</div>

			</div>

		</div>
	</form>
</div>



<script>
	

	(function() {
		'use strict'
		var form = document.getElementById('paymentForm')
		var cardNumberInput = document.getElementById('txtCardNumber')
		var expiryInput = document.getElementById('txtExpiry')

		// 聯絡電話驗證：只允許數字、空白與 -
		function isValidPhone(phone) {
			if (!/^[0-9\s-]+$/.test(phone)) {
				return false;
			}
			var normalizedPhone = phone
				.replace(/\s/g, '')
				.replace(/-/g, '');
			return /^\d+$/.test(normalizedPhone);
		}

		// 1. 信用卡卡號：連續輸入數字時自動 4 碼加空格格式化
		if (cardNumberInput) {
			cardNumberInput.addEventListener('input', function(e) {
				var cursorPosition = e.target.selectionStart;
				var originalLength = e.target.value.length;
				var digitsOnly = e.target.value.replace(/\D/g, '');
				var formattedValue = digitsOnly.replace(/(\d{4})(?=\d)/g, '$1 ');

				e.target.value = formattedValue;

				var newLength = formattedValue.length;
				cursorPosition = cursorPosition + (newLength - originalLength);
				e.target.setSelectionRange(cursorPosition, cursorPosition);
			});
		}

		// 2. 到期日：自動補斜線格式化 (MM/YY)
		if (expiryInput) {
			expiryInput.addEventListener('input', function(e) {
				var value = e.target.value.replace(/\D/g, '');
				if (value.length > 2) {
					e.target.value = value.substring(0, 2) + '/' + value.substring(2, 4);
				} else {
					e.target.value = value;
				}
			});
		}


		// 信用卡卡號 Luhn 檢查
		function isValidCardNumber(cardNumber) {
			var digits = cardNumber.replace(/\D/g, '');

			// 一般信用卡卡號至少 13 碼、最多 19 碼
			if (digits.length < 13 || digits.length > 19) {
				return false;
			}
			var sum = 0;
			var shouldDouble = false;
			for (var i = digits.length - 1; i >= 0; i--) {
				var digit = parseInt(digits.charAt(i), 10);
				if (shouldDouble) {
					digit *= 2;
					if (digit > 9) {
						digit -= 9;
					}
				}
				sum += digit;
				shouldDouble = !shouldDouble;
			}
			return sum % 10 === 0;
		}

		// 信用卡到期日驗證
		function isValidExpiry(expiry) {
			// 必須符合 MM/YY
			var match = expiry.match(/^(\d{2})\/(\d{2})$/);
			if (!match) {
				return false;
			}

			var month = parseInt(match[1], 10);
			var year = parseInt(match[2], 10);
			// 月份必須為 01～12
			if (month < 1 || month > 12) {
				return false;
			}
			// 取得目前年月
			var now = new Date();
			var currentMonth = now.getMonth() + 1;
			var currentYear = now.getFullYear() % 100;
			// 到期年份早於今年 → 已過期
			if (year < currentYear) {
				return false;
			}
			// 同一年但月份已過 → 已過期
			if (year === currentYear && month < currentMonth) {
				return false;
			}
			return true;
		}


		// 3. 整合表單提交與獨立錯誤文字控制
		form.addEventListener('submit', function(event) {
			event.preventDefault(); // 攔截預設送出以便展示原型錯誤

			var isValid = true;
			var inputs = form.querySelectorAll('input[required]');

			inputs.forEach(function(input) {
				var targetSelector = input.getAttribute('data-error-target');
				var errorDiv = targetSelector ? document.querySelector(targetSelector) : null;

				// HTML 原生驗證
				var isInputValid = input.checkValidity();
				
				// 聯絡電話格式驗證
				if (input.id === 'txtPhone') {
					if (!isValidPhone(input.value)) {
						isInputValid = false;
					}
				}
				// 信用卡卡號驗證
				if (input.id === 'txtCardNumber') {
					var cardNumber = input.value.replace(/\D/g, '');
					// 卡號必須為 13～19 碼，並通過 Luhn 檢查
					if (!isValidCardNumber(cardNumber)) {
						isInputValid = false;
					}
				}
				// 信用卡到期日驗證
				if (input.id === 'txtExpiry') {
					// 到期日必須符合 MM/YY、月份有效且尚未過期
					if (!isValidExpiry(input.value)) {
						isInputValid = false;
					}
				}

				if (!isInputValid) {
					isValid = false;
					input.classList.add('is-invalid');
					input.classList.remove('is-valid');
					if (errorDiv) errorDiv.classList.remove('d-none');
				} else {
					input.classList.remove('is-invalid');
					input.classList.add('is-valid');
					if (errorDiv) errorDiv.classList.add('d-none');
				}
			});

			// 驗證全過才送出表單
			var submitButton = document.getElementById('btnSubmitPayment');
			var processingMessage = document.getElementById('paymentProcessingMessage');

			if (isValid) {
				submitButton.disabled = true;
				submitButton.textContent = '處理中...';

				processingMessage.classList.remove('d-none');

				form.submit();
			}

		}, false)
	})()
</script>

