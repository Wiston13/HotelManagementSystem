@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model HotelManagementSystem.Models.RoomSelectionViewModel
@{
    ViewData["Title"] = "房型結果及訂房確認";
}


<div class="container my-4">

    <!-- 返回首頁 (後續記得處理返回後資料傳遞等部分) -->
    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-link px-0 text-decoration-none mb-2">
        ← 修改查詢條件
    </a>



    <!-- 上方標題與查詢條件摘要 --> 
    <h1 class="fw-bold">@Model.BranchName | 可售房型</h1>

    
    <!-- 假資料（靜態頁面展示用） -->
    <p class="text-secondary small mb-4">
        2026/08/14－2026/08/15
    </p>



    @* <p class="text-muted">
        @Model.CheckInDate.ToString("yyyy/MM/dd") － @Model.CheckOutDate.ToString("yyyy/MM/dd") ・ @Model.Guests 位入住
    </p> *@

    <div class="row mt-4">
        <!-- ================= 左側：房型列表區 ================= -->
        <div class="col-lg-8 mb-4">
            @if (Model.RoomList != null && Model.RoomList.Any())
            {
                foreach (var room in Model.RoomList)
                {
                    <div class="card mb-3 shadow-sm border-0">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center">
                                @* <div class="bg-light text-center border rounded p-3 me-3 d-flex align-items-center justify-content-center" style="width: 110px; height: 80px;">
                                    <small class="text-muted">房型照片</small>
                                </div> *@


                                @* 假資料（靜態頁面展示用） *@
                                <img src="https://images.unsplash.com/photo-1631049307264-da0ec9d70304?q=80&w=1470&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
                                     alt="@room.RoomName"
                                     class="rounded me-3"
                                     style="width: 110px; height: 80px; object-fit: cover;">


                                <div>
                                    <h5 class="card-title fw-bold mb-1">@room.RoomName</h5>
                                    <p class="card-text text-muted mb-0">
                                        @room.Description
                                        @if (room.Stock > 0)
                                        {
                                            <span class="text-secondary ms-2">・ 剩餘 @room.Stock 間</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger ms-2">・ 無庫存</span>
                                        }
                                    </p>
                                </div>
                            </div>

                            <div class="text-end">
                                <h4 class="text-primary fw-bold mb-2">NT$ @room.Price.ToString("N0")<small class="fs-6 fw-normal">／晚</small>
                                </h4>
                                @if (room.Stock > 0)
                                {
                                    <button type="button" class="btn btn-outline-primary px-4"
                                            onclick="selectRoom(@room.RoomTypeId, '@room.RoomName', @room.Price)">
                                        選擇
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-secondary px-4" disabled>已售完</button>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-warning p-4 text-center">
                    目前選擇的日期無剩餘庫存，請重新選擇其他日期或分館。
                </div>
            }
        </div>

        <!-- ================= 右側：訂房確認摘要卡片 ================= -->
        <div class="col-lg-4">
            <div class="card p-4 shadow-sm border-0 bg-light">
                

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="fw-bold mb-0">房型選擇</h4>

                    <span class="small text-secondary">
                        *選擇房型不代表房間已保留
                    </span>
                </div>


                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">分館</span>
                    @* <strong class="text-dark">@Model.BranchName</strong> *@

                    <!-- 假資料 -->
                    <strong class="text-dark">台北館</strong>


                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">房型</span>
                    <strong id="displayRoomName" class="text-primary">請選擇房型</strong>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">住宿</span>
                    <strong class="text-dark">@Model.Nights 晚</strong>
                </div>
                <div class="d-flex justify-content-between py-3">
                    <span class="text-muted h5 mb-0">總金額</span>
                    <h4 class="text-danger fw-bold mb-0" id="displayTotalPrice">NT$ 0</h4>
                </div>


                <!-- 送出表單至第三頁 (Payment) -->
                <form asp-controller="Booking" asp-action="Payment" method="post">
                    <input type="hidden" name="branchName" value="@Model.BranchName" />
                    <input type="hidden" name="checkIn" value="@Model.CheckInDate.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="checkOut" value="@Model.CheckOutDate.ToString("yyyy-MM-dd")" />
                    <input type="hidden" id="inputRoomTypeId" name="roomTypeId" value="" />
                    <input type="hidden" id="inputTotalPrice" name="totalPrice" value="0" />

                    <button type="submit" id="btnPay" class="btn btn-primary btn-lg w-100 mt-2" disabled>
                        前往付款
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function selectRoom(id, name, pricePerNight) {
            var nights = @Model.Nights;
            var total = pricePerNight * nights;

            document.getElementById('displayRoomName').innerText = name;
            document.getElementById('displayTotalPrice').innerText = 'NT$ ' + total.toLocaleString();

            document.getElementById('inputRoomTypeId').value = id;
            document.getElementById('inputTotalPrice').value = total;

            document.getElementById('btnPay').disabled = false;
        }
    </script>
}