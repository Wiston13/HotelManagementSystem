@model HotelManagementSystem.Models.ViewModels.Booking.RoomSelectionViewModel

<!-- 插件區 -->
@*flatpickr 用來調整日期選取版型的插件*@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/zh.js"></script>

@{
    ViewData["Title"] = "選擇房型";
}

@if (TempData["PriceChanged"] != null)
{
    <div class="alert alert-warning mb-4" role="alert">
        @TempData["PriceChanged"]
    </div>
}


<div class="container my-4">

    <!-- 上方標題與查詢條件摘要 --> 
    <div class="mb-3">
        <h1 class="h3 fw-bold mb-1">選擇房型</h1>
        <p class="text-secondary mb-0">
            可調整查詢條件，查看可售房型。
        </p>
    </div>

    <!-- 查詢條件篩選區 -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <!-- 分館 -->
                <div class="col-md-4">
                    <label for="filterBranch"
                           class="form-label small text-muted">
                        分館
                    </label>
                    <select id="filterBranch" class="form-select">
                        @foreach (var branch in Model.Branches)
                        {
                            if (branch.BranchId == Model.BranchId)
                            {
                                <option value="@branch.BranchId" selected>@branch.BranchName</option>
                            }
                            else
                            {
                                <option value="@branch.BranchId">@branch.BranchName</option>
                            }
                        }
                    </select>
                </div>
                <!-- 日期 -->
                <div class="col-md-5">
                    <label for="filterDateRange"
                           class="form-label small text-muted">
                        入住日期－退房日期
                    </label>
                    <input type="text"
                           id="filterDateRange"
                           class="form-control"
                           readonly />
                </div>
                <!-- 入住人數 -->
                <div class="col-md-3">
                    <label for="filterGuestCount"
                           class="form-label small text-muted">
                        入住人數
                    </label>
                    <select id="filterGuestCount"
                            class="form-select">
                        @foreach (var guest in Model.GuestOptions)
                        {
                            if (guest == Model.GuestCount)
                            {
                                <option value="@guest" selected>@guest 人</option>
                            }
                            else
                            {
                                <option value="@guest">@guest 人</option>
                            }
                        }
                    </select>
                </div>

            </div>
        </div>
    </div>


    <div class="row mt-4">
        <!-- ================= 左側：房型列表區 ================= -->
        <div class="col-lg-8 mb-4">

            @if (Model.RoomTypes != null && Model.RoomTypes.Any())
            {
                foreach (var room in Model.RoomTypes)
                {
                    <div class="card mb-3 shadow-sm border-0">
                        <div class="card-body d-flex justify-content-between align-items-center">

                            <div class="d-flex align-items-center">

                                @* 房型照片 *@
                                <img src="@room.ImageUrl"
                                     alt="@room.RoomTypeName"
                                     class="rounded me-3"
                                     style="width: 160px; height: 120px; object-fit: cover;">

                                <div>
                                    @* 房型名稱 *@
                                    <div class="d-flex align-items-baseline mb-1">
                                        <h5 class="card-title fw-bold mb-0">
                                            @room.RoomTypeName
                                        </h5>
                                    </div>

                                    @* 床型 *@
                                    <div class="text-secondary mb-2">
                                        @room.BedType
                                    </div>

                                    @* 最多入住人數 *@
                                    <div class="mb-2">
                                        <span class="badge bg-light text-secondary border fw-normal"
                                              style="font-size: 0.75rem;">
                                            最多 @room.MaxOccupancy 人
                                        </span>
                                    </div>

                                    @* 房型描述 *@
                                    <p class="card-text text-muted mb-0">
                                        @room.Description
                                    </p>
                                </div>

                            </div>

                            <div class="text-end align-self-end">

                                @* 價格 *@
                                <h4 class="customer-primary-text fw-bold mb-2">
                                    NT$ @room.NightlyPrice.ToString("#,##0.##", System.Globalization.CultureInfo.GetCultureInfo("zh-TW"))
                                    <small class="fs-6 fw-normal">／晚</small>
                                </h4>

                                @* 選擇按鈕 *@
                                <button type="button"
                                        class="btn px-4 btn-select-room"
                                        data-room-id="@room.RoomTypeId"
                                        data-room-name="@room.RoomTypeName"
                                        data-room-price="@room.NightlyPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                    選擇
                                </button>

                            </div>

                        </div>
                    </div>
                }
            }
            else
            {
                <div class="room-empty-state">

                    <h2 class="h5 fw-semibold mb-2">
                        目前沒有符合條件的可售房型
                    </h2>

                    <p class="text-secondary mb-0">
                        請調整分館、入住日期或入住人數後重新查看。
                    </p>

                </div>
            }
            
        </div>

        <!-- ================= 右側：訂房確認摘要卡片 ================= -->
        <div class="col-lg-4">
            <div class="card p-4 shadow-sm border-0 bg-light">                

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="fw-bold mb-0">房型選擇</h4>

                    <span class="small text-secondary">
                        *選擇房型不代表房間已保留
                    </span>
                </div>

                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">分館</span>
                    <strong class="text-dark">@Model.BranchName</strong>
                </div>

                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">房型</span>
                    <strong id="displayRoomName" class="customer-selection-text">請選擇房型</strong>
                </div>

                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">住宿</span>
                    <strong class="text-dark">@Model.Nights 晚</strong>
                </div>

                <div class="d-flex justify-content-between py-3">
                    <span class="text-muted h5 mb-0">總金額</span>
                    <h4 class="text-danger fw-bold mb-0" id="displayTotalPrice">NT$ 0</h4>
                </div>


                <!-- 送出表單至第三頁 (Payment) -->
                <form asp-controller="Booking" asp-action="Payment" method="post">
                    <input type="hidden" name="branchId" value="@Model.BranchId" />
                    <input type="hidden" name="checkIn" value="@Model.CheckInDate.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="checkOut" value="@Model.CheckOutDate.ToString("yyyy-MM-dd")" />
                    <input type="hidden" id="inputRoomTypeId" name="roomTypeId" value="" />
                    <input type="hidden" name="guestCount" value="@Model.GuestCount" />
                    <button type="submit" id="btnPay" class="btn btn-primary btn-lg w-100 mt-2" disabled>
                        前往付款
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ===============================
        // 房型選擇頁：查詢條件
        // ===============================
        const filterBranch = document.getElementById("filterBranch");
        const filterDateRange = document.getElementById("filterDateRange");
        const filterGuestCount = document.getElementById("filterGuestCount");
        // 目前查詢中的日期
        const currentCheckIn = "@Model.CheckInDate.ToString("yyyy-MM-dd")";
        const currentCheckOut = "@Model.CheckOutDate.ToString("yyyy-MM-dd")";
        // 今天日期與最晚可訂日
        let todayDate = "@Model.Today.ToString("yyyy-MM-dd")";
        let maxRangeDate = new Date(todayDate);
        maxRangeDate.setDate(maxRangeDate.getDate() + 60);
        // ===============================
        // 日期選擇器
        // ===============================
        flatpickr("#filterDateRange", {
            mode: "range",
            minDate: todayDate,
            maxDate: maxRangeDate,
            dateFormat: "Y-m-d",
            altInput: true,
            altFormat: "Y.m.d",
            showMonths: 2,
            // 進入頁面時，顯示目前的查詢日期
            defaultDate: [
                currentCheckIn,
                currentCheckOut
            ],
            // 與首頁使用相同中文設定
            locale: {
                weekdays: {
                    shorthand: ["日", "一", "二", "三", "四", "五", "六"],
                    longhand: ["星期日", "星期一", "星期二", "星期三", "星期四", "星期五", "星期六"]
                },
                months: {
                    shorthand: [
                        "1月", "2月", "3月", "4月",
                        "5月", "6月", "7月", "8月",
                        "9月", "10月", "11月", "12月"
                    ],
                    longhand: [
                        "1月", "2月", "3月", "4月",
                        "5月", "6月", "7月", "8月",
                        "9月", "10月", "11月", "12月"
                    ]
                },
                rangeSeparator: " - "
            },
            onClose: function(selectedDates, dateStr, instance) {
                // 沒有完整選到兩個日期就不重新查詢
                if (selectedDates.length !== 2) {
                    return;
                }
                let checkIn = selectedDates[0];
                let checkOut = selectedDates[1];
                // 如果入住日與退房日相同，退房日自動加一天
                if (checkIn.getTime() === checkOut.getTime()) {
                    let nextDay = new Date(checkIn);
                    nextDay.setDate(nextDay.getDate() + 1);
                    // 避免退房日超過最晚可訂日
                    if (nextDay > maxRangeDate) {
                        return;
                    }
                    checkOut = nextDay;
                    instance.setDate(
                        [checkIn, checkOut],
                        false
                    );
                }
                // 日期選完後重新查詢
                reloadRoomSelection(checkIn, checkOut);
            }
        });
        // ===============================
        // 分館改變 → 重新查詢
        // ===============================
        filterBranch.addEventListener("change", function() {
            reloadRoomSelection();
        });
        // ===============================
        // 入住人數改變 → 重新查詢
        // ===============================
        filterGuestCount.addEventListener("change", function() {
            reloadRoomSelection();
        });
        // ===============================
        // 重新查詢 RoomSelection
        // ===============================
        function reloadRoomSelection(newCheckIn, newCheckOut) {
            let branchId = filterBranch.value;
            let guestCount = filterGuestCount.value;
            // 預設使用目前頁面的日期
            let checkIn = currentCheckIn;
            let checkOut = currentCheckOut;
            // 如果是使用者重新選日期，就改用新的日期
            if (newCheckIn && newCheckOut) {
                checkIn = formatDate(newCheckIn);
                checkOut = formatDate(newCheckOut);
            }
            let targetUrl =
                `/Booking/RoomSelection` +
                `?branchId=${branchId}` +
                `&checkIn=${checkIn}` +
                `&checkOut=${checkOut}` +
                `&guestCount=${guestCount}`;
            window.location.href = targetUrl;
        }
        // ===============================
        // Date → yyyy-MM-dd
        // ===============================
        function formatDate(date) {
            let year = date.getFullYear();
            let month = String(date.getMonth() + 1).padStart(2, "0");
            let day = String(date.getDate()).padStart(2, "0");
            return `${year}-${month}-${day}`;
        }


        // 房型選擇
        document.querySelectorAll('.btn-select-room')
            .forEach(function(button) {

                button.addEventListener('click', function() {
                    // 先取消所有房型按鈕的已選擇狀態
                    document.querySelectorAll('.btn-select-room').forEach(function(btn) {
                        btn.classList.remove('selected');
                    });

                    // 將目前點擊的房型設為已選擇
                    this.classList.add('selected');

                    const roomId = this.dataset.roomId;
                    const roomName = this.dataset.roomName;
                    const roomPrice = Number(this.dataset.roomPrice);

                    // 計算總價
                    const nights = Number('@Model.Nights');
                    const total = roomPrice * nights;

                    // 更新畫面
                    document.getElementById('displayRoomName').textContent = roomName;
                    document.getElementById('displayTotalPrice').textContent =
                        'NT$ ' + total.toLocaleString('zh-TW', { maximumFractionDigits: 2 });

                    // 設定要送到 Payment 的 RoomTypeId
                    document.getElementById('inputRoomTypeId').value = roomId;

                    // 啟用前往付款按鈕
                    document.getElementById('btnPay').disabled = false;
                });
            });


        // Payment頁面 瀏覽器按上一頁 可以重新 GET RoomSelection
        window.addEventListener('pageshow', function(event) {
            var navigation = performance.getEntriesByType('navigation')[0];

            if (event.persisted || navigation?.type === 'back_forward') {
                window.location.reload();
            }
        });

    </script>
}
