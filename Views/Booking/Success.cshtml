@{
    ViewData["Title"] = "訂房成功";
}

@model HotelManagementSystem.Models.ViewModels.Booking.SuccessViewModel

<div class="booking-success card border-0 shadow-sm mx-auto my-4 my-md-5 p-4 p-md-5 text-center">

    <div class="success-icon mx-auto mb-3" aria-hidden="true">
    </div>

    <h2 class="h3 fw-bold mb-2">訂房成功</h2>

    <p class="success-description text-secondary mb-4">
        訂房已完成，請確認以下訂房資訊。
    </p>

    <div class="order-number rounded-3 fw-bold fs-5 py-3 px-2 mb-3">
        訂單編號：@Model.BookingNumber
    </div>
    
    <div class="booking-detail-row d-flex align-items-start justify-content-between gap-3 py-3 text-start">
        <p class="detail-label text-secondary mb-0">分館</p>
        @* class裡的branch得等待後續課程決定要不要拔 *@
        <p class="detail-value branch fw-semibold text-end mb-0">@Model.BranchName</p>
    </div>

    <div class="booking-detail-row d-flex align-items-start justify-content-between gap-3 py-3 text-start">
        <p class="detail-label text-secondary mb-0">房型</p>
        <p class="detail-value room-type fw-semibold text-end mb-0">@Model.RoomTypeName</p>
    </div>

    <div class="booking-detail-row d-flex align-items-start justify-content-between gap-3 py-3 text-start">
        <p class="detail-label text-secondary mb-0">入住期間</p>
        <p class="detail-value during-the-stay fw-semibold text-end mb-0">
            @Model.CheckInDate.ToString("yyyy/MM/dd") 至 @Model.CheckOutDate.ToString("yyyy/MM/dd")
        </p>
    </div>

    @if (Model.ConfirmationEmailSent == true)
    {
        <div class="booking-detail-row d-flex align-items-start justify-content-between gap-3 py-3 text-start">
            <p class="detail-label text-secondary mb-0">確認信</p>
            <p class="detail-value email fw-semibold text-success text-end mb-0">
                已寄送至您的電子信箱
            </p>
        </div>
    }
    else if (Model.ConfirmationEmailSent == false)
    {
        <div class="booking-detail-row d-flex align-items-start justify-content-between gap-3 py-3 text-start">
            <p class="detail-label text-secondary mb-0">確認信</p>
            <p class="detail-value email text-danger text-end mb-0">
                <span class="fw-semibold">確認信暫時未能寄出</span>
                <br />
                <span class="small text-secondary">
                    如需協助，請聯繫分館。
                </span>
            </p>
        </div>
    }

    <div class="mt-4 text-center">
        <p class="mb-2 text-secondary">
            請妥善保存<span class="fw-semibold text-dark">訂單編號</span>與<span class="fw-semibold text-dark">聯絡電話</span>，以便後續查詢訂單。
        </p>

        <p class="mb-2 text-secondary">
            您可點選下方「查看訂單」，或由「訂單查詢」查看完整訂單資訊。
        </p>

        <p class="mb-2 text-secondary">
            如有訂單或確認信相關問題，請聯繫
            <span class="fw-semibold text-dark">@Model.BranchName</span>
            （電話：
            <span class="fw-semibold text-dark">@Model.BranchPhone</span>）。
        </p>

        <p class="mb-0 text-secondary">
            如有取消訂單需求，請於入住前一天 23：59 前聯繫訂房分館辦理。
        </p>
    </div>

    <a asp-controller="Booking"
       asp-action="Lookup"
       asp-route-BookingNum="@Model.BookingNumber"
       class="order-check btn btn-primary btn-lg fw-semibold w-100 mt-4">
        查看訂單
    </a>

</div>

@section Styles {
    <style>
        .booking-success {
            width: calc(100% - 2rem);
            max-width: 720px;
            border-radius: 1rem;
        }

        .booking-success .success-icon {
            display: grid;
            width: 4rem;
            height: 4rem;
            place-items: center;
            color: #2f765e;
            background-color: #edf7f2;
            border: 3px solid currentColor;
            border-radius: 50%;
        }

        .booking-success .success-icon::before {
            content: "\2713";
            font-size: 2.25rem;
            font-weight: 700;
            line-height: 1;
        }

        .booking-success .order-number {
            color: #2874a6;
            background-color: #e7f1f8;
        }

        .booking-success .booking-detail-row {
            border-bottom: 1px solid var(--bs-border-color);
        }

        .booking-success .detail-label {
            flex: 0 0 6rem;
        }

        .booking-success .detail-value {
            min-width: 0;
            overflow-wrap: anywhere;
        }

        .booking-success .order-check {
            --bs-btn-bg: #2879ae;
            --bs-btn-border-color: #2879ae;
            --bs-btn-hover-bg: #226a98;
            --bs-btn-hover-border-color: #226a98;
        }

        @@media (max-width: 575.98px) {
            .booking-success {
                width: calc(100% - 1.5rem);
            }

            .booking-success .detail-label {
                flex-basis: 4.5rem;
            }
        }
    </style>    
}
