@{
    ViewData["Title"] = "取消訂單";

    Layout = "_BranchLayout";
}

<div class="container-fluid px-4">
    <!-- 頁面標題 -->
    <div class="mb-3">
        <h2 class="fw-bold fs-3 text-dark">取消訂單</h2>
    </div>

    <!-- 上方警告提示橫幅 (Alert) -->
    <div class="alert alert-warning border-0 shadow-sm mb-4 py-3 text-secondary" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2 text-warning"></i>
        取消後訂單狀態將改為「已取消」，相關住宿日不再占用可售房量。此操作完成後不可復原。
    </div>

    <!-- 內容雙欄區塊：使用 Bootstrap 網格與 Flexbox -->
    <div class="row g-4">

        <!-- 左側：訂單資料區塊 -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-dark mb-4 pb-2 border-bottom">訂單資料</h5>

                    <div class="mb-3 row">
                        <div class="col-4 text-secondary">訂單編號</div>
                        <div class="col-8 fw-semibold text-dark">BK20260810018</div>
                    </div>
                    <div class="mb-3 row">
                        <div class="col-4 text-secondary">顧客</div>
                        <div class="col-8 fw-semibold text-dark">王小明</div>
                    </div>
                    <div class="mb-3 row">
                        <div class="col-4 text-secondary">入住日期</div>
                        <div class="col-8 fw-semibold text-dark">2026/08/10</div>
                    </div>
                    <div class="mb-0 row">
                        <div class="col-4 text-secondary">房型</div>
                        <div class="col-8 fw-semibold text-dark">標準雙人房</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 右側：取消確認與原因區塊 -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="fw-bold text-dark mb-4 pb-2 border-bottom">取消確認</h5>

                        <form>
                            <!-- 取消原因 (支援下拉選單與自訂輸入，這裡先用一般 input 搭配 datalist 或下拉) -->
                            <div class="mb-3">
                                <label for="cancelReason" class="form-label text-secondary small fw-bold">取消原因</label>
                                <select class="form-select mb-2" id="cancelReasonSelect">
                                    <option value="" selected disabled>請選擇或自行輸入取消原因</option>
                                    <option value="顧客來電取消">顧客來電取消</option>
                                    <option value="顧客因素">顧客因素</option>
                                    <option value="飯店因素">飯店因素</option>
                                </select>
                                <input type="text" class="form-control" id="cancelReason" placeholder="或自行輸入取消原因...">
                            </div>

                            <div class="form-text text-muted small mb-4">
                                <i class="bi bi-info-circle me-1"></i> 系統記錄取消時間與操作員工
                            </div>
                        </form>
                    </div>

                    <!-- 底部按鈕區 (返回與確認取消) -->
                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-controller="BranchBooking" asp-action="BookingSearch" class="btn btn-outline-secondary px-4 fw-semibold">
                            返回
                        </a>
                        <button type="button" class="btn btn-danger px-4 fw-semibold">
                            確認取消
                        </button>
                    </div>

                </div>
            </div>
        </div>

    </div>
</div>


@section Scripts{
    <script>

    </script>
}