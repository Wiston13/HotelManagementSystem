@{
    ViewData["Title"] = "本館訂單查詢";
}
@model List<HotelManagementSystem.Models.BookingSearchModel.BookingData>

@{

    string BookingStatusStyle(string s)
    {
        string r = "";
        if (s == "已完成") r = "bg-success-subtle text-success";
        else if (s == "入住中") r = "bg-primary-subtle text-primary";
        else if (s == "已付款") r = "bg-info-subtle text-info";
        else if (s == "已取消") r = "bg-danger-subtle text-danger";
        else r = "bg-secondary-subtle text-secondary";
        return r;
    }

    if (ViewBag.VerifyError != null)
    {
        <script>
            alert("@Html.Raw(ViewBag.VerifyError)")
        window.location.href = '@Url.Action("Login", "Account")';
        </script>
    }
    if (TempData["BookingStatusError"] != null)
    {
        <script>
            alert("@Html.Raw(TempData["BookingStatusError"])")
        </script>
    }
}


<div class="container-fluid px-4">

    <!-- 搜尋篩選區塊 (帶有卡片外觀與陰影) -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <form method="get" class="row g-3 align-items-end" id="searchForm">

                <!-- 1. 關鍵字 (必填) -->
                <div class="col-md-4">
                    <label for="keyword" class="form-label small fw-bold text-secondary">
                        關鍵字 <span class="text-danger">*必填</span>
                    </label>
                    <input type="text"
                           class="form-control"
                           id="keyword"
                           name="keyword"
                           value="@ViewBag.Keyword"
                           placeholder="訂單編號／姓名／電話">
                </div>

                <!-- 2. 入住日期區間 (簡單 input，供後續套用日曆插件) -->
                <div class="col-md-3">
                    <label for="dateRange" class="form-label small fw-bold text-secondary">
                        入住日期區間 <span class="text-muted fw-normal">(選填)</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted">
                            <i class="bi bi-calendar3"></i>
                        </span>
                        <input type="text"
                               class="form-control"
                               id="dateTime"
                               name="dateRange"
                               value="@ViewBag.dateRange"
                               placeholder="請選擇日期區間">
                    </div>
                </div>

                <!-- 3. 訂單狀態 (預設全部狀態) -->
                <div class="col-md-3">
                    <label for="orderStatus" class="form-label small fw-bold text-secondary">
                        訂單狀態
                    </label>
                    <select class="form-select" id="orderStatus" name="bookingStatus">
                        <option value="" selected="@(string.IsNullOrEmpty(ViewBag.BookingStatus))">全部狀態</option>
                        <option value="已付款" selected="@(ViewBag.BookingStatus == "已付款")">已付款</option>
                        <option value="入住中" selected="@(ViewBag.BookingStatus == "入住中")">入住中</option>
                        <option value="已完成" selected="@(ViewBag.BookingStatus == "已完成")">已完成</option>
                        <option value="已取消" selected="@(ViewBag.BookingStatus == "已取消")">已取消</option>
                        <option value="逾期未入住" selected="@(ViewBag.BookingStatus == "逾期未入住")">逾期未入住</option>
                    </select>
                </div>
                <!-- 4. 查詢按鈕 -->
                <div class="col-md-2">
                    <button id="searchBtn" type="submit" class="btn btn-primary w-100 fw-semibold">
                        查詢
                    </button>
                </div>

            </form>
        </div>
    </div>

    

    <!-- 查詢結果列表區塊 -->
    <div class="@(Model != null && Model.Any() ? "" : "d-none")">
        <h5>查詢訂單數量：@Model.Count 筆</h5>
        </div>
    <div id="resultList" class="card border-0 shadow-sm @(Model != null && Model.Any() ? "" : "d-none")">

        <div class="card-body p-0">
            <div class="table-responsive" style="max-height: 580px; overflow-y: auto; background-color: #f8f9fa;">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small sticky-top">
                        <tr>
                            <th class="ps-4 py-3">訂單</th>
                            <th class="py-3">入住日期</th>
                            <th class="py-3">顧客</th>
                            <th class="py-3">房型</th>
                            <th class="py-3">電話</th>
                            <th class="py-3">狀態</th>
                            <th class="text-end pe-4 py-3">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- 動態生成訂單資料 -->
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-primary">@item.BookingNum</td>
                                <td>@item.StartDate.ToString("yyyy/MM/dd") - @item.EndDate.ToString("yyyy/MM/dd")</td>
                                <td>@item.Name</td>
                                <td>@item.Roomtype</td>
                                <td>@item.Phone.Insert(4, "-")</td>
                                <td><span class="badge @BookingStatusStyle(item.BookingStatus) px-2 py-1">@item.BookingStatus</span></td>
                                <td class="text-end pe-4">

                                    @* <button type="button" class="btn btn-sm btn-outline-secondary px-3 btn-detail" disabled></button> *@

                                    <button type="button" class="btn btn-sm btn-outline-primary px-3 btn-detail"
                                            data-bs-toggle="modal"
                                            data-bs-target="#bookingDetailModal"
                                            data-bookingnum="@item.BookingNum"
                                            data-name="@item.Name"
                                            data-roomtype="@item.Roomtype"
                                            data-createtime="@item.BookingDate"
                                            data-bookingstatus="@item.BookingStatus"
                                            data-startdate="@item.StartDate.ToString("yyyy/MM/dd")"
                                            data-enddate="@item.EndDate.ToString("yyyy/MM/dd")"
                                            data-phone="@item.Phone"
                                            data-price="@item.Price">
                                        查看
                                    </button>

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal 彈跳視窗 -->
<form asp-action="BookingCancel" asp-controller="BranchBooking" method="post" class="row g-3 align-items-end" id="cancelForm">
    <div class="modal fade" id="bookingDetailModal" tabindex="-1" aria-labelledby="bookingDetailModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow">

                <!-- Modal 標題 -->
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold text-dark" id="bookingDetailModalLabel">訂單詳細資訊</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <!-- Modal 內容 (對應附圖的排版) -->
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <span class="text-secondary small">訂單編號</span>
                            <p id="modalBookingNum" class="fw-bold fs-6 mb-0 text-primary">-</p>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-secondary small">訂房人</span>
                            <p id="modalName" class="fw-bold fs-6 mb-0">-</p>
                        </div>

                        <div class="col-sm-6">
                            <span class="text-secondary small">聯絡電話</span>
                            <p id="modalPhone" class="mb-0">-</p>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-secondary small">成立時間</span>
                            <p id="modalCreateTime" class="mb-0">-</p>
                        </div>

                        <div class="col-sm-6">
                            <span class="text-secondary small">房型</span>
                            <p id="modalRoomtype" class="mb-0">-</p>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-secondary small">住宿日期</span>
                            <p id="modalBookingDate" class="mb-0">-</p>
                        </div>

                        <div class="col-sm-6">
                            <span class="text-secondary small">成交價格</span>
                            <p id="modalPrice" class="fw-bold text-danger mb-0">-</p>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-secondary small">目前狀態</span>
                            <p id="modalStatus" class="mb-0">-</p>
                        </div>
                    </div>
                </div>

                <!-- 輸入取消原因區塊 -->
                <div id="cancelReasonSection" class="d-none mt-4 mx-1 p-3 bg-light border rounded">
                    <h6 class="fw-bold text-danger mb-3">請填寫取消原因</h6>
                    <div class="mb-3">
                        <label class="form-label">選擇取消原因<span class="text-danger">*必填</span></label>
                        <select class="form-select" id="cancelReasonSelect">
                            <option value="請選擇..." disabled selected>請選擇...</option>
                            <option value="顧客因素">顧客因素</option>
                            <option value="飯店因素">飯店因素</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">備註說明<span class="text-danger">*必填</span></label>
                        <textarea class="form-control" id="cancelMemo" rows="2" placeholder="請輸入詳細原因"></textarea>
                    </div>
                    <div class="d-flex justify-content-end">
                        <div id="overtimeWarn" class="text-danger mt-1 me-1 d-none">
                            已超過顧客因素取消期限。
                            顧客因素取消須於入住日前一日 23:59 前完成。
                        </div>
                        <div id="overInputWarnning" class="text-danger mt-1 me-1 d-none">
                            取消理由不能超過500個字。
                    </div>
                        <button type="button" id="confirmCancelBtn" class="btn btn-danger btn-sm d-none px-3">
                            確認取消訂單
                        </button>
                    </div>

                </div>

                
                <!-- Modal 底部按鈕 (包含取消訂單按鈕) -->
                <div class="modal-footer bg-light">
                    <button type="button" id="goToCancelBtn" class="btn btn-outline-danger btn-sm px-3">
                        <i class="bi bi-x-circle me-1"></i> 取消訂單
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm px-4" data-bs-dismiss="modal">關閉</button>
                </div>
            </div>
        </div>
    </div>

    <!-- 再次確認取消modal -->
    <input type="hidden" name="bookingNum" id="cancelBookingNum" value="" />

    <input type="hidden" name="keyword" value="@ViewBag.Keyword" />
    <input type="hidden" name="dateRange" value="@ViewBag.DateRange" />
    <input type="hidden" name="keyStatus" value="@ViewBag.BookingStatus" />

    <input type="hidden" name="cancelCause" value="" id="cancelCause" />
    <input type="hidden" name="cancelReason" value="" id="cancelReason" />

    <div class="modal fade" id="confirmActionModal" tabindex="-1" aria-labelledby="confirmActionModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-danger text-white py-2">
                    <h6 class="modal-title fw-bold" id="confirmActionModalLabel">系統提示</h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <p class="mb-0 fw-semibold">確定要執行取消此訂單嗎？<br><span class="text-muted small">此動作無法復原。</span></p>
                </div>
                <div class="modal-footer bg-light justify-content-center py-2">
                    <button type="submit" id="finalSubmitCancelBtn" class="btn btn-danger btn-sm px-3">確定取消</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">返回</button>
                </div>
            </div>
        </div>
    </div>
</form>







<style>
        .sticky-top {
            position: sticky;
            top: 0;
            z-index: 10;
        }
</style>


@section Scripts {
    @*插件*@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/zh.js"></script>

    <script>
            document.addEventListener("DOMContentLoaded", function() {
                const searchForm = document.getElementById("searchForm");
                const keyword = document.getElementById("keyword");

                const overtimeWarn = document.getElementById("overtimeWarn");

                const goToCancelBtn = document.getElementById('goToCancelBtn');
                const confirmCancelBtn = document.getElementById('confirmCancelBtn');
                const cancelReasonSection = document.getElementById('cancelReasonSection');
                const finalSubmitCancelBtn = document.getElementById('finalSubmitCancelBtn');
                const cancelBookingNum = document.getElementById('cancelBookingNum');
                const modalStatus = document.getElementById('modalStatus');
                const overInputWarnning = document.getElementById('overInputWarnning');

                const confirmActionModal = new bootstrap.Modal(document.getElementById('confirmActionModal'));

                const cancelReasonSelect = document.getElementById('cancelReasonSelect');
                const cancelMemo = document.getElementById('cancelMemo');
                //modal帶入資料
                const bookingDetailModal = document.getElementById("bookingDetailModal");

                let currentStartDate = null;
                // 表單開啟時
                bookingDetailModal.addEventListener("show.bs.modal", function(event) {
                    const button = event.relatedTarget;

                    const bookingNum = button.getAttribute('data-bookingnum');
                    const name = button.getAttribute('data-name');
                    const roomtype = button.getAttribute('data-roomtype');
                    const bookingStatus = button.getAttribute('data-bookingstatus');
                    const createTime = button.getAttribute('data-createtime');
                    const phone = button.getAttribute('data-phone');
                    const bookingDate = button.getAttribute('data-bookingdate');
                    const startDate = button.getAttribute('data-startdate');
                    const endDate = button.getAttribute('data-enddate');
                    const price = button.getAttribute('data-price');


                    currentStartDate = startDate;

                    document.getElementById('modalBookingNum').textContent = bookingNum;
                    document.getElementById('modalName').textContent = name;
                    document.getElementById('modalRoomtype').textContent = roomtype;
                    document.getElementById('modalStatus').textContent = bookingStatus;
                    document.getElementById('modalBookingDate').textContent = startDate + " - " + endDate;
                    document.getElementById('modalPhone').textContent = phone.slice(0, 4) + "-" + phone.slice(4);
                    document.getElementById('modalCreateTime').textContent = createTime;
                    document.getElementById('modalPrice').textContent = price;

                    
                    if (bookingStatus === "已付款") {
                        goToCancelBtn.classList.add("btn-outline-danger");
                        goToCancelBtn.classList.remove("btn-outline-secondary");
                        goToCancelBtn.disabled = false;
                    }
                    else {
                        goToCancelBtn.classList.add("btn-outline-secondary");
                        goToCancelBtn.classList.remove("btn-outline-danger");
                        goToCancelBtn.disabled = true;
                    }

                
                });
                // 表單關閉時
                bookingDetailModal.addEventListener('hidden.bs.modal', function() {
                    // 隱藏取消原因區塊
                    cancelReasonSection.classList.add('d-none');

                    // 恢復按鈕原本的顯示狀態
                    goToCancelBtn.classList.remove('d-none');
                    confirmCancelBtn.classList.add('d-none');

                    // 恢復警告字樣隱藏
                    overtimeWarn.classList.add("d-none");
                    confirmCancelBtn.disabled = false;

                    // 清空輸入框
                    cancelReasonSelect.value = "請選擇...";
                    cancelMemo.value = "";
                });
                // 驗證合法輸入
                searchForm.addEventListener("submit", function(e) {
                    if (keyword.value.trim() == "") {
                        e.preventDefault();
                        keyword.classList.add("is-invalid");
                    }
                })

                keyword.addEventListener("input", function() {
                    if (keyword.value.trim() != "") {
                        this.classList.remove("is-invalid");
                    }
                })

                goToCancelBtn.addEventListener("click", function() {
                    confirmCancelBtn.classList.remove("d-none");
                    cancelReasonSection.classList.remove("d-none");
                })

                cancelReasonSelect.addEventListener('change', function() {
                    cancelReasonSelect.classList.remove('is-invalid');

                    overtimeWarn.classList.add("d-none");
                    confirmCancelBtn.disabled = false;

                    if (cancelReasonSelect.value === "顧客因素") {
                        const checkInDate = new Date(currentStartDate);

                        const deadline = new Date(checkInDate);
                        deadline.setDate(deadline.getDate() - 1);
                        deadline.setHours(23, 59, 59, 999);

                        if (new Date() > deadline) {

                            overtimeWarn.classList.remove("d-none");
                            confirmCancelBtn.disabled = true;
                            return;
                        }
                    }
                })
                // 取消理由超過500字驗證
                cancelMemo.addEventListener('input', function() {
                if (cancelMemo.value.length > 500) {
                    cancelMemo.value = cancelMemo.value.slice(0, 500);
                    cancelMemo.classList.add('is-invalid');
                    overInputWarnning.classList.remove('d-none');
                }
                else{
                    cancelMemo.classList.remove('is-invalid');
                    overInputWarnning.classList.add('d-none');
                }
                })

                cancelMemo.addEventListener('click',function(){
                    cancelMemo.classList.remove('is-invalid');
                    overInputWarnning.classList.add('d-none');

                })

                confirmCancelBtn.addEventListener('click', function() {
                    let isValid = true;
                    
                    if (cancelMemo.value.trim() === "") {
                        cancelMemo.classList.add('is-invalid');
                        isValid = false;
                    }
                    if (cancelReasonSelect.value === "請選擇..." || cancelReasonSelect.value === "") {
                        cancelReasonSelect.classList.add('is-invalid');
                        isValid = false;
                    }
                    if (!isValid) {
                        return;
                    }

                    confirmActionModal.show();
                })

                finalSubmitCancelBtn.addEventListener('click', function() {
                    const cancelCause = cancelReasonSelect.value;
                    const cancelTime = new Date().toLocaleString();

                    //注入aspFrom的值
                    cancelBookingNum.value = modalBookingNum.textContent;
                    document.getElementById('cancelCause').value = cancelCause;
                    document.getElementById('cancelReason').value = cancelMemo.value;
                    // alert(cancelCause);

                    confirmActionModal.hide();
                    bootstrap.Modal.getInstance(document.getElementById('bookingDetailModal')).hide();
                })

                
            })

            


            // 日期顯示區
            let maxRangeDate = new Date();
            maxRangeDate.setDate(maxRangeDate.getDate() + 60);
            flatpickr("#dateTime", {
                mode: "range",
                maxDate: maxRangeDate,
                dateFormat: "Y-m-d",
                altInput: true,
                altFormat: "Y.m.d",
                showMonths: 1,
                locale: {
                    weekdays: {
                        shorthand: ["日", "一", "二", "三", "四", "五", "六"],
                        longhand: ["星期日", "星期一", "星期二", "星期三", "星期四", "星期五", "星期六"]
                    }, months: {
                        shorthand: ["1月", "2月", "3月", "4月", "5月", "6月", "7月", "8月", "9月", "10月", "11月", "12月"],
                        longhand: ["1月", "2月", "3月", "4月", "5月", "6月", "7月", "8月", "9月", "10月", "11月", "12月"]
                    },
                    rangeSeparator: " - ",
                },
                onClose: function(selectedDates, dateStr, instance) {
                    // 如果選了兩個日期，且起訖是同一天
                    if (selectedDates.length === 2 && selectedDates[0].getTime() === selectedDates[1].getTime()) {
                        let nextDay = new Date(selectedDates[0]);
                        nextDay.setDate(nextDay.getDate() + 1); // 自動加一天
                        instance.setDate([selectedDates[0], nextDay], true);
                    }
                }
            });
    </script>
}
