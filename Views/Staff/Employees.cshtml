@*
    頁面名稱：員工帳號管理 - 徹底修正大括號錯誤版 (Employees.cshtml)
    遵守規範：顧客端前端最低規則 v0.1
*@

@{
    // 改用絕對路徑指定，強迫系統去 Views/Shared 找公版
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
    ViewData["Title"] = "帳號管理";
}

<!-- 二、主要內容統一從 container py-4 開始 -->
<div class="container py-4">

    <!-- 三、頁面標題 -->
    <h1 class="h3 fw-bold mb-2">帳號管理</h1>
    <p class="text-secondary mb-4">管理系統員工帳號、權限設定與啟用狀態。</p>

    <!-- 八、頁面寬度與響應式 -->
    <div class="row g-4">
        <div class="col-12">
            <!-- 四、內容區塊 -->
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center fw-semibold">
                    <span>員工名單</span>
                    <!-- 五、按鈕：主要操作 -->
                    <button type="button" id="btnCreateNew" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#employeeModal">
                        + 新增員工
                    </button>
                </div>
                <div class="card-body">
                    <!-- 九、表格與狀態：表格統一 -->
                    <table class="table table-hover align-middle" id="employeeTable">
                        <thead>
                            <tr>
                                <th>員工姓名</th>
                                <th>員工帳號</th>
                                <th>分館編號</th>
                                <th>權限</th>
                                <th>啟用狀態</th>
                                <th class="text-end">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- 使用 data-* 屬性安全傳遞資料，徹底避開 HTML 行內的大括號與引號解析問題 -->
                            <tr>
                                <td>系統管理員</td>
                                <td>0000000001</td>
                                <td>A01</td>
                                <td><span class="badge text-bg-secondary">0 總公司</span></td>
                                <td><span class="badge text-bg-success">啟用</span></td>
                                <td class="text-end">
                                    <button class="btn btn-outline-primary btn-sm btn-edit"
                                            data-bs-toggle="modal"
                                            data-bs-target="#employeeModal"
                                            data-name="系統管理員"
                                            data-account="0000000001"
                                            data-branch="A01"
                                            data-role="0"
                                            data-status="1">
                                        編輯
                                    </button>
                                </td>
                            </tr>
                            <tr>
                                <td>張小明</td>
                                <td>1029384756</td>
                                <td>B05</td>
                                <td><span class="badge text-bg-secondary">1 員工</span></td>
                                <td><span class="badge text-bg-success">啟用</span></td>
                                <td class="text-end">
                                    <button class="btn btn-outline-primary btn-sm btn-edit"
                                            data-bs-toggle="modal"
                                            data-bs-target="#employeeModal"
                                            data-name="張小明"
                                            data-account="1029384756"
                                            data-branch="B05"
                                            data-role="1"
                                            data-status="1">
                                        編輯
                                    </button>
                                </td>
                            </tr>
                            <tr>
                                <td>王大同</td>
                                <td>5647382910</td>
                                <td>C02</td>
                                <td><span class="badge text-bg-secondary">1 員工</span></td>
                                <td><span class="badge text-bg-danger">停用</span></td>
                                <td class="text-end">
                                    <button class="btn btn-outline-primary btn-sm btn-edit"
                                            data-bs-toggle="modal"
                                            data-bs-target="#employeeModal"
                                            data-name="王大同"
                                            data-account="5647382910"
                                            data-branch="C02"
                                            data-role="1"
                                            data-status="0">
                                        編輯
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap 內建彈跳視窗元件 -->
<div class="modal fade" id="employeeModal" tabindex="-1" aria-labelledby="employeeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-semibold" id="employeeModalLabel">新增員工資料</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="employeeForm" method="post" novalidate>

                    <!-- 六、表單：員工姓名 -->
                    <div class="mb-3">
                        <label class="form-label" for="employeeName">
                            員工姓名 <span class="text-danger">*</span>
                        </label>
                        <input class="form-control" type="text" id="employeeName" required placeholder="請輸入姓名">
                        <div class="invalid-feedback">請輸入員工姓名。</div>
                    </div>

                    <!-- 六、表單：員工帳號 -->
                    <div class="mb-3">
                        <label class="form-label" for="employeeAccount">
                            員工帳號 (10位數字) <span class="text-danger">*</span>
                        </label>
                        <!-- 加上 readonly 防止使用者不小心修改到自動生成的流水號 -->
                        <input class="form-control" type="text" id="employeeAccount" required pattern="\d{10}" maxlength="10" placeholder="系統自動生成中..." readonly>
                        <div class="invalid-feedback">請輸入10位數字的員工帳號。</div>
                    </div>

                    <!-- 六、表單：密碼 -->
                    <div class="mb-3">
                        <label class="form-label" for="employeePassword">
                            密碼 <span class="text-danger">*</span>
                        </label>
                        <input class="form-control" type="password" id="employeePassword" required placeholder="請輸入密碼">
                        <div class="invalid-feedback">請輸入密碼（系統將自動進行安全雜湊加密）。</div>
                    </div>

                    <!-- 六、表單：分館編號 -->
                    <div class="mb-3">
                        <label class="form-label" for="branchId">
                            分館編號 <span class="text-danger">*</span>
                        </label>
                        <input class="form-control" type="text" id="branchId" required placeholder="例如：A01">
                        <div class="invalid-feedback">請輸入分館編號。</div>
                    </div>

                    <!-- 六、表單：啟用狀態 -->
                    <div class="mb-4">
                        <label class="form-label" for="accountStatus">
                            啟用狀態 <span class="text-danger">*</span>
                        </label>
                        <select class="form-select" id="accountStatus" required>
                            <option value="1" selected>啟用</option>
                            <option value="0">停用</option>
                        </select>
                        <div class="invalid-feedback">請選擇啟用狀態。</div>
                    </div>
                    
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary" id="btnSaveEmployee">儲存</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const btnCreateNew = document.getElementById("btnCreateNew");
            const employeeAccountInput = document.getElementById("employeeAccount");
            const modalTitle = document.getElementById("employeeModalLabel");
            const employeeForm = document.getElementById("employeeForm");

            // 1. 監聽「+ 新增員工」按鈕點擊事件
            if (btnCreateNew) {
                btnCreateNew.addEventListener("click", function () {
                    // 切換彈窗標題為新增
                    modalTitle.innerText = "新增員工資料";
                    // 清空表單舊資料
                    employeeForm.reset();
                    
                    // 【關鍵修改】設定帳號輸入框為 disabled，使其外觀變灰且完全無法點擊、修改
                    employeeAccountInput.disabled = true;
                    
                    // 計算並自動帶入 10 碼民國年流水號
                    employeeAccountInput.value = generateNextSerialNumber();
                });
            }

            // 2. 監聽表格中所有「編輯」按鈕
            const editButtons = document.querySelectorAll(".btn-edit");
            editButtons.forEach(btn => {
                btn.addEventListener("click", function () {
                    modalTitle.innerText = "編輯員工資料";
                    
                    // 編輯時同樣將帳號設為 disabled 反灰不可修改
                    employeeAccountInput.disabled = true; 
                    
                    // 帶入原本該列員工的資料
                    document.getElementById("employeeName").value = this.getAttribute("data-name") || "";
                    employeeAccountInput.value = this.getAttribute("data-account") || "";
                    document.getElementById("branchId").value = this.getAttribute("data-branch") || "";
                    document.getElementById("accountStatus").value = this.getAttribute("data-status") || "1";
                    document.getElementById("employeePassword").value = "********"; 
                });
            });

            /**
             * 核心函式：自動生成下一個 10 碼民國年當日流水號 (格式如：1150813001)
             */
            function generateNextSerialNumber() {
                const today = new Date();
                const year = today.getFullYear();
                const month = String(today.getMonth() + 1).padStart(2, '0');
                const day = String(today.getDate()).padStart(2, '0');

                // 轉為 3 碼民國年
                const taiwanYear = String(year - 1911).padStart(3, '0');
                const datePrefix = `${taiwanYear}${month}${day}`;

                // 撈取目前畫面表格中最大尾數
                const rows = document.querySelectorAll("#employeeTable tbody tr");
                let maxSequence = 0;

                rows.forEach(row => {
                    if (row.cells && row.cells[1]) {
                        const accountText = row.cells[1].innerText.trim();
                        if (accountText.startsWith(datePrefix) && accountText.length === 10) {
                            const seq = parseInt(accountText.substring(7, 10), 10);
                            if (!isNaN(seq) && seq > maxSequence) {
                                maxSequence = seq;
                            }
                        }
                    }
                });

                const nextSequenceStr = String(maxSequence + 1).padStart(3, '0');
                return `${datePrefix}${nextSequenceStr}`;
            }

            // 3. 【表單送出防呆】因為欄位設為 disabled 後，表單 submit 時預設不會傳送該欄位值給後端
            // 必須在點擊「儲存」送出前，短暫解除 disabled，或者透過隱藏欄位傳送
            const btnSaveEmployee = document.getElementById("btnSaveEmployee");
            if (btnSaveEmployee) {
                btnSaveEmployee.addEventListener("click", function () {
                    // 送出前解除鎖定，確保後端控制器 (Controller) 能順利接收到 employeeAccount 的值
                    employeeAccountInput.disabled = false;
                    
                    // 執行表單送出 (如果你是用 Ajax 送，也可以直接在 Ajax 裡抓 value)
                    employeeForm.submit();
                });
            }
        });
    </script>
}
