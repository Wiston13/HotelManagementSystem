@model	IEnumerable<dynamic>
@{
    ViewData["Title"] = "帳號管理";
}

<div>
    <p class="text-secondary mb-4">管理分館員工帳號、所屬分館與啟用狀態。</p>

    <div class="row g-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center fw-semibold">
                    <span>員工名單</span>
                    <button type="button" id="btnCreateNew" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#employeeModal">
                        + 新增員工
                    </button>
                </div>
                <div class="card-body">
                    <table class="table table-hover align-middle" id="employeeTable">
                        <thead>
                            <tr>
                                <th>員工姓名</th>
                                <th>員工帳號</th>
                                <th>所屬分館</th>
                                <th>啟用狀態</th>
                                <th class="text-end">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null)
                            {
                                foreach (var emp in Model)
                                {
                                    <tr>
                                        <td>@emp.EmployeeName</td>
                                        <td>@emp.EmployeeNumber</td>
                                        <td>
                                            @{
                                                if (emp.BranchId == 1)
                                                {
                                                    <text>台北中山商旅</text>
                                                }
                                                else if (emp.BranchId == 2)
                                                {
                                                    <text>台北信義商旅</text>
                                                }
                                                else if (emp.BranchId == 3)
                                                {
                                                    <text>台中草悟商旅</text>
                                                }
                                                else if (emp.BranchId == 4)
                                                {
                                                    <text>台南安平商旅</text>
                                                }
                                                else if (emp.BranchId == 5)
                                                {
                                                    <text>高雄港灣商旅</text>
                                                }
                                                else if (emp.BranchId == 6)
                                                {
                                                    <text>花蓮站前商旅</text>
                                                }
                                                else
                                                {
                                                    <text>總公司行政處</text>
                                                }
                                            }
                                        </td>
                                        <td>
                                            @if (emp.IsActive == true)
                                            {
                                                <span class="badge text-bg-success">啟用</span>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-danger">停用</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <button class="btn btn-outline-primary btn-sm btn-edit"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#employeeModal"
                                                    data-name="@emp.EmployeeName"
                                                    data-account="@emp.EmployeeNumber"
                                                    data-branch="@emp.BranchId"
                                                    data-status="@(emp.IsActive == true ? "1" : "0")">
                                                編輯
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="employeeModal" tabindex="-1" aria-labelledby="employeeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-semibold" id="employeeModalLabel">新增員工資料</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="employeeForm" novalidate>

                    <div class="mb-3">
                        <label class="form-label" for="employeeName">
                            員工姓名 <span class="text-danger">*</span>
                        </label>
                        <input class="form-control" type="text" id="employeeName" required placeholder="請輸入姓名">
                        <div class="invalid-feedback">請輸入員工姓名。</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="employeeAccount">
                            員工帳號 <span class="text-danger">*</span>
                        </label>
                        <input class="form-control" id="employeeAccount" type="text" placeholder="建立後由系統自動產生" readonly>
                        <div class="invalid-feedback">員工帳號不可為空。</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="employeePassword" id="passwordLabel">
                            初始密碼 <span class="text-danger">*</span>
                        </label>
                        <input class="form-control" type="password" id="employeePassword" placeholder="請輸入密碼">
                        <div class="form-text text-muted d-none" id="passwordHint">留空表示不修改密碼</div>
                        <div class="invalid-feedback">請輸入密碼。</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="branchId">
                            所屬分館 <span class="text-danger">*</span>
                        </label>
                        <select class="select form-select" id="branchId" required>
                            <option value="" disabled selected>請選擇分館</option>
                            <option value="1">台北中山商旅</option>
                            <option value="2">台北信義商旅</option>
                            <option value="3">台中草悟商旅</option>
                            <option value="4">台南安平商旅</option>
                            <option value="5">高雄港灣商旅</option>
                            <option value="6">花蓮站前商旅</option>
                        </select>
                        <div class="invalid-feedback">請選擇所屬分館。</div>
                    </div>

                    <div class="mb-4" id="statusContainer">
                        <label class="form-label" for="accountStatus">
                            啟用狀態 <span class="text-danger">*</span>
                        </label>
                        <select class="form-select" id="accountStatus" required>
                            <option value="1">啟用</option>
                            <option value="0">停用</option>
                        </select>
                        <div class="invalid-feedback">請選擇啟用狀態。</div>
                    </div>

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary" id="btnSaveEmployee">儲存</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {

            // 1. 按下「+ 新增員工」時的清空與重置
            $("#btnCreateNew").on("click", function() {
                $("#employeeModalLabel").text("新增員工資料");
                $("#passwordLabel").html('初始密碼 <span class="text-danger">*</span>');
                $("#passwordHint").addClass("d-none");
                $("#statusContainer").addClass("d-none"); // 新增時依據妳們的需求隱藏狀態控制
                $("#employeeForm").removeAttr("data-edit-account");

                $("#employeeName").val("");
                $("#employeeAccount").val("建立後由系統自動產生");
                $("#employeePassword").val("");
                $("#branchId").val("");
                $("#accountStatus").val("1");
            });

            // 2. 【核心大修復】：精準綁定表格內的編輯按鈕，100% 隔空抓出資料庫真實數據！
            $(document).on("click", ".btn-edit", function() {
                $("#employeeModalLabel").text("修改員工資料");
                $("#passwordLabel").html('修改密碼');
                $("#passwordHint").removeClass("d-none");
                $("#statusContainer").removeClass("d-none"); // 編輯時漂亮地秀出啟用/停用選單

                // 🚀 【抓資料密碼修正】：精準提取妳們 HTML button 上面的 data-* 真實屬性字串！
                var name = $(this).attr("data-name");
                var account = $(this).attr("data-account");
                var branch = $(this).attr("data-branch");
                var status = $(this).attr("data-status");

                // 🚀 100% 動態灌進 Modal 裡面，這次保證絕對不會再出現空白！
                $("#employeeName").val(name);
                $("#employeeAccount").val(account);
                $("#employeePassword").val(""); // 密碼欄位留空，讓有需要的人再填
                $("#branchId").val(branch);
                $("#accountStatus").val(status);

                // 將當前修改的工號鎖死在表單中，當作後端修改的鑰匙
                $("#employeeForm").attr("data-edit-account", account);
            });

            // 3. 按下「儲存」按鈕時的自動分流發送
            $("#btnSaveEmployee").on("click", function() {
                var empName = $("#employeeName").val().trim();
                var empPassword = $("#employeePassword").val();
                var bId = $("#branchId").val();
                var statusVal = $("#accountStatus").val();
                var editAccount = $("#employeeForm").attr("data-edit-account");

                if (!empName || !bId) {
                    alert("請填寫所有必填欄位（姓名、分館）！");
                    return;
                }

                var isEdit = !!editAccount;
                var url = isEdit ? '/Staff/UpdateEmployee' : '/Staff/CreateEmployee';

                var postData = {
                    employeeName: empName,
                    passwordHash: empPassword,
                    branchId: parseInt(bId),
                    isActive: statusVal === "1"
                };

                if (isEdit) {
                    postData.employeeNumber = editAccount;
                }

                $.ajax({
                    url: url,
                    type: 'POST',
                    data: postData,
                    success: function(res) {
                        if (res.success) {
                            alert(res.message);
                            $('#employeeModal').modal('hide');
                            location.reload();
                        } else {
                            alert("操作失敗：" + res.message);
                        }
                    },
                    error: function(err) {
                        alert("連線資料庫發生錯誤，請確認後端網路。");
                    }
                });
            });
        });
    </script>
}
