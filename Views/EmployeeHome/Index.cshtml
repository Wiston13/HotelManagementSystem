                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div id="rooms-to-clean-pane" class="tab-pane fade" role="tabpanel" aria-labelledby="rooms-to-clean-tab" tabindex="0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 employee-home-table">
                        <thead>
                            <tr>
                                <th scope="col">房號</th>
                                <th scope="col">房型</th>
                                <th scope="col">樓層</th>
                                <th scope="col">清潔狀態</th>
                                <th scope="col" class="text-end">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="item-code">302</td>
                                <td>標準雙人房</td>
                                <td>3 樓</td>
                                <td><span class="badge text-bg-secondary">待清潔</span></td>
                                <td class="text-end"><a class="btn btn-outline-primary btn-sm fw-semibold" asp-controller="RoomStatus" asp-action="Index">處理房況</a></td>
                            </tr>
                            <tr>
                                <td class="item-code">407</td>
                                <td>豪華雙人房</td>
                                <td>4 樓</td>
