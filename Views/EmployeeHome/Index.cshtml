                                <td class="text-end"><a class="btn btn-outline-primary btn-sm fw-semibold" asp-controller="Stay" asp-action="CheckIn">辦理入住</a></td>
                            </tr>
                            <tr>
                                <td class="item-code">BK…024</td>
                                <td>陳怡君</td>
                                <td>豪華雙人房</td>
                                <td>08/10</td>
                                <td><span class="badge text-bg-warning">待入住</span></td>
                                <td class="text-end"><a class="btn btn-outline-primary btn-sm fw-semibold" asp-controller="Stay" asp-action="CheckIn">辦理入住</a></td>
                            </tr>
                            <tr>
                                <td class="item-code">BK…031</td>
                                <td>張雅婷</td>
                                <td>家庭四人房</td>
                                <td>08/10</td>
                                <td><span class="badge text-bg-warning">待入住</span></td>
                                <td class="text-end"><a class="btn btn-outline-primary btn-sm fw-semibold" asp-controller="Stay" asp-action="CheckIn">辦理入住</a></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div id="today-check-outs-pane" class="tab-pane fade" role="tabpanel" aria-labelledby="today-check-outs-tab" tabindex="0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 employee-home-table">
                        <thead>
                            <tr>
                                <th scope="col">訂單編號</th>
                                <th scope="col">房號</th>
                                <th scope="col">顧客</th>
                                <th scope="col">退房日期</th>
                                <th scope="col">狀態</th>
                                <th scope="col" class="text-end">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="item-code">BK…011</td>
                                <td>501</td>
                                <td>林志豪</td>
                                <td>08/10</td>
                                <td><span class="badge text-bg-info">待退房</span></td>
                                <td class="text-end"><a class="btn btn-outline-primary btn-sm fw-semibold" asp-controller="Stay" asp-action="CheckOut">辦理退房</a></td>
                            </tr>
                            <tr>
                                <td class="item-code">BK…016</td>
                                <td>603</td>
                                <td>劉品妤</td>
                                <td>08/10</td>
                                <td><span class="badge text-bg-info">待退房</span></td>
                                <td class="text-end"><a class="btn btn-outline-primary btn-sm fw-semibold" asp-controller="Stay" asp-action="CheckOut">辦理退房</a></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div id="active-stays-pane" class="tab-pane fade" role="tabpanel" aria-labelledby="active-stays-tab" tabindex="0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 employee-home-table">
                        <thead>
                            <tr>
                                <th scope="col">訂單編號</th>
                                <th scope="col">房號</th>
                                <th scope="col">顧客</th>
                                <th scope="col">入住日</th>
                                <th scope="col">預計退房日</th>
                                <th scope="col">狀態</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="item-code">BK…011</td>
                                <td>501</td>
                                <td>林志豪</td>
                                <td>08/08</td>
                                <td>08/10</td>
                                <td><span class="badge text-bg-primary">入住中</span></td>
                            </tr>
                            <tr>
                                <td class="item-code">BK…016</td>
                                <td>603</td>
                                <td>劉品妤</td>
                                <td>08/07</td>
                                <td>08/10</td>
                                <td><span class="badge text-bg-primary">入住中</span></td>
                            </tr>
                            <tr>
                                <td class="item-code">BK…021</td>
                                <td>302</td>
                                <td>黃冠宇</td>
                                <td>08/09</td>
