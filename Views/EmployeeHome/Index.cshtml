@model HotelManagementSystem.Models.ViewModels.EmployeeHome.EmployeeHomeViewModel
@{
    ViewData["Title"] = "本館工作首頁";
}

@section Styles {
    <link rel="stylesheet" href="~/css/employee-home/Index.css" asp-append-version="true" />
}

<div class="employee-home-page">
    <section aria-label="工作摘要">
        <div class="row g-3 g-lg-4">
            <div class="col-6 col-xl-3">
                <article class="dashboard-stat card h-100 border-0 shadow-sm">
                    <div class="card-body p-3 p-md-4">
                        <p class="dashboard-stat__value mb-1">@Model.PendingCheckIns.Count</p>
                        <p class="dashboard-stat__label text-secondary mb-0">待入住</p>
                    </div>
                </article>
            </div>
            <div class="col-6 col-xl-3">
                <article class="dashboard-stat card h-100 border-0 shadow-sm">
                    <div class="card-body p-3 p-md-4">
                        <p class="dashboard-stat__value mb-1">@Model.ActiveStays.Count</p>
                        <p class="dashboard-stat__label text-secondary mb-0">目前入住中</p>
                    </div>
                </article>
            </div>
            <div class="col-6 col-xl-3">
                <article class="dashboard-stat card h-100 border-0 shadow-sm">
                    <div class="card-body p-3 p-md-4">
                        <p class="dashboard-stat__value mb-1">@Model.PendingCheckOuts.Count</p>
                        <p class="dashboard-stat__label text-secondary mb-0">待退房</p>
                    </div>
                </article>
            </div>
            <div class="col-6 col-xl-3">
                <article class="dashboard-stat card h-100 border-0 shadow-sm">
                    <div class="card-body p-3 p-md-4">
                        <p class="dashboard-stat__value mb-1">@Model.RoomsToClean.Count</p>
                        <p class="dashboard-stat__label text-secondary mb-0">待清潔房間</p>
                    </div>
                </article>
            </div>
        </div>
    </section>

    @if (Model.Announcements.Count > 0)
    {
        <section class="mt-4" aria-label="系統公告">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        <i class="bi bi-megaphone me-2"></i>
                        系統公告
                    </h5>
                </div>

                <div class="card-body">
                    @foreach (var announcement in Model.Announcements)
                    {
                        <div class="mb-3">
                            <h6 class="fw-bold mb-1">
                                @announcement.Title
                            </h6>

                            <p class="mb-1">
                                @announcement.Content
                            </p>

                            <small class="text-muted">
                                公告期間：
                                @announcement.StartAt.ToString("yyyy/MM/dd HH:mm")
                                ～
                                @announcement.EndAt.ToString("yyyy/MM/dd HH:mm")
                            </small>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    <section class="employee-home-tasks mt-4 mt-md-5" aria-labelledby="work-list-title">
        <h2 id="work-list-title" class="visually-hidden">工作清單</h2>

        <ul class="nav nav-tabs employee-home-tabs" id="employeeHomeTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button id="today-check-ins-tab"
                        class="nav-link active"
                        type="button"
                        role="tab"
                        data-bs-toggle="tab"
                        data-bs-target="#today-check-ins-pane"
                        aria-controls="today-check-ins-pane"
                        aria-selected="true">
                    待入住
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button id="active-stays-tab"
                        class="nav-link"
                        type="button"
                        role="tab"
                        data-bs-toggle="tab"
                        data-bs-target="#active-stays-pane"
                        aria-controls="active-stays-pane"
                        aria-selected="false">
                    目前已入住
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button id="today-check-outs-tab"
                        class="nav-link"
                        type="button"
                        role="tab"
                        data-bs-toggle="tab"
                        data-bs-target="#today-check-outs-pane"
                        aria-controls="today-check-outs-pane"
                        aria-selected="false">
                    待退房
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button id="rooms-to-clean-tab"
                        class="nav-link"
                        type="button"
                        role="tab"
                        data-bs-toggle="tab"
                        data-bs-target="#rooms-to-clean-pane"
                        aria-controls="rooms-to-clean-pane"
                        aria-selected="false">
                    待清潔房間
                </button>
            </li>
        </ul>

        <div class="tab-content employee-home-task-list border border-top-0 bg-white shadow-sm" id="employeeHomeTabContent">

            <div id="today-check-ins-pane" class="tab-pane fade show active" role="tabpanel" aria-labelledby="today-check-ins-tab" tabindex="0">
                <div class="table-responsive">
                    @if (Model.PendingCheckIns.Count == 0)
                    {
                        <div class="alert alert-secondary mt-4">目前沒有待入住訂單</div>
                    }
                    else
                    {
                        <table class="table table-hover align-middle mb-0 employee-home-table">
                            <thead>
                                <tr>
                                    <th scope="col">訂單編號</th>
                                    <th scope="col">顧客姓名</th>
                                    <th scope="col">顧客電話</th>
                                    <th scope="col">房型</th>
                                    <th scope="col">入住日期</th>
                                    <th scope="col" class="text-end">操作</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.PendingCheckIns)
                                {
                                    <tr>
                                        <td class="item-code">@item.BookingNumber</td>
                                        <td>@item.BookerName</td>
                                        <td>@item.ContactPhone</td>
                                        <td>@item.RoomTypeName</td>
                                        <td>@item.CheckInDate.ToString("yyyy/MM/dd")</td>
                                        <td class="text-end">
                                            <form method="get" asp-controller="Stay" asp-action="CheckIn">
                                                <input name="bookingNumber" value="@item.BookingNumber" type="hidden" />
                                                <button class="btn btn-outline-primary btn-sm fw-semibold" type="submit">辦理入住</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>

            <div id="active-stays-pane" class="tab-pane fade" role="tabpanel" aria-labelledby="active-stays-tab" tabindex="0">
                <div class="table-responsive">
                    @if (Model.ActiveStays.Count == 0)
                    {
                        <div class="alert alert-secondary mt-4">目前沒有入住中的訂單</div>
                    }
                    else
                    {
                        <table class="table table-hover align-middle mb-0 employee-home-table">
                            <thead>
                                <tr>
                                    <th scope="col">訂單編號</th>
                                    <th scope="col">房號</th>
                                    <th scope="col">顧客姓名</th>
                                    <th scope="col">入住時間</th>
                                    <th scope="col">預計退房日</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.ActiveStays)
                                {
                                    <tr>
                                        <td class="item-code">@item.BookingNumber</td>
                                        <td>@item.RoomNumber</td>
                                        <td>@item.PrimaryGuestName</td>
                                        <td>@item.ActualCheckInAt.ToString("yyyy/MM/dd HH:mm")</td>
                                        <td>@item.CheckOutDate.ToString("yyyy/MM/dd")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>

            <div id="today-check-outs-pane" class="tab-pane fade" role="tabpanel" aria-labelledby="today-check-outs-tab" tabindex="0">
                <div class="table-responsive">
                    @if (Model.PendingCheckOuts.Count == 0)
                    {
                        <div class="alert alert-secondary mt-4">目前沒有待退房訂單</div>
                    }
                    else
                    {
                        <table class="table table-hover align-middle mb-0 employee-home-table">
                            <thead>
                                <tr>
                                    <th scope="col">訂單編號</th>
                                    <th scope="col">房號</th>
                                    <th scope="col">顧客</th>
                                    <th scope="col">退房日期</th>
                                    <th scope="col" class="text-end">操作</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.PendingCheckOuts)
                                {
                                    <tr>
                                        <td class="item-code">@item.BookingNumber</td>
                                        <td>@item.RoomNumber</td>
                                        <td>@item.PrimaryGuestName</td>
                                        <td>@item.CheckOutDate.ToString("yyyy/MM/dd")</td>
                                        <td class="text-end">
                                            <form method="get" asp-controller="Stay" asp-action="CheckOut">
                                                <input name="searchValue" value="@item.BookingNumber" type="hidden" />
                                                <button class="btn btn-outline-primary btn-sm fw-semibold" type="submit">辦理退房</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>

            

            <div id="rooms-to-clean-pane" class="tab-pane fade" role="tabpanel" aria-labelledby="rooms-to-clean-tab" tabindex="0">
                <div class="table-responsive">
                    @if (Model.RoomsToClean.Count == 0)
                    {
                        <div class="alert alert-secondary mt-4">目前沒有待清潔房間</div>
                    }
                    else
                    {
                        <table class="table table-hover align-middle mb-0 employee-home-table">
                        <thead>
                            <tr>
                                <th scope="col">房號</th>
                                <th scope="col">房型</th>
                                <th scope="col">樓層</th>
                                <th scope="col" class="text-end">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var item in Model.RoomsToClean)
                            {
                                <tr>
                                    <td class="item-code">@item.RoomNumber</td>
                                    <td>@item.RoomTypeName</td>
                                    <td>@item.Floor 樓</td>
                                    <td class="text-end">
                                        <a class="btn btn-outline-primary btn-sm fw-semibold" 
                                        asp-controller="RoomStatus" 
                                        asp-action="Index"
                                        asp-route-roomId="@item.RoomId">處理房況</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    }
                </div>
            </div>
        </div>
    </section>
</div>
