@{
    var pageTitle = ViewData["Title"] as string;
    var branchName = ViewData["BranchName"] as string;
    var staffName = ViewData["StaffName"] as string;

    var currentAction = ViewContext.RouteData.Values["action"]!.ToString();
    var BranchController = ViewContext.RouteData.Values["controller"]!.ToString();


    //暫時 之後帶資料
    branchName = "台北館";

    // 判斷目前頁面用來設定側邊欄 active 狀態
    // 到時候主頁面名稱決定再修改下方名詞

    var isIndex =  currentAction == "Index";
    var isLookup = currentAction == "Lookup";
    var isCheckIn = currentAction == "CheckIn";
    var isCheckOut = currentAction == "CheckOut";
    var isUnchecked = currentAction == "Unchecked";
    var isRoomStatus = currentAction == "Index";
    // 自動判斷所在頁面亮起
        string Check(bool checkAction)
    {
        return checkAction ? "active bg-primary-subtle text-dark" : "text-dark";
    }
    
}

<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(string.IsNullOrWhiteSpace(pageTitle) ? "旅館管理系統" : $"{pageTitle}｜旅館管理系統")</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons (支援圖示) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <!-- 全站樣式 -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-light min-vh-100 d-flex flex-column">

    <!-- 主體容器：使用 CSS Grid 或 Flex 讓側邊欄與右側內容並排 -->
    <div class="container-fluid flex-grow-1 d-flex flex-column p-0">
        <div class="row g-0 flex-grow-1">

            <!-- 左側邊欄 (Sidebar) -->
            <nav class="col-md-3 col-lg-2 d-md-block bg-white border-end collapse p-3" id="adminSidebar">
                <div class="position-sticky pt-3">
                    <h5 class="sidebar-heading px-3 mb-3 text-primary fw-bold">
                        @branchName 旅館管理系統
                    </h5>

                    <ul class="nav flex-column gap-1">
                        <li class="nav-item">
							<!---->
                            <a class="nav-link rounded @(Check(isIndex))"
                               asp-controller="@BranchController" asp-action="Index">
                                <i class="bi bi-house-door me-2"></i>工作首頁
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link rounded @(Check(isLookup))"
                               asp-controller="@BranchController" asp-action="Lookup">
                                <i class="bi bi-search me-2"></i>訂單查詢
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link rounded @(Check(isCheckIn))" asp-controller="@BranchController" asp-action="CheckIn">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Check-in
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link rounded @(Check(isCheckOut))" asp-controller="@BranchController" asp-action="CheckOut">
                                <i class="bi bi-box-arrow-right me-2"></i>Check-out
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link rounded @(Check(isUnchecked) )" asp-controller="@BranchController" asp-action="Unchecked">
                                <i class="bi bi-exclamation-circle me-2"></i>未入住結案
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link rounded @(Check(isRoomStatus) )" asp-controller="RoomStatus" asp-action="Index">
                                <i class="bi bi-door-open me-2"></i>房間狀態
                            </a>
                        </li>
                        <hr class="my-2">
                        <li class="nav-item">
                            <a class="nav-link rounded text-danger" asp-controller="@BranchController" asp-action="">
                                <i class="bi bi-box-arrow-left me-2"></i>登出
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <!-- 右側主要內容區 -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4 d-flex flex-column">

                <!-- 頂部資訊列 (顯示登入身分：台北館・櫃檯人員) -->
                <div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
                    <h2 class="h4 mb-0 fw-bold">@pageTitle</h2>
                    <div class="text-secondary small">
                        <i class="bi bi-person-circle me-1"></i> @branchName・櫃檯人員・@staffName
                    </div>
                </div>

                <!-- 頁面實際內容 -->
                <div class="flex-grow-1">
                    @RenderBody()
                </div>

            </main>
        </div>
    </div>

    <!-- Script -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>