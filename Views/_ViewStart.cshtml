@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();

    Layout = controller switch
    {
        "EmployeeHome" or "Stay" or "RoomStatus" or "BranchBooking" => "_BranchLayout",
        "Branch" or "RoomType" or "Room" or "Staff" or "BookingExport" or "OperationLog" => "_ManagerLayout",
        _ => "_CustomerLayout"
    };
}
