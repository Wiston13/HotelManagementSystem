@{
}
@*
    頁面名稱：登出完成頁面 (Logout.cshtml)
    遵守規範：顧客端前端最低規則 v0.1
*@

@{
    ViewData["Title"] = "安全登出";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-5">

            <!-- 三、頁面標題 -->
            <h1 class="h3 fw-bold mb-2 text-center">安全登出</h1>
            <p class="text-secondary mb-4 text-center">您已經成功登出系統，謝謝您的光臨。</p>

            <!-- 四、內容區塊 -->
            <div class="card shadow-sm text-center">
                <div class="card-body p-5">

                    <!-- 狀態使用 Badge (九、表格與狀態規則) -->
                    <div class="mb-4">
                        <span class="badge text-bg-success px-3 py-2 fs-6">已安全登出</span>
                    </div>

                    <!-- 提示訊息說明區 -->
                    <p class="mb-4 text-muted small">
                        為了保護您的個人資料安全，若您使用的是公用電腦，請記得關閉瀏覽器視窗。
                    </p>

                    <!-- 五、按鈕：主要操作 -->
                    <div class="d-grid mb-3">
                        <a href="/Home/Index" class="btn btn-primary">
                            返回首頁
                        </a>
                    </div>

                    <!-- 五、按鈕：次要操作 -->
                    <div class="d-grid">
                        <a href="/Account/Login" class="btn btn-outline-primary">
                            重新登入
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>
