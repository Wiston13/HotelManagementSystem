@*
    飯店後台：純登入表單原型頁面 
*@
@{
    
}
<div class="container py-4">
    <div class="row justify-content-center">
     
        <div class="col-12 col-md-8 col-lg-5">

            <!-- 三、頁面標題與品牌識別 -->
            <div class="text-center mb-4">
                <h1 class="h3 fw-bold mb-2">連鎖商旅</h1>
                <p class="text-secondary mb-0">內部管理系統</p>
            </div>

            <!-- 四、內容區塊：使用 Bootstrap Card -->
            <div class="card shadow-sm">
                <div class="card-header fw-semibold text-center bg-transparent py-3">
                    內部人員登入
                </div>
                <div class="card-body p-4">

                   
                    <form id="loginForm" class="needs-validation" novalidate>

                        <!-- 六、表單：帳號欄位 -->
                        <div class="mb-3">
                            <label class="form-label" for="username">
                                員工帳號 <span class="text-danger">*</span>
                            </label>
                            
                            <input type="text"
                                   id="username"
                                   name="Username"
                                   class="form-control"
                                   placeholder="請輸入員工編號"
                                   autocomplete="username"
                                   required>
                            <div class="invalid-feedback">請輸入員工編號</div>
                        </div>

                        <!-- 六、表單：密碼欄位 -->
                        <div class="mb-4">
                            <label class="form-label" for="password">
                                登入密碼 <span class="text-danger">*</span>
                            </label>
                           
                            <input type="password"
                                   id="password"
                                   name="Password"
                                   class="form-control"
                                   placeholder="請輸入密碼"
                                   autocomplete="current-password"
                                   required>
                            <div class="invalid-feedback">請輸入登入密碼</div>
                        </div>

                       
                        @if (ViewBag.ErrorMessage != null)
                        {
                            <div class="alert alert-danger p-2 text-center text-sm mb-3" role="alert">
                                ⚠️ @ViewBag.ErrorMessage
                            </div>
                        }

                        <!-- 五、按鈕：主要操作 -->
                        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                            安全登入
                        </button>
                    </form>

                </div>
            </div>

            <!-- 頁尾宣告 -->
            <div class="text-center mt-4 text-secondary" style="font-size: 0.75rem;">
                &copy; @DateTime.Now.Year 內部管理系統. All rights reserved.
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
            document.getElementById("loginForm").addEventListener("submit", function (event) {
            event.preventDefault();

            // 啟用 Bootstrap 的驗證樣式顯示
            this.classList.add("was-validated");

            // 檢查表單 HTML5 原生驗證狀態（如 required）
            if (!this.checkValidity()) {
                return;
            }

            // 驗證通過，跳轉至靜態展示首頁
            window.location.href = "/EmployeeHome/Index";
        });
    </script>
}
