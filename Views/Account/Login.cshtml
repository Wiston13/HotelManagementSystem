@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@*
    目前只產生此 View 所需內容，不修改 Layout。
    後續可透過 Controller 傳遞錯誤訊息。
*@

<div class="container py-4">
    <div class="row justify-content-center">
        <!-- 桌面版佔 5 欄（居中），窄畫面自動滿版 -->
        <div class="col-12 col-md-8 col-lg-5">

            <!-- 三、頁面標題與品牌識別 -->
            <div class="text-center mb-4">
                <h1 class="h3 fw-bold mb-2">寰宇連鎖飯店</h1>
                <p class="text-secondary mb-0">智慧後台管理系統 (HMS)</p>
            </div>

            <!-- 四、內容區塊：優先使用 Bootstrap Card -->
            <div class="card shadow-sm">
                <div class="card-header fw-semibold text-center bg-transparent py-3">
                    員工權限登入入口
                </div>
                <div class="card-body p-4">

                    <!-- 登入表單：串接標準 C# POST 路由（名稱依你們 Controller 為準） -->
                    <form id="loginForm" method="post" action="/Account/Login" onsubmit="return validateForm()">

                        <!-- 六、表單：帳號欄位 -->
                        <div class="mb-3">
                            <label class="form-label">
                                員工帳號 <span class="text-danger">*</span>
                            </label>
                            <input type="text" id="username" name="Username" class="form-control" placeholder="請輸入員工編號" autocomplete="username">
                            <!-- 錯誤訊息統一規範 -->
                            <div id="usernameFeedback" class="invalid-feedback">
                                請輸入員工帳號。
                            </div>
                        </div>

                        <!-- 六、表單：密碼欄位 -->
                        <div class="mb-4">
                            <label class="form-label">
                                登入密碼 <span class="text-danger">*</span>
                            </label>
                            <input type="password" id="password" name="Password" class="form-control" placeholder="請輸入密碼" autocomplete="current-password">
                            <div id="passwordFeedback" class="invalid-feedback">
                                請輸入密碼。
                            </div>
                        </div>

                        <!-- 後端回傳錯誤提示（動態判斷，第一輪先保留結構） -->
                        @if (ViewBag.ErrorMessage != null)
                        {
                            <div class="alert alert-danger p-2 text-center text-sm mb-3" role="alert">
                                ⚠️ @ViewBag.ErrorMessage
                            </div>
                        }

                        <!-- 五、按鈕：主要操作 -->
                        <button type="submit" class="btn btn-primary w-full w-100 py-2 fw-semibold">
                            安全登入
                        </button>
                    </form>

                </div>
            </div>

            <!-- 頁尾宣告 -->
            <div class="text-center mt-4 text-secondary" style="font-size: 0.75rem;">
                &copy; @DateTime.Now.Year 寰宇飯店集團資訊部. All rights reserved.
            </div>

        </div>
    </div>
</div>

@* 十、JavaScript 限制：只處理目前頁面需要的原型互動（基本欄位驗證） *@
<script>
    function validateForm() {
        var usernameInput = document.getElementById('username');
        var passwordInput = document.getElementById('password');
        var isValid = true;

        // 重置所有驗證狀態
        usernameInput.classList.remove('is-invalid');
        passwordInput.classList.remove('is-invalid');

        // 驗證帳號
        if (!usernameInput.value.trim()) {
            usernameInput.classList.add('is-invalid');
            isValid = false;
        }

        // 驗證密碼
        if (!passwordInput.value.trim()) {
            passwordInput.classList.add('is-invalid');
            isValid = false;
        }

        // 若驗證失敗，阻止表單送出
        return isValid;
    }
</script>
