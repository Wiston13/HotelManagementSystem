@{
    ViewData["Title"] = "訂單資料匯出";
}

<div>
    <p class="text-secondary mb-4">選擇分館及日期區間，檢視跨分館訂單並可選擇匯出完整資料</p>

    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <form id="exportForm" onsubmit="return false;">
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-4">
                        <label class="form-label fw-semibold">選擇分館</label>
                        <!-- 【落實規範 6-2】：下拉選單重構，全部分館對應空值，其餘選項動態帶入數字 ID -->
                        <select id="branchSelect" class="form-control">
                            <option value="">全部分館</option>
                            @if (ViewBag.Branches != null)
                            {
                                foreach (var branch in ViewBag.Branches)
                                {
                                    <option value="@branch.BranchId">@branch.BranchName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-5">
                        <label class="form-label fw-semibold">入住日期區間</label>
                        <div class="input-group">
                            <input type="date" class="form-control" id="dateStart" value="2026-08-15">
                            <span class="input-group-text bg-light text-secondary">至</span>
                            <input type="date" class="form-control" id="dateEnd" value="2026-09-15">
                        </div>
                    </div>
                    <div class="col-12 col-md-3 d-grid">
                        <button type="button" class="btn btn-primary py-2" id="btnSearch" onclick="executeSearch()">查詢</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card mb-4 shadow-sm d-none" id="resultCard">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h5 class="fw-bold mb-0 text-dark" id="totalCountText">共 0 筆</h5>
            <button type="button" class="btn btn-outline-primary btn-sm" id="btnExport" onclick="executeExport()">📥 匯出訂單 csv 檔</button>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.9rem; min-width: 2600px;">
                <thead class="table-light">
                    <tr>
                        <th>訂單編號</th>
                        <th>分館</th>
                        <th>訂單成立時間</th>
                        <th>訂房人姓名</th>
                        <th>聯絡電話</th>
                        <th>Email</th>
                        <th>入住日</th>
                        <th>退房日</th>
                        <th class="text-center">住宿晚數</th>
                        <th>房型名稱快照</th>
                        <th class="text-end">每晚價格快照</th>
                        <th class="text-end">訂單總金額</th>
                        <th class="text-end">付款金額</th>
                        <th>付款時間</th>
                        <th>訂單狀態</th>
                        <th>取消因素</th>
                        <th>取消原因</th>
                        <th class="text-end">模擬退款金額</th>
                        <th>取消員工</th>
                        <th>取消時間</th>
                        <th>入住時房號</th>
                        <th class="text-center">實際入住人數</th>
                        <th>實際入住時間</th>
                        <th>入住辦理員工</th>
                        <th>實際退房時間</th>
                        <th>退房辦理員工</th>
                    </tr>
                </thead>
                <tbody id="resultTableBody"></tbody>
            </table>
        </div>
    </div>

    <div class="card mb-4 shadow-sm text-center py-5 d-none" id="noDataCard">
        <div class="card-body">
            <div class="text-secondary mb-3" style="font-size: 2.5rem;">🔍</div>
            <h5 class="fw-bold mb-2">很抱歉，在此篩選條件下查無 any 資料</h5>
            <p class="text-muted small mb-0">請嘗試調整您的查詢日期或分館條件後重新查詢。</p>
        </div>
    </div>
</div>

<script>
    var currentFilteredData = [];

    function escapeCsvField(val) {
        if (val === null || val === undefined) return '""';
        let str = String(val);
        return '"' + str.replace(/"/g, '""') + '"';
    }

    async function executeSearch() {
        var sDate = document.getElementById("dateStart").value;
        var eDate = document.getElementById("dateEnd").value;
        // 【落實規範 6-2】：此處取出的值將會是 branchId 數值（例如 "1"）或全部分館的空字串 ""
        var selectedBranchId = document.getElementById("branchSelect").value;
        var resultTableBody = document.getElementById("resultTableBody");
        var btnSearch = document.getElementById("btnSearch");

        btnSearch.disabled = true;
        btnSearch.innerText = "連線資料庫中...";

        try {
            // 【落實規範 6-2】：調整 URL 查詢參數名稱為 branchId，精準對接後端
            var url = "/BookingExport/GetOrders?branchId=" + encodeURIComponent(selectedBranchId) + "&start=" + sDate + "&end=" + eDate;
            var response = await fetch(url);
            var result = await response.json();

            if (!result.success) {
                // 【落實規範 九】：前端提示訊息重構，移除印出 result.message，避免將 Exception 內部細節暴露給使用者
                alert("資料庫讀取失敗，請稍後再試。");
                btnSearch.disabled = false;
                btnSearch.innerText = "查詢";
                return;
            }

            currentFilteredData = result.data;
            resultTableBody.replaceChildren();

            if (currentFilteredData.length > 0) {
                document.getElementById("totalCountText").innerText = "共 " + currentFilteredData.length + " 筆";

                currentFilteredData.forEach(function(item) {
                    var start = new Date(item.check_in || item.CheckInDate);
                    var end = new Date(item.check_out || item.CheckOutDate);
                    var calculatedNights = 0;

                    if (!isNaN(start) && !isNaN(end)) {
                        calculatedNights = Math.ceil(Math.abs(end - start) / (1000 * 60 * 60 * 24));
                    }

                    var tr = document.createElement("tr");

                    var badgeClass = "text-bg-secondary";
                    if (item.status === "Paid" || item.status === "Completed") badgeClass = "text-bg-success";
                    if (item.status === "CheckedIn") badgeClass = "text-bg-warning";
                    if (item.status === "Cancelled") badgeClass = "text-bg-danger";

                    var fields = [
                        item.booking_no, item.branch_name, item.created_at, item.guest_name,
                        item.phone, item.email, item.check_in, item.check_out, calculatedNights,
                        item.room_type_snapshot,
                        typeof item.price_snapshot === 'number' ? "$" + item.price_snapshot.toFixed(2) : item.price_snapshot,
                        typeof item.total_amount === 'number' ? "$" + item.total_amount.toFixed(2) : item.total_amount,
                        typeof item.total_amount === 'number' ? "$" + item.total_amount.toFixed(2) : item.total_amount,
                        item.created_at || "-"
                    ];

                    fields.forEach(function(val) {
                        var td = document.createElement("td");
                        td.textContent = val ?? "";
                        if (val === calculatedNights) td.className = "text-center";
                        tr.appendChild(td);
                    });

                    var tdStatus = document.createElement("td");
                    var spanStatus = document.createElement("span");
                    spanStatus.className = "badge " + badgeClass;
                    spanStatus.textContent = item.status ?? "";
                    tdStatus.appendChild(spanStatus);
                    tr.appendChild(tdStatus);

                    var appendFields = [
                        item.cancel_cause || "-", item.cancel_reason || "-",
                        typeof item.refund_amount === 'number' ? "$" + item.refund_amount.toFixed(2) : (item.refund_amount || "-"),
                        item.cancel_emp || "-", item.cancel_at || "-", item.room_no || "-",
                        item.act_occupancy !== "" && item.act_occupancy !== 0 ? item.act_occupancy : "-",
                        item.act_checkin_at || "-", item.checkin_emp || "-", item.act_checkout_at || "-",
                        item.checkout_emp || "-"
                    ];

                    appendFields.forEach(function(val) {
                        var td = document.createElement("td");
                        td.textContent = val ?? "";
                        tr.appendChild(td);
                    });

                    resultTableBody.appendChild(tr);
                });

                document.getElementById("resultCard").classList.remove("d-none");
                document.getElementById("noDataCard").classList.add("d-none");
            } else {
                document.getElementById("resultCard").classList.add("d-none");
                document.getElementById("noDataCard").classList.remove("d-none");
            }

        } catch (error) {
            console.error(error);
            alert("網路請求失敗，請確保後端伺服器運行正常。");
        } finally {
            btnSearch.disabled = false;
            btnSearch.innerText = "查詢";
        }
    }

    function executeExport() {
        if (currentFilteredData.length === 0) return;

        var headers = [
            "訂單編號", "分館", "訂單成立時間", "訂房人姓名", "聯絡電話", "Email",
            "入住日", "退房日", "住宿晚數", "房型名稱快照", "每晚價格快照", "訂單總金額",
            "付款金額", "付款時間", "訂單狀態", "取消因素", "取消原因", "模擬退款金額",
            "取消員工", "取消時間", "入住時房號", "實際入住人數", "實際入住時間",
            "入住辦理員工", "實際退房時間", "退房辦理員工"
        ];

        var csvRows = [headers.join(",")];

        currentFilteredData.forEach(function(item) {
            var start = new Date(item.check_in || item.CheckInDate);
            var end = new Date(item.check_out || item.CheckOutDate);
            var calculatedNights = 0;
            if (!isNaN(start) && !isNaN(end)) {
                calculatedNights = Math.ceil(Math.abs(end - start) / (1000 * 60 * 60 * 24));
            }
            var row = [
                escapeCsvField(item.booking_no),
                escapeCsvField(item.branch_name), escapeCsvField(item.created_at), escapeCsvField(item.guest_name), escapeCsvField(item.phone), escapeCsvField(item.email), escapeCsvField(item.check_in), escapeCsvField(item.check_out), calculatedNights, escapeCsvField(item.room_type_snapshot), item.price_snapshot ?? 0, item.total_amount ?? 0, item.total_amount ?? 0, escapeCsvField(item.created_at || "-"), escapeCsvField(item.status), escapeCsvField(item.cancel_cause || "-"), escapeCsvField(item.cancel_reason || "-"), item.refund_amount ?? 0, escapeCsvField(item.cancel_emp || "-"), escapeCsvField(item.cancel_at || "-"), escapeCsvField(item.room_no || "-"), item.act_occupancy || 0, escapeCsvField(item.act_checkin_at || "-"), escapeCsvField(item.checkin_emp || "-"), escapeCsvField(item.act_checkout_at || "-"), escapeCsvField(item.checkout_emp || "-")]; csvRows.push(row.join(","));
        }); var csvString = csvRows.join("\n"); var blob = new Blob([new Uint8Array([0xEF, 0xBB, 0xBF]), csvString], { type: "text/csv;charset=utf-8;" }); var link = document.createElement("a"); link.href = URL.createObjectURL(blob); var today = new Date(); var dateStr = today.getFullYear() + "-" + String(today.getMonth() + 1).padStart(2, '0') + "-" + String(today.getDate()).padStart(2, '0'); link.download = "飯店訂單報表_" + dateStr + ".csv"; document.body.appendChild(link); link.click(); document.body.removeChild(link);
    }


</script>
