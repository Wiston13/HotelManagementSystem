@model IEnumerable<HotelManagementSystem.Models.Entities.Branch>

@{
    ViewData["Title"] = "分館管理";
}

<!-- 成功與失敗訊息提示 Alert 區塊 -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="關閉"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="關閉"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <p class="text-muted small mb-0">管理員可查詢、新增及修改分館必要資料（設定接受或停止新訂房）</p>
    </div>
    <!-- 新增分館按鈕 -->
    <button class="btn btn-primary px-4" data-bs-toggle="modal" data-bs-target="#branchModal" onclick="openBranchModal('add')">
        <i class="bi bi-plus-lg me-1"></i>新增分館
    </button>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">分館名稱</th>
                    <th>區域</th>
                    <th>地址</th>
                    <th>聯絡電話</th>
                    <th>接受新訂房</th>
                    <th class="text-end pe-4">操作</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold ps-4">@item.BranchName</td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @(string.IsNullOrEmpty(item.Region) ? "未設定" : item.Region)
                                </span>
                            </td>
                            <td>@item.Address</td>
                            <td>@item.Phone</td>
                            <td>
                                @if (item.AcceptsNewBookings)
                                {
                                    <span class="badge bg-success">接受</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">停止</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <button class="btn btn-link text-primary p-0 text-decoration-none"
                                        data-bs-toggle="modal"
                                        data-bs-target="#branchModal"
                                        data-id="@item.BranchId"
                                        data-name="@item.BranchName"
                                        data-region="@item.Region"
                                        data-phone="@item.Phone"
                                        data-address="@item.Address"
                                        data-accepts="@item.AcceptsNewBookings.ToString().ToLower()"
                                        data-imageurl="@item.ImageUrl"
                                        data-description="@item.Description"
                                        onclick="openBranchModal('edit', this)">
                                    編輯
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">目前尚無任何分館資料</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal：分館編輯 / 新增 -->
<div class="modal fade" id="branchModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="branchModalTitle">分館資料維護</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="關閉"></button>
            </div>
            <div class="modal-body">
                <form id="branchForm" asp-controller="Branch" asp-action="Save" method="post">
                    @Html.AntiForgeryToken()
                    <!-- 隱藏欄位：儲存 PK (BranchId) -->
                    <input type="hidden" id="branchId" name="BranchId" value="0">

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">分館名稱 <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="branchName" name="BranchName" required placeholder="例如：台北中山商旅">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">區域 <span class="text-danger">*</span></label>
                            <select class="form-select" id="region" name="Region" required>
                                <option value="" disabled selected>請選擇區域</option>
                                <option value="北部">北部</option>
                                <option value="中部">中部</option>
                                <option value="南部">南部</option>
                                <option value="東部">東部</option>
                                <option value="離島">離島</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">聯絡電話 <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="phone" name="Phone" required placeholder="僅需輸入數字，如 0223456789">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">新訂房設定 <span class="text-danger">*</span></label>
                            <select class="form-select" id="acceptsNewBookings" name="AcceptsNewBookings">
                                <option value="true">接受新訂房</option>
                                <option value="false">停止新訂房</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">分館地址 <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="address" name="Address" required placeholder="完整通訊地址">
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">圖片網址 / 相對路徑</label>
                            <input type="text" class="form-control" id="imageUrl" name="ImageUrl" placeholder="例如：/images/branch1.jpg 或 https://example.com/image.jpg">
                            <div class="form-text">可填寫本地相對路徑（如：/images/branch1.jpg）或公開網路圖片網址。</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">分館簡介</label>
                            <textarea class="form-control" id="description" name="Description" rows="3" placeholder="請輸入分館相關簡介說明..."></textarea>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer justify-content-center border-0 pb-4">
                <button type="button" class="btn btn-outline-secondary px-4 me-2" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary px-4" id="btnSaveBranch" onclick="confirmAndSubmit()">儲存變更</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentMode = 'add';

        function openBranchModal(mode, btnElement = null) {
            currentMode = mode;
            const modalTitle = document.getElementById('branchModalTitle');
            const saveBtn = document.getElementById('btnSaveBranch');
            const form = document.getElementById('branchForm');

            if (mode === 'add') {
                modalTitle.textContent = '新增分館';
                saveBtn.textContent = '新增分館';
                form.reset();
                document.getElementById('branchId').value = '0';
                document.getElementById('region').value = '';
                document.getElementById('acceptsNewBookings').value = 'false';
            } else if (mode === 'edit' && btnElement) {
                modalTitle.textContent = '編輯分館資料';
                saveBtn.textContent = '儲存變更';

                document.getElementById('branchId').value = btnElement.getAttribute('data-id') || '0';
                document.getElementById('branchName').value = btnElement.getAttribute('data-name') || '';
                document.getElementById('region').value = btnElement.getAttribute('data-region') || '';
                document.getElementById('phone').value = btnElement.getAttribute('data-phone') || '';
                document.getElementById('address').value = btnElement.getAttribute('data-address') || '';
                document.getElementById('acceptsNewBookings').value = btnElement.getAttribute('data-accepts') || 'true';
                document.getElementById('imageUrl').value = btnElement.getAttribute('data-imageurl') || '';
                document.getElementById('description').value = btnElement.getAttribute('data-description') || '';
            }
        }

        function confirmAndSubmit() {
            const form = document.getElementById('branchForm');

            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const name = document.getElementById('branchName').value;
            const regionSelect = document.getElementById('region');
            const region = regionSelect.options[regionSelect.selectedIndex] ? regionSelect.options[regionSelect.selectedIndex].text : '';
            const phone = document.getElementById('phone').value;
            const address = document.getElementById('address').value;
            const accepts = document.getElementById('acceptsNewBookings').value === 'true' ? '接受新訂房' : '停止新訂房';
            const imgUrl = document.getElementById('imageUrl').value.trim();

            let message = '';

            if (currentMode === 'add') {
                message = `【確認新增分館】\n\n` +
                    `確定要新增以下資料嗎？\n` +
                    `• 分館名稱：${name}\n` +
                    `• 區域：${region}\n` +
                    `• 聯絡電話：${phone}\n` +
                    `• 分館地址：${address}\n` +
                    `• 訂房設定：${accepts}\n` +
                    `• 圖片路徑：${imgUrl || '未設定'}`;
            } else {
                message = `【確認修改分館】\n\n` +
                    `確定要儲存【${name}】的變更嗎？\n` +
                    `• 分館名稱：${name}\n` +
                    `• 區域：${region}\n` +
                    `• 聯絡電話：${phone}\n` +
                    `• 分館地址：${address}\n` +
                    `• 訂房設定：${accepts}\n` +
                    `• 圖片路徑：${imgUrl || '未設定'}`;
            }

            if (confirm(message)) {
                form.submit();
            }
        }
    </script>
}
