@{
    ViewData["Title"] = "房型與固定價格管理";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <p class="text-muted small mb-0">依分館查詢與維護房型資料，採用啟停狀態管理。</p>
    </div>
    <!-- 新增房型按鈕 -->
    <button class="btn btn-primary px-4" data-bs-toggle="modal" data-bs-target="#roomTypeModal" onclick="openRoomTypeModal('add')">
        <i class="bi bi-plus-lg me-1"></i>新增房型
    </button>
</div>

<!-- 切換分館篩選器 -->
<div class="row mb-3">
    <div class="col-md-3">
        <label class="form-label fw-bold small">選擇分館</label>
        <select class="form-select" id="branchFilter" onchange="filterByBranch()">
            <option value="1" selected>台北館</option>
            <option value="2">高雄館</option>
        </select>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">房型名稱</th>
                    <th>可住人數</th>
                    <th>床型</th>
                    <th>每晚固定價格</th>
                    <th>啟停狀態</th>
                    <th class="text-end pe-4">操作</th>
                </tr>
            </thead>
            <tbody id="roomTypeTableBody">
                <!-- 示範資料列 1 (台北館 BranchId=1) -->
                <tr data-branch-id="1">
                    <td class="ps-4 fw-bold">標準雙人房</td>
                    <td>2 人</td>
                    <td>一大床</td>
                    <td>NT$ 2,800</td>
                    <td><span class="badge bg-success">啟用</span></td>
                    <td class="text-end pe-4">
                        <button class="btn btn-link text-primary p-0 text-decoration-none"
                                data-bs-toggle="modal"
                                data-bs-target="#roomTypeModal"
                                data-id="1"
                                data-branch-id="1"
                                data-name="標準雙人房"
                                data-capacity="2"
                                data-bed="一大床"
                                data-price="2800"
                                data-status="true"
                                data-imageurl="https://example.com/room1.jpg"
                                data-description="舒適溫馨的雙人空間，適合情侶或商務出差。"
                                onclick="openRoomTypeModal('edit', this)">
                            編輯
                        </button>
                    </td>
                </tr>
                <!-- 示範資料列 2 (台北館 BranchId=1) -->
                <tr data-branch-id="1">
                    <td class="ps-4 fw-bold">三床豪華房</td>
                    <td>3 人</td>
                    <td>一大床 + 一小床</td>
                    <td>NT$ 3,800</td>
                    <td><span class="badge bg-secondary">停用</span></td>
                    <td class="text-end pe-4">
                        <button class="btn btn-link text-primary p-0 text-decoration-none"
                                data-bs-toggle="modal"
                                data-bs-target="#roomTypeModal"
                                data-id="2"
                                data-branch-id="1"
                                data-name="三床豪華房"
                                data-capacity="3"
                                data-bed="一大床 + 一小床"
                                data-price="3800"
                                data-status="false"
                                data-imageurl="https://example.com/room2.jpg"
                                data-description="空間寬敞，適合家庭與小團體入住。"
                                onclick="openRoomTypeModal('edit', this)">
                            編輯
                        </button>
                    </td>
                </tr>
                <!-- 示範資料列 3 (高雄館 BranchId=2) -->
                <tr data-branch-id="2" style="display: none;">
                    <td class="ps-4 fw-bold">海景雙人房</td>
                    <td>2 人</td>
                    <td>一大床</td>
                    <td>NT$ 3,200</td>
                    <td><span class="badge bg-success">啟用</span></td>
                    <td class="text-end pe-4">
                        <button class="btn btn-link text-primary p-0 text-decoration-none"
                                data-bs-toggle="modal"
                                data-bs-target="#roomTypeModal"
                                data-id="3"
                                data-branch-id="2"
                                data-name="海景雙人房"
                                data-capacity="2"
                                data-bed="一大床"
                                data-price="3200"
                                data-status="true"
                                data-imageurl="https://example.com/room3.jpg"
                                data-description="採光極佳，可直接遠眺高雄港夜景。"
                                onclick="openRoomTypeModal('edit', this)">
                            編輯
                        </button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal：房型編輯/新增 -->
<div class="modal fade" id="roomTypeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="roomTypeModalTitle">房型與固定價格維護</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="roomTypeForm" asp-controller="RoomType" asp-action="Save" method="post">
                    <!-- 隱藏欄位：PK (RoomTypeId) 與 FK (BranchId) -->
                    <input type="hidden" id="roomTypeId" name="RoomTypeId" value="0">
                    <input type="hidden" id="branchId" name="BranchId" value="1">

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">房型名稱 <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="roomTypeName" name="RoomTypeName" placeholder="例如：標準雙人房" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">可住人數 <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="maxOccupancy" name="MaxOccupancy" min="1" placeholder="例如：2" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">床型說明 <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="bedType" name="BedType" placeholder="例如：一大床 / 兩單人床" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">每晚固定價格 <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="nightlyPrice" name="NightlyPrice" step="0.01" min="1" placeholder="例如：2800" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">啟停狀態 <span class="text-danger">*</span></label>
                            <select class="form-select" id="isActive" name="IsActive">
                                <option value="true">啟用</option>
                                <option value="false">停用</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">圖片網址 <span class="text-danger">*</span></label>
                            <input type="url" class="form-control" id="imageUrl" name="ImageUrl" placeholder="https://example.com/image.jpg" required>
                            <div class="form-text">供顧客房型搜尋與選擇頁顯示預覽圖片。</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">房型描述</label>
                            <textarea class="form-control" id="description" name="Description" rows="3" maxlength="500" placeholder="請輸入房型特色說明 (最多 500 字)..."></textarea>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer justify-content-center border-0 pb-4">
                <button type="button" class="btn btn-outline-secondary px-4 me-2" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary px-4" id="btnSaveRoomType" onclick="confirmAndSubmit()">儲存變更</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentMode = 'add';

        document.addEventListener('DOMContentLoaded', function() {
            filterByBranch();
        });

        // 依畫面上方選擇的分館進行表格篩選
        function filterByBranch() {
            const selectedBranchId = document.getElementById('branchFilter').value;
            const rows = document.querySelectorAll('#roomTypeTableBody tr');

            rows.forEach(row => {
                if (row.getAttribute('data-branch-id') === selectedBranchId) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        function openRoomTypeModal(mode, btnElement = null) {
            currentMode = mode;
            const modalTitle = document.getElementById('roomTypeModalTitle');
            const saveBtn = document.getElementById('btnSaveRoomType');
            const form = document.getElementById('roomTypeForm');

            if (mode === 'add') {
                modalTitle.textContent = '新增房型';
                saveBtn.textContent = '新增房型';
                form.reset();

                // 自動同步上方選取的分館 ID 給 hidden 欄位
                const currentFilterBranch = document.getElementById('branchFilter').value;
                document.getElementById('branchId').value = currentFilterBranch;
                document.getElementById('roomTypeId').value = '0';
                document.getElementById('isActive').value = 'true';
            } else if (mode === 'edit' && btnElement) {
                modalTitle.textContent = '編輯房型與固定價格';
                saveBtn.textContent = '儲存變更';

                document.getElementById('roomTypeId').value = btnElement.getAttribute('data-id') || '0';
                document.getElementById('branchId').value = btnElement.getAttribute('data-branch-id') || '1';
                document.getElementById('roomTypeName').value = btnElement.getAttribute('data-name') || '';
                document.getElementById('maxOccupancy').value = btnElement.getAttribute('data-capacity') || '1';
                document.getElementById('bedType').value = btnElement.getAttribute('data-bed') || '';
                document.getElementById('nightlyPrice').value = btnElement.getAttribute('data-price') || '0';
                document.getElementById('isActive').value = btnElement.getAttribute('data-status') || 'true';
                document.getElementById('imageUrl').value = btnElement.getAttribute('data-imageurl') || '';
                document.getElementById('description').value = btnElement.getAttribute('data-description') || '';
            }
        }

        function confirmAndSubmit() {
            const form = document.getElementById('roomTypeForm');

            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const name = document.getElementById('roomTypeName').value;
            // 抓取上方「選擇分館」下拉選單顯示的名稱（例如：台北館）
            const branchFilter = document.getElementById('branchFilter');
            const branchText = branchFilter.options[branchFilter.selectedIndex].text;

            const capacity = document.getElementById('maxOccupancy').value;
            const bed = document.getElementById('bedType').value;
            const price = document.getElementById('nightlyPrice').value;
            const status = document.getElementById('isActive').value === 'true' ? '啟用' : '停用';
            const img = document.getElementById('imageUrl').value;

            let message = '';

            if (currentMode === 'add') {
                message = `【確認新增房型】\n\n` +
                    `確定要新增以下房型資料嗎？\n` +
                    `• 所屬分館：${branchText}\n` +
                    `• 房型名稱：${name}\n` +
                    `• 可住人數：${capacity} 人\n` +
                    `• 床型說明：${bed}\n` +
                    `• 每晚價格：NT$ ${price}\n` +
                    `• 狀態：${status}\n` +
                    `• 圖片網址：${img}`;
            } else {
                message = `【確認修改房型】\n\n` +
                    `確定要儲存【${name}】的變更嗎？\n` +
                    `• 所屬分館：${branchText}\n` +
                    `• 房型名稱：${name}\n` +
                    `• 可住人數：${capacity} 人\n` +
                    `• 床型說明：${bed}\n` +
                    `• 每晚價格：NT$ ${price}\n` +
                    `• 狀態：${status}\n` +
                    `• 圖片網址：${img}`;
            }

            if (confirm(message)) {
                form.submit();
            }
        }
    </script>
}
