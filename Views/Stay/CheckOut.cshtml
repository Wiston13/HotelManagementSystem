@model HotelManagementSystem.Models.ViewModels.Stay.CheckOutViewModel
@{
    ViewData["Title"] = "辦理退房";
}

@section Styles {
    <link rel="stylesheet" href="~/css/stay/CheckOut.css" asp-append-version="true" />
}

<div class="check-out-page">
    <p class="text-secondary mb-4">輸入房號或訂單編號，查詢目前住房資訊。</p>

    <section class="check-out-search card border-0 shadow-sm" aria-labelledby="check-out-search-title">
        <div class="card-body p-4">
            <h2 id="check-out-search-title" class="visually-hidden">查詢目前住房</h2>
            <form asp-controller="Stay" asp-action="CheckOut" method="get">
                <div class="row g-3 align-items-end">
                    <div class="col-md-8 col-lg-7">
                        <label asp-for="SearchValue" class="form-label text-secondary">房號／訂單編號</label>

                        <input asp-for="SearchValue"
                               class="form-control form-control-lg" />
                    </div>

                    <div class="col-md-4 col-lg-3">
                        <button type="submit"
                                class="btn btn-primary btn-lg fw-semibold w-100">
                            查詢
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </section>
</div>
<hr class="check-out-divider" />

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger mt-4">
        @Model.ErrorMessage
    </div>
}

@if (Model.HasResult)
{
    <section id="checkOutResult"
    class="check-out-panel card border-0 shadow-sm mt-4 mt-md-5"
    aria-labelledby="current-stay-title"
    >
        <div class="card-header bg-white border-bottom p-4 p-md-5">
            <h2 id="current-stay-title" class="h4 fw-bold mb-0">目前住房</h2>
        </div>
        <form>
            <div class="card-body p-4 p-md-5">
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="check-out-detail-row d-flex align-items-start justify-content-between gap-3 py-3 text-start">
                            <p class="detail-label text-secondary mb-0">顧客</p>
                            <p class="detail-value guest-name fw-semibold text-end mb-0">@Model.BookerName</p>
                        </div>
                        <div class="check-out-detail-row d-flex align-items-start justify-content-between gap-3 py-3 text-start">
                            <p class="detail-label text-secondary mb-0">Check-in</p>
                            <p class="detail-value check-in-time fw-semibold text-end mb-0">@Model.CheckInAt</p>
                        </div>
                        <div class="check-out-detail-row d-flex align-items-start justify-content-between gap-3 py-3 text-start">
                            <p class="detail-label text-secondary mb-0">房型快照</p>
                            <p class="detail-value room-type fw-semibold text-end mb-0">@Model.RoomTypeName</p>
                        </div>
                        <div class="check-out-detail-row d-flex align-items-start justify-content-between gap-3 py-3 text-start">
                            <p class="detail-label text-secondary mb-0">住房狀態</p>
                            <p class="detail-value stay-status fw-semibold text-end mb-0">@Model.BookingStatus</p>
                        </div>
                    </div>

                    <div class="col-md-6 d-flex flex-column">
                        <div class="check-out-detail-row d-flex align-items-start justify-content-between gap-3 py-3 text-start">
                            <p class="detail-label text-secondary mb-0">實際房號</p>
                            <p class="detail-value room-number fw-semibold text-end mb-0">@Model.RoomNumber</p>
                        </div>
                        <div class="check-out-detail-row d-flex align-items-start justify-content-between gap-3 py-3 text-start">
                            <p class="detail-label text-secondary mb-0">預定退房</p>
                            <p class="detail-value scheduled-check-out fw-semibold text-end mb-0">@Model.CheckOutDate</p>
                        </div>
                        <div class="check-out-detail-row d-flex align-items-start justify-content-between gap-3 py-3 text-start">
                            <p class="detail-label text-secondary mb-0">訂單編號</p>
                            <p class="detail-value booking-number fw-semibold text-end mb-0">@Model.BookingNumber</p>
                        </div>
                    </div>
                </div>
                <div class="check-out-action-wrapper col-md-6 ms-auto mt-4">
                    <button type="button" 
                            class="btn btn-primary btn-lg fw-semibold check-out-action mx-auto"
                            data-bs-toggle="modal"
                            data-bs-target="#checkOutConfirmationModal">
                        確認退房
                    </button>
                </div>
            </div>
		</form>
    </section>
}

<div class="modal fade" id="checkOutConfirmationModal" tabindex="-1" aria-labelledby="checkOutConfirmationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content check-out-confirm-modal border-0 shadow">
            <div class="modal-header">
                <h2 class="modal-title h5 fw-bold" id="checkOutConfirmationModalLabel">確認退房</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="關閉"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">請確認旅客退房前作業是否已完成。</p>
                <p class="mb-0 text-secondary">是否確認完成此筆入住的退房作業？</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary" id="confirmCheckOutButton" data-bs-dismiss="modal">確定</button>
            </div>
        </div>
    </div>
</div>
