@{
    ViewData["Title"] = "聯絡我們";
    Layout = "_CustomerLayout";
}

<div class="container py-5">
    <div class="card border-0 shadow-sm mx-auto bg-white rounded-4" style="max-width: 950px;">
        <div class="card-body p-5">
            <div class="row g-5">
                
      
                <div class="col-md-4 border-start border-4 ps-4" style="border-color: #1e4620 !important;">
                    <h1 class="h2 fw-light tracking-wide mb-3" style="color: #1e4620; font-family: 'Times New Roman', serif; letter-spacing: 2px;">GET IN TOUCH</h1>
                    <p class="text-secondary small lh-lg mb-4">
                        若您有任何意見、疑問或回饋，請透過此表格提供您的訊息，我們將儘速為您處理。
                    </p>
                    <hr class="text-muted opacity-25 my-4" />
                    <div class="small text-muted">
                        <i class="bi bi-envelope-fill me-2" style="color: #1e4620;"></i>
                        <a href="mailto:kindness.hotel@msa.hinet.net" class="text-secondary text-decoration-none">kindness.hotel@msa.hinet.net</a>
                    </div>
                </div>

                <!-- 右側表單內容 -->
                <div class="col-md-8">
                    <form id="feedbackForm" onsubmit="return false;">
                        
                     
                        <div class="mb-4">
                            <label class="form-label small fw-bold text-secondary mb-2">分館選擇 <span class="text-danger">*</span></label>
                            <select name="BranchId" class="form-select border-light-subtle py-2 shadow-sm" required>
                                <option value="" disabled selected>請選擇對應分館</option>
                                
                                @if (ViewBag.Branches != null)
                                {
                                    foreach (var branch in ViewBag.Branches)
                                    {
                                        <option value="@branch.BranchId">@branch.BranchName</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-secondary mb-2">訪客姓名 <span class="text-danger">*</span></label>
                                <input type="text" name="CustomerName" class="form-control border-light-subtle py-2 shadow-sm" placeholder="請輸入您的全名" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-secondary mb-2">聯絡電話</label>
                                <input type="tel" name="Phone" class="form-control border-light-subtle py-2 shadow-sm" placeholder="請輸入您的聯絡電話(選填)">
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label small fw-bold text-secondary mb-2">電子信箱 <span class="text-danger">*</span></label>
                            <input type="email" name="Email" class="form-control border-light-subtle py-2 shadow-sm" placeholder="例如：example@mail.com" required>
                        </div>

                        <div class="mb-4">
                            <label class="form-label small fw-bold text-secondary mb-2">您的寶貴意見 <span class="text-danger">*</span></label>
                            <textarea name="Content" class="form-control border-light-subtle py-2 shadow-sm" rows="5" placeholder="請輸入您的建議或反映內容..." maxlength="500" required></textarea>
                            <div class="form-text text-end text-muted small mt-1">限 500 字以內</div>
                        </div>

                        <div class="text-end pt-2">
                            <button type="button" id="btnSubmitFeedback" class="btn text-white px-5 py-2 fw-semibold shadow border-0" style="background-color: #1e4620; border-radius: 6px;">
                                送出訊息
                            </button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        document.getElementById('btnSubmitFeedback').addEventListener('click', function () {
            const form = document.getElementById('feedbackForm');
            
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const formData = new FormData(form);

            fetch('/Feedback/SubmitFeedback', {
                method: 'POST',
                body: formData
            })
            .then(response => {
                if (response.ok) return response.json();
                throw new Error('送出失敗');
            })
            .then(data => {
                alert(data.message || '意見已成功送出！');
                form.reset();
            })
            .catch(error => {
                alert('系統錯誤，請稍後再試。');
            });
        });
    </script>
}
