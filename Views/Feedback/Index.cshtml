@model IEnumerable<HotelManagementSystem.Models.Entities.Feedback>
@{
    Layout = "_ManagerLayout";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <p class="text-muted small mb-0">管理員可檢閱顧客提交的即時意見。💡 提示：在任一橫列上【滑鼠按兩下】即可動態修改處理狀態與填寫完成備註。</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive" style="max-height: 580px; overflow-y: auto;">
                <table class="table table-hover align-middle mb-0" id="feedbackTable">
                    <thead class="table-light text-secondary small sticky-top">
                        <tr>
                            <th class="ps-4 py-3" style="width: 15%;">填寫時間</th>
                            <th class="py-3" style="width: 15%;">所屬分館</th>
                            <th class="py-3" style="width: 15%;">顧客姓名</th>
                            <th class="py-3" style="width: 20%;">聯絡信箱 / 電話</th>
                            <th class="py-3" style="width: 23%;">顧客意見描述</th>
                            <th class="text-end pe-4 py-3" style="width: 12%;">處理狀態</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                var currentStatus = item.Status ?? "未處理";
                                var currentReply = item.AdminReply ?? "";

                               
                                <tr class="feedback-row" style="cursor: pointer;" 
                                    data-id="@item.Id"
                                    data-name="@item.CustomerName"
                                    data-branch="@(item.Branch?.BranchName ?? "未指定")"
                                    data-time="@item.CreatedAt.ToString("yyyy/MM/dd HH:mm")"
                                    data-email="@item.Email"
                                    data-phone="@(string.IsNullOrWhiteSpace(item.Phone) ? "未提供" : item.Phone)"
                                    data-status="@currentStatus">
                                    
                                    <td class="ps-4 text-secondary">@item.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                    <td>
                                        <span class="badge bg-light text-dark border px-2 py-1">
                                            @item.Branch?.BranchName
                                        </span>
                                    </td>
                                    <td class="fw-bold text-dark">@item.CustomerName</td>
                                    <td>
                                        <div class="text-dark">@item.Email</div>
                                        <div class="text-secondary small">@(string.IsNullOrWhiteSpace(item.Phone) ? "未提供電話" : item.Phone)</div>
                                    </td>
                                    <td>
                                       
                                        <div class="text-muted text-truncate" style="max-width: 250px;">
                                            @item.Content
                                        </div>
                                        <input type="hidden" class="row-content" value="@item.Content" />
                                        <input type="hidden" class="row-reply" value="@currentReply" />
                                    </td>
                                    <td class="text-end pe-4">
                                        @if (currentStatus == "已處理")
                                        {
                                            <span class="badge bg-success px-3 py-1 rounded-2">已處理</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger px-3 py-1 rounded-2">未處理</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <div class="text-secondary mb-3" style="font-size: 2.5rem;">🔍</div>
                                    <h5 class="fw-bold mb-2">目前尚無任何顧客意見資料</h5>
                                    <p class="text-muted small mb-0">當官網顧客從前台提交聯絡表單後，資訊將會即時呈現在此處。</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- 彈出視窗（Modal） -->
<div class="modal fade" id="feedbackDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold text-dark">顧客意見詳細資訊</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="modalFeedbackId" value="0" />

                <div class="row g-3">
                    <div class="col-sm-6">
                        <span class="text-secondary small">顧客姓名</span>
                        <p id="modalName" class="fw-bold mb-0 text-dark">-</p>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-secondary small">所屬分館</span>
                        <p id="modalBranch" class="fw-bold mb-0 text-dark">-</p>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-secondary small">填寫時間</span>
                        <p id="modalTime" class="text-muted mb-0">-</p>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-secondary small">聯絡電話</span>
                        <p id="modalPhone" class="text-dark mb-0">-</p>
                    </div>
                    <div class="col-12">
                        <span class="text-secondary small">電子信箱</span>
                        <p id="modalEmail" class="text-dark mb-0">-</p>
                    </div>
                    <div class="col-12 border-top pt-2">
                        <span class="text-secondary small fw-bold text-primary">完整意見內容描述</span>
                        <div id="modalContent" class="p-3 bg-light rounded mt-2 text-dark text-break" style="max-height: 120px; overflow-y: auto; white-space: pre-line;">-</div>
                    </div>

                    <div class="col-12 border-top pt-3 mt-2">
                        <label class="form-label small fw-bold text-dark">變更處理狀態</label>
                        <select id="modalStatusSelect" class="form-select border-light-subtle py-2 shadow-sm rounded-2 fw-bold" style="font-size: 13px;">
                            <option value="未處理">未處理</option>
                            <option value="已處理">已處理</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label small fw-bold text-dark">處理完成備註內容</label>
                        <textarea id="modalReplyText" class="form-control border-light-subtle py-2 shadow-sm rounded-2" rows="3" placeholder="請輸入此筆意見的處理進度、原因或客訴追蹤紀錄..." maxlength="500"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 justify-content-center pb-4">
                <button type="button" class="btn btn-outline-secondary px-4 me-2" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary px-4 shadow-sm" id="btnSaveChanges" onclick="saveFeedbackChanges()">儲存變更</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        $(document).ready(function() {
            $('.feedback-row').on('dblclick', function() {
                const $row = $(this);

                document.getElementById('modalFeedbackId').value = $row.data('id');
                document.getElementById('modalName').textContent = $row.data('name');
                document.getElementById('modalBranch').textContent = $row.data('branch');
                document.getElementById('modalTime').textContent = $row.data('time');
                document.getElementById('modalEmail').textContent = $row.data('email');
                document.getElementById('modalPhone').textContent = $row.data('phone');

                document.getElementById('modalContent').textContent = $row.find('.row-content').val();

                document.getElementById('modalStatusSelect').value = $row.data('status');
                document.getElementById('modalReplyText').value = $row.find('.row-reply').val();

                var myModal = new bootstrap.Modal(document.getElementById('feedbackDetailModal'));
                myModal.show();
            });
        });

        function saveFeedbackChanges() {
            const id = document.getElementById('modalFeedbackId').value;
            const status = document.getElementById('modalStatusSelect').value;
            const adminReply = document.getElementById('modalReplyText').value;

            const formData = new FormData();
            formData.append('id', id);
            formData.append('status', status);
            formData.append('adminReply', adminReply);

            fetch('/Feedback/UpdateFeedbackDetails', {
                method: 'POST',
                body: formData
            })
                .then(response => {
                    if (response.ok) {
                        window.location.reload();
                    } else {
                        alert('儲存失敗，請檢查系統連線。');
                    }
                })
                .catch(err => {
                    console.error("更新意見失敗：", err);
                    alert('系統錯誤，請稍後再試。');
                });
        }
    </script>
}